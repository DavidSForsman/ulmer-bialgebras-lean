module

public import AffineGroupSchemes.CoexactNormal
public import AffineGroupSchemes.CoexactPushout
public import AffineGroupSchemes.CoexactQuotient
public import AffineGroupSchemes.HopfPushout
public import AffineGroupSchemes.HopfBijectiveIso
public import AffineGroupSchemes.MainTheorem
public import Hopf.Commutative.AugSpan

/-!
# Effectivity of internal equivalence relations of affine group schemes

This file assembles the algebraic work of the `Coexact` files into the categorical statement
`AffineGroupSchemes.CoeffectiveEquivalenceRelations`: every internal equivalence relation in the
category of affine group `k`-schemes — that is, in the opposite of the category of commutative Hopf
`k`-algebras — is the kernel pair of a morphism.

The input is Takeuchi's Theorem 4.3 in its surjectivity form
(`HopfAlgebra.Commutative.NormalHopfIdealEqAugSpan`), which is carried as an explicit hypothesis
here; it is proved for every field in `Hopf/Commutative/AugSpanUnconditional.lean`.

## Main results

* `AffineGroupSchemes.Coexact.isNormalHopfIdeal_kerDiff`: if `e` is a common retraction of `d₁, d₂`
  and `jointAlg d₁ d₂` is surjective, the kernel of the difference morphism is a normal Hopf ideal.
* `AffineGroupSchemes.Coexact.exists_isPushout`: under the same hypotheses and granting
  `HopfAlgebra.Commutative.NormalHopfIdealEqAugSpan k H`, `d₁, d₂` is the pushout of some morphism
  `u : K ⟶ H` of commutative Hopf algebras along itself.
* `AffineGroupSchemes.coeffective_absFlat_of_normalHopfIdealEqAugSpan`: over an absolutely flat base
  ring `k`, granting Takeuchi surjectivity over `k`, every internal equivalence relation in
  `(CommHopfAlgCat k)ᵒᵖ` is the kernel pair of a morphism.
* `AffineGroupSchemes.coeffectiveEquivalenceRelations_of_normalHopfIdealEqAugSpan`: granting
  Takeuchi surjectivity over every field, `AffineGroupSchemes.CoeffectiveEquivalenceRelations`
  holds.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Definition 4.1 and Theorem 4.3
* [D. Forsman, *On the semi-abelianness of affine group
  schemes*][forsman2026semiabeliannessaffinegroupschemes]
* [M. Barr, *Exact categories*][Ba]
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra CategoryTheory Limits

universe u

namespace AffineGroupSchemes

open CategoryTheory
open HopfAlgebra HopfAlgebra.Commutative
namespace Coexact

variable {k H R : Type u} [CommRing k] [CommRing H] [CommRing R]
  [HopfAlgebra k H] [HopfAlgebra k R]

/-! ### The kernel of the difference morphism -/

variable (d₁ d₂ : H →ₐc[k] R)

/-- The kernel of the difference morphism `p : H →ₐ[k] R`, `x ↦ ∑ d₁(S x₍₁₎) d₂(x₍₂₎)`. -/
noncomputable def kerDiff : Ideal H := RingHom.ker (diffAlg d₁ d₂ : H →+* R)

/-- `x ∈ kerDiff d₁ d₂` iff `diffLin d₁ d₂ x = 0` (true by definition). -/
lemma mem_kerDiff {x : H} : x ∈ kerDiff d₁ d₂ ↔ diffLin d₁ d₂ x = 0 := Iff.rfl

variable (e : R →ₐc[k] H)

/-- **The kernel of the difference morphism is a normal Hopf ideal.** -/
theorem isNormalHopfIdeal_kerDiff (hd₁ : ∀ x, e (d₁ x) = x) (hd₂ : ∀ x, e (d₂ x) = x)
    (hjoint : Function.Surjective (jointAlg d₁ d₂)) :
    HopfAlgebra.IsNormalHopfIdeal k (kerDiff d₁ d₂) := by
  classical
  -- `R` is an `(H, H)`-Hopf module through `d₁` and the retraction `e`.
  let := algebraAnti d₁
  let := isScalarTower_algebraAnti d₁
  let := rightComodule e
  have := isHopfModule_of_retraction d₁ e hd₁
  -- The quotient `q : R → B` by the ideal generated by `d₁(H⁺)`; it sends `d₁ a` to `ε(a)`.
  have : Fact (HopfAlgebra.IsHopfIdeal k (jIdeal d₁)) := ⟨isHopfIdeal_jIdeal d₁⟩
  set B := R ⧸ jIdeal d₁ with hB
  set q : R →ₐc[k] B := HopfAlgebra.quotBialgHom k (jIdeal d₁) with hq_def
  have hsmul : ∀ (h : H) (r : R), h • r = d₁ (antipode k h) * r := algebraAnti_smul d₁
  have hcoact : ∀ r : R, Coalgebra.Comodule.coact (R := k) (C := H) r = coactAlg e r := fun _ => rfl
  have hqzero : ∀ r : R, q r = 0 ↔ r ∈ jIdeal d₁ := fun r => Ideal.Quotient.eq_zero_iff_mem
  have hq : ∀ a : H, q (d₁ a) = (algebraMap k B) (counit (R := k) a) := by
    intro a
    have hmem : a - algebraMap k H (counit (R := k) a)
        ∈ HopfAlgebra.Commutative.augmentationIdeal k H := by
      rw [HopfAlgebra.Commutative.mem_augmentationIdeal]
      simp
    have h0 : q (d₁ (a - algebraMap k H (counit (R := k) a))) = 0 :=
      (hqzero _).2 (Ideal.subset_span ⟨_, hmem, rfl⟩)
    rw [map_sub, map_sub, sub_eq_zero] at h0
    rw [h0]
    have h1 : d₁ ((algebraMap k H) (counit (R := k) a)) = (algebraMap k R) (counit (R := k) a) :=
      (d₁ : H →ₐ[k] R).commutes _
    rw [h1]
    exact (q : R →ₐ[k] B).commutes _
  -- `π = q ∘ d₂` is surjective, and its kernel is a normal Hopf ideal.
  have hqsurj : Function.Surjective q := HopfAlgebra.quotBialgHom_surjective k (jIdeal d₁)
  set π : H →ₐc[k] B := q.comp (d₂ : H →ₐc[k] R) with hπ_def
  have hπ : ∀ x, π x = q (d₂ x) := fun _ => rfl
  have hsurjπ : Function.Surjective π :=
    surjective_comp_d₂ (d₁ := d₁) (d₂ := d₂) (e := e) q hsmul hcoact hd₂ hq hqsurj hjoint
  have hnormal := isNormalHopfIdeal_ker (e := e) (q := q) d₁ d₂ π hd₁ hd₂ hq
    (fun r hr => (hqzero r).1 hr) hπ hsurjπ
  -- The kernel of `π` is the kernel of the difference morphism.
  have hkerEq : RingHom.ker (π : H →ₐ[k] B) = kerDiff d₁ d₂ := by
    ext x
    constructor
    · intro hx
      exact diff_eq_zero_of_q_d₂_eq_zero (d₁ := d₁) (d₂ := d₂) (e := e) q hsmul hcoact hd₂ hq
        (fun r hr => (hqzero r).1 hr) (x := x) hx
    · intro hx
      rw [RingHom.mem_ker, BialgHom.coe_toAlgHom, hπ, q_d₂_eq_q_diff d₁ d₂ q hq x,
        (mem_kerDiff d₁ d₂).1 hx, map_zero]
  rwa [hkerEq] at hnormal

/-- **The relation is the cokernel pair of the inclusion of a sub-Hopf algebra**, granting
Takeuchi's Theorem 4.3. -/
theorem exists_isPushout [IsAbsFlat k] (hd₁ : ∀ x, e (d₁ x) = x) (hd₂ : ∀ x, e (d₂ x) = x)
    (hjoint : Function.Surjective (jointAlg d₁ d₂))
    (hSurj : HopfAlgebra.Commutative.NormalHopfIdealEqAugSpan k H) :
    ∃ (K : CommHopfAlgCat.{u} k) (u : K ⟶ CommHopfAlgCat.of k H),
      IsPushout u u (CommHopfAlgCat.ofHom d₁) (CommHopfAlgCat.ofHom d₂) := by
  classical
  -- `R` is an `(H, H)`-Hopf module, and the kernel of the difference morphism is normal.
  let := algebraAnti d₁
  let := isScalarTower_algebraAnti d₁
  let := rightComodule e
  have := isHopfModule_of_retraction d₁ e hd₁
  have hsmul : ∀ (h : H) (r : R), h • r = d₁ (antipode k h) * r := algebraAnti_smul d₁
  have hcoact : ∀ r : R, Coalgebra.Comodule.coact (R := k) (C := H) r = coactAlg e r := fun _ => rfl
  have hnormal : HopfAlgebra.IsNormalHopfIdeal k (kerDiff d₁ d₂) :=
    isNormalHopfIdeal_kerDiff d₁ d₂ e hd₁ hd₂ hjoint
  have hker : ∀ x : H, x ∈ kerDiff d₁ d₂ ↔ diffLin d₁ d₂ x = 0 := fun _ => Iff.rfl
  -- `K`, the coinvariants of that kernel, is a sub-Hopf algebra; Takeuchi's correspondence
  -- (`hSurj`) gives back the kernel as `H K⁺`, and `d₁`, `d₂` agree on `K`.
  set K : Subalgebra k H := HopfAlgebra.coinvOfIdeal (k := k) (kerDiff d₁ d₂) with hKdef
  have : HopfAlgebra.IsSubHopfAlgebra k K := HopfAlgebra.isSubHopfAlgebra_coinv _ hnormal
  have hIK : kerDiff d₁ d₂ = HopfAlgebra.Commutative.augIdeal K := hSurj _ hnormal
  have hK : ∀ x : H, x ∈ HopfAlgebra.augIdealB k (↥K) H ↔ diffLin d₁ d₂ x = 0 := by
    intro x
    rw [HopfAlgebra.Commutative.augIdealB_eq_augIdeal, ← hIK]
    exact hker x
  have hcomm : ∀ a : ↥K, d₁ (HopfAlgebra.subInclusion (K := K) a)
      = d₂ (HopfAlgebra.subInclusion (K := K) a) := fun a =>
    d₁_eq_d₂_of_mem_coinvLeft d₁ d₂ (kerDiff d₁ d₂) hker a.2
  -- The canonical map `H ⊗[K] H → R`, `x ⊗ y ↦ d₁(x) d₂(y)`, is bijective, so `R` is the
  -- pushout of `K → H` along itself.
  let := hopfAlgebraTensor (HopfAlgebra.subInclusion (K := K)) (HopfAlgebra.subInclusion (K := K))
    (fun _ : ↥K => rfl) (fun _ : ↥K => rfl)
  have hbij := bijective_liftBialgHom hsmul hcoact hd₂ hjoint K hK hcomm
  set φ := liftBialgHom (HopfAlgebra.subInclusion (K := K)) (HopfAlgebra.subInclusion (K := K))
    (fun _ : ↥K => rfl) (fun _ : ↥K => rfl) d₁ d₂ hcomm with hφ
  refine ⟨CommHopfAlgCat.of k ↥K, CommHopfAlgCat.ofHom (HopfAlgebra.subInclusion (K := K)), ?_⟩
  refine (isPushout_hopfTensor (HopfAlgebra.subInclusion (K := K)) (HopfAlgebra.subInclusion (K
      := K))
    (fun _ : ↥K => rfl) (fun _ : ↥K => rfl)).of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _)
    (CommHopfAlgCat.isoOfBijective φ hbij) (by simp) (by simp) ?_ ?_
  · rw [Iso.refl_hom, Category.id_comp]
    refine CommHopfAlgCat.hom_ext (DFunLike.ext _ _ fun x => ?_)
    change d₁ x * d₂ 1 = d₁ x
    simp
  · rw [Iso.refl_hom, Category.id_comp]
    refine CommHopfAlgCat.hom_ext (DFunLike.ext _ _ fun y => ?_)
    change d₁ 1 * d₂ y = d₂ y
    simp

end Coexact

/-- **Effectivity of internal equivalence relations of affine group schemes over an absolutely
flat base ring** (a field or, as in Section 4 of the paper, a commutative von Neumann regular
ring), granting the surjectivity half of Takeuchi's Theorem 4.3 over that base. -/
theorem coeffective_absFlat_of_normalHopfIdealEqAugSpan (k : Type u) [CommRing k] [IsAbsFlat k]
    (hSurj : ∀ (H : Type u) [CommRing H] [HopfAlgebra k H],
        HopfAlgebra.Commutative.NormalHopfIdealEqAugSpan k H)
    {Rop Xop : (CommHopfAlgCat.{u} k)ᵒᵖ} {r₁ r₂ : Rop ⟶ Xop}
    (hrel : IsInternalEquivalenceRelation r₁ r₂) :
    ∃ (Y : (CommHopfAlgCat.{u} k)ᵒᵖ) (f : Xop ⟶ Y), IsKernelPair f r₁ r₂ := by
  obtain ⟨dref, hdr₁, hdr₂⟩ := hrel.refl
  set H : Type u := (Xop.unop : CommHopfAlgCat.{u} k).X with hHdef
  set S : Type u := (Rop.unop : CommHopfAlgCat.{u} k).X with hSdef
  set d₁ : H →ₐc[k] S := r₁.unop.hom with hd₁def
  set d₂ : H →ₐc[k] S := r₂.unop.hom with hd₂def
  set e : S →ₐc[k] H := dref.unop.hom with hedef
  have hd₁ : ∀ x : H, e (d₁ x) = x := by
    intro x
    simpa using congr(($hdr₁).unop.hom x)
  have hd₂ : ∀ x : H, e (d₂ x) = x := by
    intro x
    simpa using congr(($hdr₂).unop.hom x)
  have hjoint : Function.Surjective (Coexact.jointAlg d₁ d₂) := by
    refine Coexact.jointAlg_surjective d₁ d₂ ?_
    intro T _ _ α β hα hβ r
    have h := hrel.jointly_mono (T := Opposite.op (CommHopfAlgCat.of k T))
      (CommHopfAlgCat.ofHom α).op (CommHopfAlgCat.ofHom β).op ?_ ?_
    · simpa using congr(($h).unop.hom r)
    · refine Quiver.Hom.unop_inj (CommHopfAlgCat.hom_ext (DFunLike.ext _ _ fun x => ?_))
      exact hα x
    · refine Quiver.Hom.unop_inj (CommHopfAlgCat.hom_ext (DFunLike.ext _ _ fun x => ?_))
      exact hβ x
  obtain ⟨K, u, hp⟩ := Coexact.exists_isPushout d₁ d₂ e hd₁ hd₂ hjoint (hSurj H)
  refine ⟨Opposite.op K, u.op, ?_⟩
  have h₁ : CommHopfAlgCat.ofHom d₁ = r₁.unop := rfl
  have h₂ : CommHopfAlgCat.ofHom d₂ = r₂.unop := rfl
  rw [h₁, h₂] at hp
  simpa using hp.op.flip

/-- **Effectivity of internal equivalence relations of affine group schemes**, granting the
surjectivity half of Takeuchi's Theorem 4.3 [Takeuchi1972]. -/
theorem coeffectiveEquivalenceRelations_of_normalHopfIdealEqAugSpan
    (hSurj : ∀ (k H : Type u) [Field k] [CommRing H] [HopfAlgebra k H],
      HopfAlgebra.Commutative.NormalHopfIdealEqAugSpan k H) :
    CoeffectiveEquivalenceRelations.{u} := fun k _ _ _ _ _ hrel =>
  coeffective_absFlat_of_normalHopfIdealEqAugSpan k (fun H _ _ => hSurj k H) hrel

end AffineGroupSchemes
