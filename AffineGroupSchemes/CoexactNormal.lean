module

public import AffineGroupSchemes.CoexactSetup
public import Hopf.Basic.HopfAdjointCoaction
public import Hopf.Basic.NormalHopfIdeal

/-!
# The kernel of the quotient morphism is a normal Hopf ideal

We keep the situation of `AffineGroupSchemes/CoexactSetup.lean`: `d₁, d₂ : H →ₐc[k] R` are the
two projections of an internal relation of affine group schemes, `e : R →ₐc[k] H` is a reflexivity
(a common retraction).  Let `B` be a further commutative Hopf algebra and `q : R →ₐc[k] B` a
morphism which "kills `d₁(H⁺)`", i.e. which satisfies

* `q (d₁ a) = ε(a) · 1`, and
* `q r = 0 → r ∈ d₁(H⁺)R`.

(In the application `B = R / d₁(H⁺)R` and `q` is the quotient map.)  Then `π := q ∘ d₂ : H → B`
is a morphism of Hopf algebras, and its kernel `I` is a **normal** Hopf ideal of `H` in the
sense of Takeuchi's Definition 4.1: geometrically, `I` cuts out the normal subgroup scheme by
which one quotients.

The normality is proved by means of the algebra map

```
Ad : R →ₐ[k] H ⊗[k] R,   r ↦ ∑ e(r₍₁₎) S(e(r₍₃₎)) ⊗ r₍₂₎ ,
```

which represents the conjugation action of the group on the relation: composing with `q` gives
an algebra map killing `d₁(H⁺)` and sending `d₂ x` to `∑ x₍₁₎S(x₍₃₎) ⊗ π(x₍₂₎)`.

## Main results

* `AffineGroupSchemes.Coexact.isNormalHopfIdeal_ker`: if `e` is a common retraction of `d₁, d₂`, `q`
  sends `d₁ a` to `ε(a) · 1` and its kernel lies in the ideal generated by `d₁(H⁺)`, and
  `π = q ∘ d₂` is surjective, then the kernel of `π` is a normal Hopf ideal of `H`.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Definition 4.1
* [D. Forsman, *On the semi-abelianness of affine group
  schemes*][forsman2026semiabeliannessaffinegroupschemes]
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra WithConv

namespace AffineGroupSchemes

open HopfAlgebra HopfAlgebra.Commutative
namespace Coexact

universe u

variable {k H R B : Type u} [CommRing k] [CommRing H] [CommRing R] [CommRing B]
  [HopfAlgebra k H] [HopfAlgebra k R] [HopfAlgebra k B]

/-! ### Naturality of the adjoint coaction -/

/-- The adjoint coaction is natural in the Hopf algebra. -/
lemma adAlgHom_bialgHom (d : H →ₐc[k] R) (x : H) :
    HopfAlgebra.adAlgHom k R (d x)
      = Algebra.TensorProduct.map (d : H →ₐ[k] R) (d : H →ₐ[k] R) (HopfAlgebra.adAlgHom k H x) := by
  classical
  set r := ℛ k x with hr
  set r2 : (i : H × H) → Coalgebra.Repr k (r.right i) (H × H) := fun i => ℛ k (r.right i) with hr2
  rw [HopfAlgebra.adAlgHom_apply x r r2, map_sum]
  rw [HopfAlgebra.adAlgHom_apply (d x) (r.induced d) (fun i => (r2 i).induced d)]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp [antipode_bialgHom_apply]

/-- The algebra map `H ⊗[k] H →ₐ[k] H`, `u ⊗ v ↦ ε(v) · u`. -/
noncomputable def counitRight : H ⊗[k] H →ₐ[k] H :=
  Algebra.TensorProduct.lift (AlgHom.id k H)
    ((Algebra.ofId k H).comp (Bialgebra.counitAlgHom k H)) fun _ _ => Commute.all _ _

/-- `counitRight (u ⊗ v) = u · ε(v)`. -/
@[simp] lemma counitRight_tmul (u v : H) :
    counitRight (u ⊗ₜ[k] v) = u * (algebraMap k H) (counit (R := k) v) := rfl

/-- Contracting the second leg of the adjoint coaction by the counit gives the counit:
`∑ x₍₁₎ε(x₍₂₎)S(x₍₃₎) = ε(x) · 1`. -/
lemma counitRight_ad (x : H) :
    counitRight (HopfAlgebra.adAlgHom k H x) = (algebraMap k H) (counit (R := k) x) := by
  classical
  set r := ℛ k x with hr
  set r2 : (i : H × H) → Coalgebra.Repr k (r.right i) (H × H) := fun i => ℛ k (r.right i) with hr2
  rw [HopfAlgebra.adAlgHom_apply x r r2, map_sum]
  have step : ∀ i ∈ r.index, counitRight (∑ j ∈ (r2 i).index,
      (r.left i * antipode k ((r2 i).right j)) ⊗ₜ[k] ((r2 i).left j))
      = r.left i * antipode k (r.right i) := by
    intro i _
    rw [map_sum]
    have hterm : ∀ j ∈ (r2 i).index,
        counitRight ((r.left i * antipode k ((r2 i).right j)) ⊗ₜ[k] ((r2 i).left j))
          = r.left i * antipode k (counit (R := k) ((r2 i).left j) • (r2 i).right j) := by
      intro j _
      rw [counitRight_tmul, map_smul, Algebra.algebraMap_eq_smul_one, mul_smul_comm,
        mul_smul_comm, mul_one]
    rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, ← map_sum,
      Coalgebra.sum_counit_smul (r2 i)]
  rw [Finset.sum_congr rfl step, HopfAlgebra.sum_mul_antipode_eq_smul r,
    Algebra.algebraMap_eq_smul_one]

/-! ### The conjugation map of the relation -/

variable (e : R →ₐc[k] H)

/-- The algebra map `Ad : R →ₐ[k] H ⊗[k] R`, `r ↦ ∑ e(r₍₁₎)S(e(r₍₃₎)) ⊗ r₍₂₎`, representing the
conjugation action of the group on the relation. -/
noncomputable def adMixed : R →ₐ[k] H ⊗[k] R :=
  (Algebra.TensorProduct.map (e : R →ₐ[k] H) (AlgHom.id k R)).comp (HopfAlgebra.adAlgHom k R)

/-- For `d : H →ₐc[k] R` with `e ∘ d = id`, `adMixed e (d x) = (id ⊗ d) (adAlgHom x)`. -/
lemma adMixed_bialgHom (d : H →ₐc[k] R) (hd : ∀ x, e (d x) = x) (x : H) :
    adMixed e (d x)
      = Algebra.TensorProduct.map (AlgHom.id k H) (d : H →ₐ[k] R) (HopfAlgebra.adAlgHom k H x) := by
  have hed : (e : R →ₐ[k] H).comp (d : H →ₐ[k] R) = AlgHom.id k H := AlgHom.ext hd
  rw [adMixed, AlgHom.comp_apply, adAlgHom_bialgHom d x, ← AlgHom.comp_apply,
    ← Algebra.TensorProduct.map_comp, hed, AlgHom.id_comp]

variable (q : R →ₐc[k] B)

/-- The algebra map `Ξ = (id ⊗ q) ∘ Ad : R →ₐ[k] H ⊗[k] B`. -/
noncomputable def xiMap : R →ₐ[k] H ⊗[k] B :=
  (Algebra.TensorProduct.map (AlgHom.id k H) (q : R →ₐ[k] B)).comp (adMixed e)

variable {e q}

/-- For `d : H →ₐc[k] R` with `e ∘ d = id`, `xiMap e q (d x) = (id ⊗ (q ∘ d)) (adAlgHom x)`. -/
lemma xiMap_bialgHom (d : H →ₐc[k] R) (hd : ∀ x, e (d x) = x) (x : H) :
    xiMap e q (d x)
      = Algebra.TensorProduct.map (AlgHom.id k H)
          ((q : R →ₐ[k] B).comp (d : H →ₐ[k] R)) (HopfAlgebra.adAlgHom k H x) := by
  rw [xiMap, AlgHom.comp_apply, adMixed_bialgHom e d hd x, ← AlgHom.comp_apply,
    ← Algebra.TensorProduct.map_comp, AlgHom.id_comp]

variable (d₁ d₂ : H →ₐc[k] R)

/-- `Ξ` kills the elements `d₁ a` with `a` in the augmentation ideal of `H`. -/
lemma xiMap_d₁ (hd₁ : ∀ x, e (d₁ x) = x)
    (hq : ∀ a : H, q (d₁ a) = (algebraMap k B) (counit (R := k) a)) {a : H}
    (ha : counit (R := k) a = 0) : xiMap e q (d₁ a) = 0 := by
  rw [xiMap_bialgHom d₁ hd₁ a]
  have hcomp : ∀ t : H ⊗[k] H,
      Algebra.TensorProduct.map (AlgHom.id k H) ((q : R →ₐ[k] B).comp (d₁ : H →ₐ[k] R)) t
        = (Algebra.TensorProduct.includeLeft : H →ₐ[k] H ⊗[k] B) (counitRight t) := by
    intro t
    induction t using TensorProduct.inductionOn with
    | tmul u v =>
      simp only [Algebra.TensorProduct.map_tmul, counitRight_tmul, AlgHom.id_apply,
        AlgHom.comp_apply, Algebra.TensorProduct.includeLeft_apply]
      rw [BialgHom.coe_toAlgHom, BialgHom.coe_toAlgHom, hq v, Algebra.algebraMap_eq_smul_one,
        Algebra.algebraMap_eq_smul_one,
        TensorProduct.tmul_smul, mul_smul_comm, mul_one]
      rw [TensorProduct.smul_tmul', TensorProduct.smul_tmul]
    | add p q' hp hq' => rw [map_add, map_add, hp, hq', map_add]
  rw [hcomp, counitRight_ad, ha]
  simp

/-- On the image of `d₂` the map `Ξ` computes the adjoint coaction of the quotient. -/
lemma xiMap_d₂ (hd₂ : ∀ x, e (d₂ x) = x) (π : H →ₐc[k] B) (hπ : ∀ x, π x = q (d₂ x)) (x : H) :
    xiMap e q (d₂ x)
      = Algebra.TensorProduct.map (AlgHom.id k H) (π : H →ₐ[k] B) (HopfAlgebra.adAlgHom k H x) := by
  have hqd₂ : (q : R →ₐ[k] B).comp (d₂ : H →ₐ[k] R) = π := AlgHom.ext fun x => (hπ x).symm
  rw [xiMap_bialgHom d₂ hd₂ x, hqd₂]

/-- `Ξ` vanishes on the ideal generated by `d₁(H⁺)`. -/
lemma xiMap_eq_zero_of_mem_span (hd₁ : ∀ x, e (d₁ x) = x)
    (hq : ∀ a : H, q (d₁ a) = (algebraMap k B) (counit (R := k) a)) {r : R}
    (hr : r ∈ Ideal.span ((d₁ : H → R) '' (HopfAlgebra.Commutative.augmentationIdeal k H))) :
    xiMap e q r = 0 := by
  have hle : Ideal.span ((d₁ : H → R) '' (HopfAlgebra.Commutative.augmentationIdeal k H))
      ≤ RingHom.ker (xiMap e q : R →+* H ⊗[k] B) := by
    refine Ideal.span_le.2 ?_
    rintro _ ⟨a, ha, rfl⟩
    exact xiMap_d₁ d₁ hd₁ hq ((HopfAlgebra.Commutative.mem_augmentationIdeal k H).1 ha)
  exact hle hr

/-! ### The kernel of `π` is a normal Hopf ideal -/

section Ker

/-- The tensor product of two algebra isomorphisms is injective. -/
lemma tensorMap_injective {A₁ A₂ C₁ C₂ : Type u} [CommRing A₁] [CommRing A₂] [CommRing C₁]
    [CommRing C₂] [Algebra k A₁] [Algebra k A₂] [Algebra k C₁] [Algebra k C₂]
    (f : A₁ ≃ₐ[k] A₂) (g : C₁ ≃ₐ[k] C₂) :
    Function.Injective
      (Algebra.TensorProduct.map (f : A₁ →ₐ[k] A₂) (g : C₁ →ₐ[k] C₂)) :=
  (Algebra.TensorProduct.congr f g).injective

/-- A morphism of Hopf algebras is compatible with the comultiplications. -/
lemma tensorMap_comul (p : H →ₐc[k] B) (x : H) :
    Algebra.TensorProduct.map (p : H →ₐ[k] B) (p : H →ₐ[k] B) (comul (R := k) x)
      = comul (R := k) (p x) := by
  have hlin : (Algebra.TensorProduct.map (p : H →ₐ[k] B) (p : H →ₐ[k] B)).toLinearMap
      = TensorProduct.map ((p : H →ₗc[k] B) : H →ₗ[k] B) ((p : H →ₗc[k] B) : H →ₗ[k] B) := by
    ext a b
    rfl
  rw [← AlgHom.toLinearMap_apply, hlin]
  simp

variable (π : H →ₐc[k] B)

/-- **The kernel of the quotient morphism is a normal Hopf ideal.**  In the situation of a
reflexive relation `d₁, d₂ : H ⇉ R` of affine group schemes with common retraction `e`, if
`q : R → B` kills exactly the ideal generated by `d₁(H⁺)`, then the kernel of the surjective
Hopf algebra morphism `π = q ∘ d₂` is a normal Hopf ideal of `H`. -/
theorem isNormalHopfIdeal_ker (hd₁ : ∀ x, e (d₁ x) = x) (hd₂ : ∀ x, e (d₂ x) = x)
    (hq : ∀ a : H, q (d₁ a) = (algebraMap k B) (counit (R := k) a))
    (hker : ∀ r : R, q r = 0 →
      r ∈ Ideal.span ((d₁ : H → R) '' (HopfAlgebra.Commutative.augmentationIdeal k H)))
    (hπ : ∀ x, π x = q (d₂ x)) (hsurj : Function.Surjective π) :
    HopfAlgebra.IsNormalHopfIdeal k (RingHom.ker (π : H →ₐ[k] B)) := by
  classical
  set I : Ideal H := RingHom.ker (π : H →ₐ[k] B) with hI
  have hsurj' : Function.Surjective (π : H →ₐ[k] B) := hsurj
  set iota : (H ⧸ I) ≃ₐ[k] B := Ideal.quotientKerAlgEquivOfSurjective hsurj' with hiota
  have hiota_mk : ∀ x : H, iota (Ideal.Quotient.mk I x) = π x := fun x => rfl
  have hcomp : (iota : (H ⧸ I) →ₐ[k] B).comp (Ideal.Quotient.mkₐ k I) = (π : H →ₐ[k] B) := by
    ext x; exact hiota_mk x
  have hmem : ∀ x : H, x ∈ I ↔ π x = 0 := fun x => Iff.rfl
  refine ⟨(Ideal.isHopfIdeal_iff_quotient_conditions (R := k) I).2 ⟨?_, ?_, ?_⟩, ?_⟩
  · intro x hx
    have hcx : counit (R := k) (π x) = counit (R := k) x :=
      CoalgHomClass.counit_comp_apply (π : H →ₗc[k] B) x
    rw [(hmem x).1 hx] at hcx
    simpa using hcx.symm
  · intro x hx
    refine tensorMap_injective iota iota ?_
    rw [map_zero, ← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, hcomp, tensorMap_comul,
      (hmem x).1 hx, map_zero]
  · intro x hx
    have hsx : π (antipode k x) = antipode k (π x) := (HopfAlgebra.antipode_bialgHom_apply π x).symm
    rw [(hmem x).1 hx, map_zero] at hsx
    exact hsx
  · intro x hx
    refine tensorMap_injective (AlgEquiv.refl (R := k) (A₁ := H)) iota ?_
    have hid : ((AlgEquiv.refl (R := k) (A₁ := H)) : H →ₐ[k] H) = AlgHom.id k H := rfl
    rw [map_zero, HopfAlgebra.lTensorQuot, hid, ← AlgHom.comp_apply,
      ← Algebra.TensorProduct.map_comp, hcomp,
      AlgHom.comp_id, ← xiMap_d₂ d₂ hd₂ π hπ x]
    refine xiMap_eq_zero_of_mem_span d₁ hd₁ hq (hker _ ?_)
    rw [← hπ]
    exact (hmem x).1 hx

end Ker

end Coexact
end AffineGroupSchemes
