module

public import AffineGroupSchemes.CoexactSetup
public import Hopf.Basic.HopfModule
public import Hopf.Basic.HopfAdjointCoaction

/-!
# A reflexive relation of affine group schemes is a Hopf module

Let `H` and `R` be commutative Hopf algebras over a commutative von Neumann regular ring `k` (for
instance a field), let `d₁, d₂ : H →ₐc[k] R` be morphisms of Hopf algebras and let `e : R →ₐc[k] H`
be a common retraction, i.e. `e ∘ d₁ = e ∘ d₂ = id` (the reflexivity of the relation
`Spec R ⊆ Spec H × Spec H`).

Then `R` becomes an `(H, H)`-Hopf module in the sense of `Hopf/Basic/HopfModule.lean`:

* the action is `h • r = d₁(S h) · r`  (translation of the relation by the group);
* the coaction is `ρ r = ∑ r₍₂₎ ⊗ S(e r₍₁₎)`.

Sweedler's fundamental theorem then gives a linear isomorphism `H ⊗[k] R^{co H} ≅ R`,
`x ⊗ n ↦ d₁ x · n`, whose space of coinvariants `R^{co H}` is exactly the image of the
difference morphism `p` of `AffineGroupSchemes/CoexactSetup.lean`.  Geometrically: the relation
`Spec R` is isomorphic to `Spec H × N`, where `N` is the "kernel" normal subgroup scheme, via
`(a, b) ↦ (a, a⁻¹b)`.

## Main results

* `AffineGroupSchemes.Coexact.isHopfModule_of_retraction`: if `e ∘ d₁ = id`, then `R` is an
  `(H, H)`-Hopf module for the action `h • r = d₁(S h) r` and the coaction
  `ρ r = ∑ r₍₂₎ ⊗ S(e r₍₁₎)`.
* `AffineGroupSchemes.Coexact.coinv_le_range_diff`: if `e ∘ d₂ = id` and `jointAlg d₁ d₂` is
  surjective, the coinvariants `R^{co H}` are contained in the range of the difference morphism.
* `AffineGroupSchemes.Coexact.hopfModuleEquiv`: for an `(H, H)`-Hopf module `R`, Sweedler's linear
  isomorphism `H ⊗[k] R^{co H} ≃ₗ[k] R`.
* `AffineGroupSchemes.Coexact.eq_zero_of_mem_coinv_of_mem_span`: a coinvariant element of `R` lying
  in the ideal generated by `d₁(H⁺)` is zero.

## References

* [M. E. Sweedler, *Hopf algebras*][Sweedler], 4.1.1
* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972]
* [D. Forsman, *On the semi-abelianness of affine group
  schemes*][forsman2026semiabeliannessaffinegroupschemes]
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

namespace AffineGroupSchemes

open Coalgebra HopfAlgebra HopfAlgebra.Commutative
namespace Coexact

universe u

variable {k H R : Type u} [CommRing k] [CommRing H] [CommRing R] [HopfAlgebra k H]
    [HopfAlgebra k R]

section Structure

variable (e : R →ₐc[k] H)

/-- The coaction `ρ : R →ₐ[k] R ⊗[k] H`, `r ↦ ∑ r₍₂₎ ⊗ S(e r₍₁₎)`. -/
noncomputable def coactAlg : R →ₐ[k] R ⊗[k] H :=
  ((Algebra.TensorProduct.comm k H R).toAlgHom).comp
    ((Algebra.TensorProduct.map
        ((HopfAlgebra.antipodeAlgHom k H).comp (e : R →ₐ[k] H)) (AlgHom.id k R)).comp
      (Bialgebra.comulAlgHom k R))

/-- `coactAlg e r = ∑ r₍₂₎ ⊗ S(e r₍₁₎)`, computed from a representation `rr` of `Δ r`. -/
lemma coactAlg_apply (r : R) {ι : Type*} (rr : Coalgebra.Repr k r ι) :
    coactAlg e r = ∑ i ∈ rr.index, rr.right i ⊗ₜ[k] antipode k (e (rr.left i)) := by
  simp [coactAlg, ← rr.eq]

/-- The coaction on the image of a morphism `d` split by `e`. -/
lemma coactAlg_bialgHom (d : H →ₐc[k] R) (hd : ∀ x, e (d x) = x) (a : H)
    {ι : Type*} (ra : Coalgebra.Repr k a ι) :
    coactAlg e (d a) = ∑ i ∈ ra.index, d (ra.right i) ⊗ₜ[k] antipode k (ra.left i) := by
  simp [coactAlg_apply e (d a) (ra.induced d), hd]

/-- The shuffle `R ⊗ (R ⊗ R) → R ⊗ (H ⊗ H)`, `u ⊗ (v ⊗ w) ↦ w ⊗ (S(e v) ⊗ S(e u))`, used to
deduce the coassociativity of the coaction from that of the comultiplication. -/
noncomputable def coassocShuffle : R ⊗[k] (R ⊗[k] R) →ₗ[k] R ⊗[k] (H ⊗[k] H) :=
  (LinearMap.lTensor R (TensorProduct.map
      ((HopfAlgebra.antipodeAlgHom k H).comp (e : R →ₐ[k] H)).toLinearMap
      ((HopfAlgebra.antipodeAlgHom k H).comp (e : R →ₐ[k] H)).toLinearMap)) ∘ₗ
    (LinearMap.lTensor R (TensorProduct.comm k R R).toLinearMap) ∘ₗ
    (TensorProduct.comm k (R ⊗[k] R) R).toLinearMap ∘ₗ
    (TensorProduct.assoc k R R R).symm.toLinearMap
/-- `coassocShuffle e` sends `u ⊗ (v ⊗ w)` to `w ⊗ (S(e v) ⊗ S(e u))`. -/
@[simp] lemma coassocShuffle_tmul (u v w : R) :
    coassocShuffle e (u ⊗ₜ[k] (v ⊗ₜ[k] w))
      = w ⊗ₜ[k] (antipode k (e v) ⊗ₜ[k] antipode k (e u)) := rfl

/-- **The right `H`-comodule structure on `R`**, `ρ r = ∑ r₍₂₎ ⊗ S(e r₍₁₎)`. -/
@[instance_reducible]
noncomputable def rightComodule : RightComodule k H R where
  coact := (coactAlg e).toLinearMap
  coassoc := by
    classical
    ext r
    set rr := ℛ k r with hrr
    set a₁ : (i : R × R) → Coalgebra.Repr k (rr.left i) (R × R) := fun i => ℛ k (rr.left i) with ha₁
    set a₂ : (i : R × R) → Coalgebra.Repr k (rr.right i) (R × R) := fun i => ℛ k (rr.right i) with
        ha₂
    have key := congrArg (coassocShuffle e) (Coalgebra.sum_tmul_tmul_eq rr a₁ a₂)
    simp only [map_sum, coassocShuffle_tmul] at key
    rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply, AlgHom.toLinearMap_apply,
      LinearEquiv.coe_coe, coactAlg_apply e r rr]
    -- the left-hand side
    have hL : (TensorProduct.assoc k R H H) ((LinearMap.rTensor H (coactAlg e).toLinearMap)
        (∑ i ∈ rr.index, rr.right i ⊗ₜ[k] antipode k (e (rr.left i))))
        = ∑ i ∈ rr.index, ∑ j ∈ (a₂ i).index,
            (a₂ i).right j ⊗ₜ[k]
              (antipode k (e ((a₂ i).left j)) ⊗ₜ[k] antipode k (e (rr.left i))) := by
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [LinearMap.rTensor_tmul, AlgHom.toLinearMap_apply, coactAlg_apply e (rr.right i) (a₂ i),
        TensorProduct.sum_tmul, map_sum]
      exact Finset.sum_congr rfl fun j _ => rfl
    -- the right-hand side
    have hR : (LinearMap.lTensor R (comul (R := k) (A := H)))
        (∑ i ∈ rr.index, rr.right i ⊗ₜ[k] antipode k (e (rr.left i)))
        = ∑ i ∈ rr.index, ∑ j ∈ (a₁ i).index,
            rr.right i ⊗ₜ[k]
              (antipode k (e ((a₁ i).right j)) ⊗ₜ[k] antipode k (e ((a₁ i).left j))) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [LinearMap.lTensor_tmul,
        HopfAlgebra.comul_antipode_apply (e (rr.left i)) ((a₁ i).induced e), TensorProduct.tmul_sum]
      exact Finset.sum_congr rfl fun j _ => rfl
    rw [hL, hR, ← key]
  counit_coact := by
    classical
    ext r
    set rr := ℛ k r with hrr
    rw [LinearMap.comp_apply, LinearMap.comp_apply, AlgHom.toLinearMap_apply, LinearEquiv.coe_coe,
      LinearMap.id_apply, coactAlg_apply e r rr, map_sum, map_sum]
    refine Eq.trans (Finset.sum_congr rfl (fun i _ => ?_)) (Coalgebra.sum_counit_smul rr)
    rw [LinearMap.lTensor_tmul, TensorProduct.rid_tmul, HopfAlgebra.counit_antipode,
      CoalgHomClass.counit_comp_apply]

/-- The coaction of `rightComodule e` is `coactAlg e`. -/
lemma rightComodule_coact (r : R) :
    letI := rightComodule e
    Coalgebra.Comodule.coact (R := k) (C := H) r = coactAlg e r := rfl

end Structure

section ModuleStructure

variable (d₁ : H →ₐc[k] R) (e : R →ₐc[k] H)

/-- The `H`-algebra structure on `R` given by `h ↦ d₁ (S h)`; the corresponding action
`h • r = d₁(S h) · r` is the translation action of the group on the relation. -/
@[instance_reducible]
noncomputable def algebraAnti : Algebra H R :=
  RingHom.toAlgebra ((d₁ : H →ₐ[k] R).comp (HopfAlgebra.antipodeAlgHom k H)).toRingHom

/-- The structure map of `algebraAnti d₁` is `h ↦ d₁(S h)`. -/
lemma algebraMap_algebraAnti (h : H) :
    letI := algebraAnti d₁
    algebraMap H R h = d₁ (antipode k h) := rfl

/-- The action of `algebraAnti d₁` is `h • r = d₁(S h) · r`. -/
lemma algebraAnti_smul (h : H) (r : R) :
    letI := algebraAnti d₁
    h • r = d₁ (antipode k h) * r := rfl

/-- The `H`-algebra structure `algebraAnti d₁` on `R` is compatible with the `k`-algebra
structures. -/
lemma isScalarTower_algebraAnti :
    letI := algebraAnti d₁
    IsScalarTower k H R := by
  let := algebraAnti d₁
  refine .of_algebraMap_eq fun c => ?_
  rw [algebraMap_algebraAnti, show antipode k (algebraMap k H c) = algebraMap k H c from by
    rw [Algebra.algebraMap_eq_smul_one, map_smul, HopfAlgebra.antipode_one]]
  exact ((d₁ : H →ₐ[k] R).commutes c).symm

/-- **`R` is an `(H, H)`-Hopf module** for the translation action `h • r = d₁(S h) r` and the
coaction `ρ r = ∑ r₍₂₎ ⊗ S(e r₍₁₎)`. -/
lemma isHopfModule_of_retraction (hd₁ : ∀ x, e (d₁ x) = x) :
    letI := algebraAnti d₁
    letI := isScalarTower_algebraAnti d₁
    letI := rightComodule e
    HopfAlgebra.IsHopfModule k H R := by
  classical
  let := algebraAnti d₁
  let := isScalarTower_algebraAnti d₁
  let := rightComodule e
  refine ⟨fun h m => ?_⟩
  set rh := ℛ k h with hrh
  set rm := ℛ k m with hrm
  -- a Sweedler representation of `S h`
  let rSh : Coalgebra.Repr k (antipode k h) (H × H) :=
    { index := rh.index, left := fun i => antipode k (rh.right i),
      right := fun i => antipode k (rh.left i),
      eq := (HopfAlgebra.comul_antipode_apply h rh).symm }
  have hcoactSh : coactAlg e (d₁ (antipode k h))
      = ∑ i ∈ rh.index, d₁ (antipode k (rh.left i)) ⊗ₜ[k] rh.right i := by
    simp [coactAlg_bialgHom e d₁ hd₁ (antipode k h) rSh, rSh, HopfAlgebra.antipode_antipode]
  have hLHS : Coalgebra.Comodule.coact (R := k) (C := H) (h • m)
      = ∑ i ∈ rh.index, ∑ j ∈ rm.index,
          (d₁ (antipode k (rh.left i)) * rm.right j) ⊗ₜ[k]
            (rh.right i * antipode k (e (rm.left j))) := by
    rw [rightComodule_coact, algebraAnti_smul, map_mul, hcoactSh, coactAlg_apply e m rm,
      Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.TensorProduct.tmul_mul_tmul]
  rw [hLHS]
  rw [show comul (R := k) h = ∑ i ∈ rh.index, rh.left i ⊗ₜ[k] rh.right i from rh.eq.symm]
  rw [rightComodule_coact, coactAlg_apply e m rm, TensorProduct.sum_tmul]
  simp only [map_sum, TensorProduct.tmul_sum]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  rw [HopfAlgebra.hopfCompat_tmul]
  rfl

end ModuleStructure

section HopfModules

variable {d₁ d₂ : H →ₐc[k] R} {e : R →ₐc[k] H}
  [Algebra H R] [IsScalarTower k H R] [RightComodule k H R] [HopfAlgebra.IsHopfModule k H R]
  (hsmul : ∀ (h : H) (r : R), h • r = d₁ (antipode k h) * r)
  (hcoact : ∀ r : R, Coalgebra.Comodule.coact (R := k) (C := H) r = coactAlg e r)

include hsmul hcoact in
omit [HopfAlgebra.IsHopfModule k H R] in
/-- The Sweedler projection of `d₂ y` is the difference morphism. -/
lemma proj_d₂ (hd₂ : ∀ x, e (d₂ x) = x) (y : H) :
    HopfAlgebra.proj k H R (d₂ y) = diffLin d₁ d₂ y := by
  classical
  set ry := ℛ k y with hry
  let r : Coalgebra.Comodule.Repr k H (d₂ y) :=
    { ι := H × H, index := ry.index, left := fun i => d₂ (ry.right i),
      right := fun i => antipode k (ry.left i),
      eq := by rw [hcoact]; exact (coactAlg_bialgHom e d₂ hd₂ y ry).symm }
  rw [HopfAlgebra.proj_apply (d₂ y) r, diffLin_apply d₁ d₂ y ry]
  exact Finset.sum_congr rfl fun i _ => by simp [r, HopfAlgebra.antipode_antipode, hsmul]

include hsmul hcoact in
/-- The difference map `p = diffLin d₁ d₂` takes values in the coinvariants `R^{co H}`. -/
lemma diff_mem_coinv (hd₂ : ∀ x, e (d₂ x) = x) (y : H) :
    diffLin d₁ d₂ y ∈ HopfAlgebra.coinv k H R := by
  rw [← proj_d₂ hsmul hcoact hd₂ y]
  exact HopfAlgebra.proj_mem_coinv _

/-- The projection `HopfAlgebra.proj k H R` fixes every coinvariant `n ∈ R^{co H}`. -/
lemma proj_eq_self_of_mem_coinv {n : R} (hn : n ∈ HopfAlgebra.coinv k H R) :
    HopfAlgebra.proj k H R n = n := by
  have h := HopfAlgebra.proj_smul_of_mem_coinv (k := k) (1 : H) hn
  rwa [one_smul, show counit (R := k) (1 : H) = 1 from by simp, one_smul] at h

include hsmul hcoact in
/-- **The coinvariants are exactly the image of the difference morphism.** -/
lemma coinv_le_range_diff (hd₂ : ∀ x, e (d₂ x) = x)
    (hsurj : Function.Surjective (jointAlg d₁ d₂)) :
    HopfAlgebra.coinv k H R ≤ LinearMap.range (diffLin d₁ d₂) := by
  have hd₁d₂ (a b : H) : d₁ a * d₂ b = antipode k a • d₂ b := by
    rw [hsmul, HopfAlgebra.antipode_antipode]
  have key : ∀ z : H ⊗[k] H,
      HopfAlgebra.proj k H R (jointAlg d₁ d₂ z) ∈ LinearMap.range (diffLin d₁ d₂) := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul a b =>
      rw [jointAlg_tmul, hd₁d₂, HopfAlgebra.proj_smul, HopfAlgebra.counit_antipode,
        proj_d₂ hsmul hcoact hd₂ b]
      exact Submodule.smul_mem _ _ ⟨b, rfl⟩
    | add p q hp hq => rw [map_add, map_add]; exact Submodule.add_mem _ hp hq
  intro n hn
  obtain ⟨z, hz⟩ := hsurj n
  rw [← proj_eq_self_of_mem_coinv hn, ← hz]
  exact key z

end HopfModules

section Iso

variable (k H R)
variable [Algebra H R] [IsScalarTower k H R] [RightComodule k H R] [HopfAlgebra.IsHopfModule k H R]

/-- The antipode of `H` as a linear automorphism (it is involutive). -/
noncomputable def antipodeLinearEquiv : H ≃ₗ[k] H :=
  LinearEquiv.ofLinearMap (antipode k) (antipode k)
    (by ext x; exact HopfAlgebra.antipode_antipode x)
    (by ext x; exact HopfAlgebra.antipode_antipode x)

/-- **Sweedler's isomorphism in the form we need**: `H ⊗[k] R^{co H} ≅ R`, `x ⊗ n ↦ d₁ x · n`
(the fundamental theorem of Hopf modules, [Sweedler], 4.1.1). -/
noncomputable def hopfModuleEquiv : H ⊗[k] ↥(HopfAlgebra.coinv k H R) ≃ₗ[k] R :=
  (TensorProduct.congr (antipodeLinearEquiv k H) (LinearEquiv.refl k _)).trans
    ((TensorProduct.comm k H ↥(HopfAlgebra.coinv k H R)).trans HopfAlgebra.hopfModuleEquiv)

/-- The `k`-linear retraction `R → R^{co H}` induced by the counit under Sweedler's
isomorphism. -/
noncomputable def coinvProj : R →ₗ[k] ↥(HopfAlgebra.coinv k H R) :=
  (TensorProduct.lid k ↥(HopfAlgebra.coinv k H R)).toLinearMap ∘ₗ
    (LinearMap.rTensor ↥(HopfAlgebra.coinv k H R) (counit (R := k) (A := H))) ∘ₗ
    (hopfModuleEquiv k H R).symm.toLinearMap

variable {k H R}
variable {d₁ : H →ₐc[k] R} (hsmul : ∀ (h : H) (r : R), h • r = d₁ (antipode k h) * r)

include hsmul in
/-- `hopfModuleEquiv` sends `x ⊗ n` to `d₁ x · n`. -/
@[simp] lemma hopfModuleEquiv_tmul (x : H) (n : ↥(HopfAlgebra.coinv k H R)) :
    hopfModuleEquiv k H R (x ⊗ₜ[k] n) = d₁ x * (n : R) := by
  simp [hopfModuleEquiv, antipodeLinearEquiv, HopfAlgebra.hopfModuleEquiv_tmul, hsmul,
    HopfAlgebra.antipode_antipode]

/-- `coinvProj` sends `hopfModuleEquiv (x ⊗ n)` to `ε(x) • n`. -/
lemma coinvProj_tmul (x : H) (n : ↥(HopfAlgebra.coinv k H R)) :
    coinvProj k H R (hopfModuleEquiv k H R (x ⊗ₜ[k] n)) = (counit (R := k) x) • n := by
  simp [coinvProj]

include hsmul in
/-- For `x : H` and `n ∈ R^{co H}`, `coinvProj (d₁ x · n) = ε(x) • n`. -/
lemma coinvProj_d₁_mul_coinv (x : H) (n : ↥(HopfAlgebra.coinv k H R)) :
    coinvProj k H R (d₁ x * (n : R)) = (counit (R := k) x) • n := by
  rw [← hopfModuleEquiv_tmul hsmul, coinvProj_tmul]

include hsmul in
/-- `coinvProj` is a retraction of the inclusion: `coinvProj n = n` for `n ∈ R^{co H}`. -/
lemma coinvProj_coe (n : ↥(HopfAlgebra.coinv k H R)) : coinvProj k H R (n : R) = n := by
  have h : hopfModuleEquiv k H R ((1 : H) ⊗ₜ[k] n) = (n : R) := by
    rw [hopfModuleEquiv_tmul hsmul, map_one, one_mul]
  rw [← h, coinvProj_tmul]
  simp

include hsmul in
/-- For `a : H` and `r : R`, `coinvProj (d₁ a · r) = ε(a) • coinvProj r`. -/
lemma coinvProj_d₁_mul (a : H) (r : R) :
    coinvProj k H R (d₁ a * r) = (counit (R := k) a) • coinvProj k H R r := by
  have key : ∀ w : H ⊗[k] ↥(HopfAlgebra.coinv k H R),
      coinvProj k H R (d₁ a * hopfModuleEquiv k H R w)
        = (counit (R := k) a) • coinvProj k H R (hopfModuleEquiv k H R w) := by
    intro w
    induction w using TensorProduct.inductionOn with
    | tmul x n =>
      rw [hopfModuleEquiv_tmul hsmul, ← mul_assoc, ← map_mul,
        coinvProj_d₁_mul_coinv hsmul, coinvProj_d₁_mul_coinv hsmul, Bialgebra.counit_mul,
        mul_smul]
    | add u v hu hv =>
      rw [map_add, mul_add, map_add, map_add, hu, hv, smul_add]
  have hw := key ((hopfModuleEquiv k H R).symm r)
  rwa [LinearEquiv.apply_symm_apply] at hw

include hsmul in
/-- **A coinvariant element lying in the ideal `d₁(H⁺)R` vanishes.**  Under Sweedler's
isomorphism `R ≅ H ⊗ R^{co H}` this ideal is `H⁺ ⊗ R^{co H}`, which meets `1 ⊗ R^{co H}`
trivially. -/
theorem eq_zero_of_mem_coinv_of_mem_span {n : R} (hn : n ∈ HopfAlgebra.coinv k H R)
    (hJ : n ∈ Ideal.span ((d₁ : H → R) '' (HopfAlgebra.Commutative.augmentationIdeal k H))) : n = 0
        := by
  set Q : Ideal R :=
    { carrier := {r : R | ∀ c : R, coinvProj k H R (c * r) = 0}
      add_mem' := fun {r r'} hr hr' c => by
        rw [mul_add, map_add, hr c, hr' c, add_zero]
      zero_mem' := fun c => by simp
      smul_mem' := fun c r hr c' => by rw [smul_eq_mul, ← mul_assoc]; exact hr _ } with hQ
  have hgen : ((d₁ : H → R) '' (HopfAlgebra.Commutative.augmentationIdeal k H)) ⊆ (Q : Set R) := by
    rintro _ ⟨a, ha, rfl⟩ c
    rw [mul_comm, coinvProj_d₁_mul hsmul,
      (HopfAlgebra.Commutative.mem_augmentationIdeal k H).1 ha, zero_smul]
  have hmem : n ∈ Q := Ideal.span_le.2 hgen hJ
  have h0 : coinvProj k H R n = 0 := by simpa using hmem 1
  have h1 : coinvProj k H R n = (⟨n, hn⟩ : ↥(HopfAlgebra.coinv k H R)) :=
    coinvProj_coe hsmul ⟨n, hn⟩
  rw [h1] at h0
  exact congrArg Subtype.val h0

end Iso

end Coexact
end AffineGroupSchemes
