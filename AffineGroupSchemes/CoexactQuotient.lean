module

public import AffineGroupSchemes.CoexactHopfModule
public import AffineGroupSchemes.CoexactNormal
public import Hopf.Basic.HopfQuotAugHopf

/-!
# The quotient of a reflexive relation by the first projection

We keep the situation of `AffineGroupSchemes/CoexactSetup.lean` and
`AffineGroupSchemes/CoexactHopfModule.lean`: `d₁, d₂ : H →ₐc[k] R` are two morphisms of
commutative Hopf algebras admitting a common retraction `e : R →ₐc[k] H`.

The ideal `J = d₁(H⁺)R` of `R` (`AffineGroupSchemes.Coexact.jIdeal`) is a Hopf ideal, so that
`B = R/J` is again a Hopf algebra; geometrically `Spec B` is the "kernel" of the relation, the fibre
of the first projection over the unit. This file proves the elementary properties of a morphism
`q : R →ₐc[k] B` which kills exactly `J`:

* `AffineGroupSchemes.Coexact.q_d₂_eq_q_diff`: `q ∘ d₂ = q ∘ p`, where `p` is the difference
  morphism;
* `AffineGroupSchemes.Coexact.q_eq_q_coinvProj`: `q` factors through the Sweedler projection onto
  the coinvariants;
* `AffineGroupSchemes.Coexact.surjective_comp_d₂`: `π = q ∘ d₂ : H → B` is surjective;
* `AffineGroupSchemes.Coexact.diff_eq_zero_of_q_d₂_eq_zero`: the kernel of `π` is contained in the
  kernel of the difference morphism `p`.

## Main results

* `AffineGroupSchemes.Coexact.isHopfIdeal_jIdeal`: the ideal `J = d₁(H⁺)R` is a Hopf ideal.
* `AffineGroupSchemes.Coexact.q_d₂_eq_q_diff`: `q (d₂ x) = q (p x)`, where `p` is the difference
  morphism.
* `AffineGroupSchemes.Coexact.q_eq_q_coinvProj`: `q` factors through the Sweedler projection onto
  the coinvariants.
* `AffineGroupSchemes.Coexact.surjective_comp_d₂`: `π = q ∘ d₂ : H → B` is surjective.
* `AffineGroupSchemes.Coexact.diff_eq_zero_of_q_d₂_eq_zero`: if `q (d₂ x) = 0` then `p x = 0`.

## References

* [M. E. Sweedler, *Hopf algebras*][Sweedler], 4.1.1
* [D. Forsman, *On the semi-abelianness of affine group
  schemes*][forsman2026semiabeliannessaffinegroupschemes]
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

namespace AffineGroupSchemes

open Coalgebra HopfAlgebra HopfAlgebra.Commutative
namespace Coexact

universe u

variable {k H R : Type u} [CommRing k] [CommRing H] [CommRing R] [HopfAlgebra k H]
    [HopfAlgebra k R]

/-- The ideal `J = d₁(H⁺)R` of `R` generated by the image under `d₁` of the augmentation ideal
of `H`. -/
noncomputable def jIdeal (d₁ : H →ₐc[k] R) : Ideal R :=
  Ideal.span ((d₁ : H → R) '' (HopfAlgebra.Commutative.augmentationIdeal k H))

/-- **`J = d₁(H⁺)R` is a Hopf ideal**, so that `B = R/J` is a Hopf algebra. -/
lemma isHopfIdeal_jIdeal (d₁ : H →ₐc[k] R) : HopfAlgebra.IsHopfIdeal k (jIdeal d₁) := by
  let : Algebra H R := algebraOfBialgHom (d₁ : H →ₐc[k] R)
  have : IsScalarTower k H R := IsScalarTower.of_algebraMap_eq fun c =>
    (AlgHomClass.commutes d₁ c).symm
  have h : HopfAlgebra.augIdealB k H R = jIdeal d₁ := rfl
  rw [← h]
  exact HopfAlgebra.isHopfIdeal_augIdealB (d₁ : H →ₐc[k] R) (fun _ => rfl)

section Quot

variable {B : Type u} [CommRing B] [HopfAlgebra k B]

/-- On the image of `d₂` the morphism `q` agrees with the difference morphism. -/
lemma q_d₂_eq_q_diff (d₁ d₂ : H →ₐc[k] R) (q : R →ₐc[k] B)
    (hq : ∀ a : H, q (d₁ a) = (algebraMap k B) (counit (R := k) a)) (x : H) :
    q (d₂ x) = q (diffLin d₁ d₂ x) := by
  classical
  set r := ℛ k x with hr
  rw [← sum_d₁_mul_diff d₁ d₂ x r, map_sum]
  have hterm : ∀ i ∈ r.index, q (d₁ (r.left i) * diffLin d₁ d₂ (r.right i))
      = q (diffLin d₁ d₂ ((counit (R := k) (r.left i)) • r.right i)) := by
    intro i _
    rw [map_mul, hq, map_smul, map_smul, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
  rw [Finset.sum_congr rfl hterm, ← map_sum, ← map_sum, Coalgebra.sum_counit_smul r]

end Quot

section HopfModules

variable {B : Type u} [CommRing B] [HopfAlgebra k B]
variable {d₁ d₂ : H →ₐc[k] R} {e : R →ₐc[k] H}
  [Algebra H R] [IsScalarTower k H R] [RightComodule k H R] [HopfAlgebra.IsHopfModule k H R]

/-- `q` factors through the Sweedler projection onto the coinvariants. -/
lemma q_eq_q_coinvProj (q : R →ₐc[k] B)
    (hsmul : ∀ (h : H) (r : R), h • r = d₁ (antipode k h) * r)
    (hq : ∀ a : H, q (d₁ a) = (algebraMap k B) (counit (R := k) a)) (r : R) :
    q r = q ((coinvProj k H R r : R)) := by
  have key : ∀ w : H ⊗[k] ↥(HopfAlgebra.coinv k H R),
      q (hopfModuleEquiv k H R w) = q ((coinvProj k H R (hopfModuleEquiv k H R w) : R)) := by
    intro w
    induction w with
    | tmul x n =>
      rw [hopfModuleEquiv_tmul hsmul, coinvProj_d₁_mul_coinv hsmul, map_mul, hq,
        Submodule.coe_smul, map_smul, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
    | add u v hu hv =>
      rw [map_add, map_add, map_add, Submodule.coe_add, map_add, hu, hv]
  have h := key ((hopfModuleEquiv k H R).symm r)
  rwa [LinearEquiv.apply_symm_apply] at h

/-- **The morphism `π = q ∘ d₂ : H → B` is surjective.** -/
lemma surjective_comp_d₂ (q : R →ₐc[k] B)
    (hsmul : ∀ (h : H) (r : R), h • r = d₁ (antipode k h) * r)
    (hcoact : ∀ r : R, Coalgebra.Comodule.coact (R := k) (C := H) r = coactAlg e r)
    (hd₂ : ∀ x, e (d₂ x) = x)
    (hq : ∀ a : H, q (d₁ a) = (algebraMap k B) (counit (R := k) a))
    (hqsurj : Function.Surjective q)
    (hjoint : Function.Surjective (jointAlg d₁ d₂)) :
    Function.Surjective (fun x : H => q (d₂ x)) := by
  intro b
  obtain ⟨r, rfl⟩ := hqsurj b
  obtain ⟨y, hy⟩ := coinv_le_range_diff hsmul hcoact hd₂ hjoint (coinvProj k H R r).2
  refine ⟨y, (q_d₂_eq_q_diff d₁ d₂ q hq y).trans ?_⟩
  rw [hy, ← q_eq_q_coinvProj q hsmul hq r]

/-- **The kernel of the difference morphism is the kernel of `π = q ∘ d₂`** (one inclusion). -/
lemma diff_eq_zero_of_q_d₂_eq_zero (q : R →ₐc[k] B)
    (hsmul : ∀ (h : H) (r : R), h • r = d₁ (antipode k h) * r)
    (hcoact : ∀ r : R, Coalgebra.Comodule.coact (R := k) (C := H) r = coactAlg e r)
    (hd₂ : ∀ x, e (d₂ x) = x)
    (hq : ∀ a : H, q (d₁ a) = (algebraMap k B) (counit (R := k) a))
    (hker : ∀ r : R, q r = 0 → r ∈ jIdeal d₁) {x : H} (hx : q (d₂ x) = 0) :
    diffLin d₁ d₂ x = 0 := by
  have h1 : q (diffLin d₁ d₂ x) = 0 := by rw [← q_d₂_eq_q_diff d₁ d₂ q hq x]; exact hx
  exact eq_zero_of_mem_coinv_of_mem_span hsmul (diff_mem_coinv hsmul hcoact hd₂ x) (hker _ h1)

end HopfModules

end Coexact
end AffineGroupSchemes
