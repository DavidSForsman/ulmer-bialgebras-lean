module

public import Mathlib.CategoryTheory.Limits.Sifted
public import Mathlib.CategoryTheory.FinCategory.Basic

/-!
# The shape of a family of reflexive pairs on one object

For a type `L`, `MultiReflexivePair L` is the category with an object `a` (the apex, `none`) and
objects `r j` (`some j`), `j : L`, generated by morphisms `d₀ j, d₁ j : r j ⟶ a` and a common
section `s j : a ⟶ r j` (`s j ≫ d₀ j = s j ≫ d₁ j = 𝟙 a`). A functor out of it is a family of
reflexive pairs with a common codomain; its colimit generalizes the reflexive coequalizer. When
the pairs are the kernel pairs of regular epimorphisms `a ⟶ bⱼ`, the colimit is their wide pushout
([forsman2026syntactic], §4, the sifted shapes, example 3).

The category is **sifted** for nonempty `L` (`MultiReflexivePair.isSifted`).

## Implementation notes

Hom sets are small types (in `Type`) defined by cases (`Unit`, `Bool`, and `Option Bool`
restricted to constants between distinct labels); `ULiftHom` moves them to any universe.
The morphisms `r j ⟶ r i` are `dᵦ j ≫ s i` (`some b`) and, for `i = j`,
the identity (`none`).

## References

* [D. Forsman, *A Syntactic Approach to Ulmer's Bialgebras*][forsman2026syntactic], §4
-/

@[expose] public section

universe u

open CategoryTheory

namespace UlmerBialgebras

/-- The objects: the apex `apex` and one object `src j` for each `j : L`. -/
inductive MultiReflexivePair (L : Type u) : Type u
  | apex : MultiReflexivePair L
  | src (j : L) : MultiReflexivePair L

namespace MultiReflexivePair

variable {L : Type u}

/-- The (small) hom sets. -/
def Hom₀ : MultiReflexivePair L → MultiReflexivePair L → Type
  | apex, apex => Unit
  | apex, src _ => Unit
  | src _, apex => Bool
  | src j, src i => {o : Option Bool // o = none → i = j}

/-- Composition. -/
def comp₀ : {x y z : MultiReflexivePair L} → Hom₀ x y → Hom₀ y z → Hom₀ x z
  | apex, apex, apex, _, _ => ()
  | apex, apex, src _, _, _ => ()
  | apex, src _, apex, _, _ => ()
  | apex, src _, src _, _, _ => ()
  | src _, apex, apex, b, _ => b
  | src _, apex, src _, b, _ => ⟨some b, fun h => by cases h⟩
  | src _, src _, apex, o, b => o.1.getD b
  | src _, src _, src _, o₁, o₂ =>
      ⟨match o₁.1 with | some b => some b | none => o₂.1, by
        rcases o₁ with ⟨_ | b, h₁⟩
        · intro h
          exact (o₂.2 h).trans (h₁ rfl)
        · intro h
          cases h⟩

/-- Identities. -/
def id₀ : (x : MultiReflexivePair L) → Hom₀ x x
  | apex => ()
  | src _ => ⟨none, fun _ => rfl⟩

instance category : Category.{0} (MultiReflexivePair L) where
  Hom x y := ULift.{0} (Hom₀ x y)
  id x := ⟨id₀ x⟩
  comp f g := ⟨comp₀ f.down g.down⟩
  id_comp := by
    rintro (_ | _) (_ | _) ⟨f⟩ <;> rfl
  comp_id := by
    rintro (_ | _) (_ | _) ⟨f⟩ <;> try rfl
    rcases f with ⟨_ | _, _⟩ <;> rfl
  assoc := by
    rintro (_ | _) (_ | _) (_ | _) (_ | _) ⟨f⟩ ⟨g⟩ ⟨h⟩ <;> try rfl
    all_goals
      rcases f with ⟨_ | _, _⟩ <;> rcases g with ⟨_ | _, _⟩ <;> rcases h with ⟨_ | _, _⟩ <;> rfl

/-- The common section `s j : apex ⟶ src j`. -/
def s (j : L) : (apex : MultiReflexivePair L) ⟶ src j := ⟨()⟩

/-- The two legs `d j b : src j ⟶ apex` of the `j`-th pair (`b = false`, `true`). -/
def d (j : L) (b : Bool) : (src j : MultiReflexivePair L) ⟶ apex := ⟨b⟩

/-- The common section `s j` is a section of both legs `d j b`. -/
@[reassoc (attr := simp)] lemma s_d (j : L) (b : Bool) :
    s j ≫ d j b = 𝟙 (apex : MultiReflexivePair L) := rfl

/-- The chosen morphism into the apex: `𝟙` and `d j false`. -/
def toApex : (x : MultiReflexivePair L) → (x ⟶ apex)
  | apex => 𝟙 _
  | src j => d j false

section Sifted

open Functor

/-- The base point of the comma category of the diagonal at `(X, Y)`. -/
abbrev base (X Y : MultiReflexivePair L) : StructuredArrow (X, Y) (diag (MultiReflexivePair L)) :=
  StructuredArrow.mk (Y := apex) (toApex X, toApex Y)

/-- In the category of cospans from `(X, Y)` to the diagonal, a cospan `(α, β)` into the apex is
zigzag-connected to `(toApex X, β)`. -/
lemma zigzag_left {X Y : MultiReflexivePair L} (α : X ⟶ apex) (β : Y ⟶ apex) :
    Zigzag (StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex) (α, β))
      (StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex)
        (toApex X, β)) := by
  rcases X with _ | j
  · exact Relation.ReflTransGen.refl
  · rcases α with ⟨_ | _⟩
    · exact Relation.ReflTransGen.refl
    · let W := StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := src j)
        (𝟙 (src j), β ≫ s j)
      have h₁ : W ⟶ StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex)
          (d j true, β) :=
        StructuredArrow.homMk (d j true) (by ext <;> simp [W])
      have h₂ : W ⟶ StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex)
          (d j false, β) :=
        StructuredArrow.homMk (d j false) (by ext <;> simp [W])
      exact (Zigzag.of_inv h₁).trans (Zigzag.of_hom h₂)

/-- In the category of cospans from `(X, Y)` to the diagonal, a cospan `(α, β)` into the apex is
zigzag-connected to `(α, toApex Y)`. -/
lemma zigzag_right {X Y : MultiReflexivePair L} (α : X ⟶ apex) (β : Y ⟶ apex) :
    Zigzag (StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex) (α, β))
      (StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex)
        (α, toApex Y)) := by
  rcases Y with _ | j
  · exact Relation.ReflTransGen.refl
  · rcases β with ⟨_ | _⟩
    · exact Relation.ReflTransGen.refl
    · let W := StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := src j)
        (α ≫ s j, 𝟙 (src j))
      have h₁ : W ⟶ StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex)
          (α, d j true) :=
        StructuredArrow.homMk (d j true) (by ext <;> simp [W])
      have h₂ : W ⟶ StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex)
          (α, d j false) :=
        StructuredArrow.homMk (d j false) (by ext <;> simp [W])
      exact (Zigzag.of_inv h₁).trans (Zigzag.of_hom h₂)

/-- Every cospan from `(X, Y)` to the diagonal is zigzag-connected to the base cospan `base X Y`; so
the diagonal is final, which is siftedness. -/
lemma zigzag_base {X Y : MultiReflexivePair L}
    (k : StructuredArrow (X, Y) (diag (MultiReflexivePair L))) : Zigzag k (base X Y) := by
  have h₀ : k ⟶ StructuredArrow.mk (S := (_, _)) (T := diag (MultiReflexivePair L)) (Y := apex)
      (k.hom.1 ≫ toApex k.right, k.hom.2 ≫ toApex k.right) :=
    StructuredArrow.homMk (toApex k.right) rfl
  exact (Zigzag.of_hom h₀).trans ((zigzag_left _ _).trans (zigzag_right _ _))

instance final_diag : Final (diag (MultiReflexivePair L)) where
  out := by
    rintro ⟨X, Y⟩
    have : Nonempty (StructuredArrow (X, Y) (diag (MultiReflexivePair L))) := ⟨base X Y⟩
    exact zigzag_isConnected fun j j' => (zigzag_base j).trans (zigzag_base j').symm

/-- **The shape of a family of reflexive pairs on one object is sifted.** -/
instance isSifted : IsSifted (MultiReflexivePair L) where
  nonempty := ⟨apex⟩

end Sifted

section Functor

variable {C : Type*} [Category C] (A : C) (R : L → C) (d₀ d₁ : ∀ j, R j ⟶ A) (σ : ∀ j, A ⟶ R j)
  (h₀ : ∀ j, σ j ≫ d₀ j = 𝟙 A) (h₁ : ∀ j, σ j ≫ d₁ j = 𝟙 A)

/-- The two legs, indexed by `Bool`. -/
def leg (j : L) : Bool → (R j ⟶ A)
  | false => d₀ j
  | true => d₁ j

include h₀ h₁ in
/-- The common section `σ j` is a section of both legs `d₀ j` and `d₁ j`. -/
lemma σ_leg (j : L) (b : Bool) : σ j ≫ leg A R d₀ d₁ j b = 𝟙 A := by
  cases b
  · exact h₀ j
  · exact h₁ j

/-- The action on morphisms of the functor given by a family of reflexive pairs. -/
def mapHom : {x y : MultiReflexivePair L} → Hom₀ x y →
    ((match x with | apex => A | src j => R j) ⟶ (match y with | apex => A | src j => R j))
  | apex, apex, _ => 𝟙 A
  | apex, src i, _ => σ i
  | src j, apex, b => leg A R d₀ d₁ j b
  | src j, src i, o =>
      match o with
      | ⟨some b, _⟩ => leg A R d₀ d₁ j b ≫ σ i
      | ⟨none, h⟩ => eqToHom (by rw [h rfl])

/-- **The functor given by a family of reflexive pairs** `(d₀ j, d₁ j : R j ⟶ A; σ j)` with a
common codomain `A`. -/
def mkFunctor : MultiReflexivePair L ⥤ C where
  obj x := match x with | apex => A | src j => R j
  map f := mapHom A R d₀ d₁ σ f.down
  map_id := by rintro (_ | _) <;> rfl
  map_comp := by
    have hσ := σ_leg A R d₀ d₁ σ h₀ h₁
    rintro (_ | j) (_ | i) (_ | k) ⟨f⟩ ⟨g⟩
    · cases f; cases g; simp [mapHom]
    · cases f; cases g; simp [mapHom]
    · cases f; cases g <;> simp [mapHom, hσ]
    · cases f; obtain ⟨_ | b, hg⟩ := g
      · obtain rfl := hg rfl; simp [mapHom]
      · simp [mapHom, reassoc_of% hσ]
    · cases f <;> cases g <;> simp [mapHom] <;> rfl
    · cases f <;> cases g <;> simp [mapHom] <;> rfl
    · obtain ⟨_ | b, hf⟩ := f
      · obtain rfl := hf rfl; cases g <;> simp [mapHom] <;> rfl
      · cases g <;> simp [mapHom, hσ] <;> rfl
    · obtain ⟨_ | b, hf⟩ := f
      · obtain rfl := hf rfl
        obtain ⟨_ | b', hg⟩ := g
        · obtain rfl := hg rfl; simp [mapHom]; rfl
        · simp [mapHom]; rfl
      · obtain ⟨_ | b', hg⟩ := g
        · obtain rfl := hg rfl; simp [mapHom]; rfl
        · simp [mapHom, reassoc_of% hσ]; rfl

end Functor

section Finite

/-- The objects are `Option L`. -/
def objEquiv : Option L ≃ MultiReflexivePair L where
  toFun o := match o with
    | none => apex
    | some j => src j
  invFun x := match x with
    | apex => none
    | src j => some j
  left_inv o := by cases o <;> rfl
  right_inv x := by cases x <;> rfl

instance [Fintype L] : Fintype (MultiReflexivePair L) := Fintype.ofEquiv _ objEquiv

instance fintypeHom₀ [DecidableEq L] : (x y : MultiReflexivePair L) → Fintype (Hom₀ x y)
  | apex, apex => inferInstanceAs (Fintype Unit)
  | apex, src _ => inferInstanceAs (Fintype Unit)
  | src _, apex => inferInstanceAs (Fintype Bool)
  | src j, src i => inferInstanceAs (Fintype {o : Option Bool // o = none → i = j})

instance [DecidableEq L] (x y : MultiReflexivePair L) : Fintype (x ⟶ y) :=
  inferInstanceAs (Fintype (ULift (Hom₀ x y)))

/-- For a finite type of labels in `Type`, the shape is a finite category. -/
instance finCategory {L : Type} [Fintype L] [DecidableEq L] :
    FinCategory (MultiReflexivePair L) where

end Finite


end MultiReflexivePair

end UlmerBialgebras
