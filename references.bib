@article{agoreCategoryHopfBraces2026,
	title = {On the category of {Hopf} braces},
	volume = {154},
	copyright = {https://www.ams.org/publications/copyright-and-permissions},
	issn = {1088-6826, 0002-9939},
	url = {https://www.ams.org/proc/0000-000-00/S0002-9939-2026-17751-1/},
	doi = {10.1090/proc/17751},
	abstract = {Hopf braces are the quantum analogues of skew braces and, as such, their cocommutative counterparts provide solutions to the quantum Yang-Baxter equation. We investigate various properties of categories related to Hopf braces. In particular, we prove that the category of Hopf braces is accessible while the category of cocommutative Hopf braces is even locally presentable. We also show that functors forgetting multiple antipodes and/or multiplications down to coalgebras are monadic. Colimits in the category of cocommutative Hopf braces are described explicitly and a free cocommutative Hopf brace on an arbitrary cocommutative Hopf algebra is constructed.},
	language = {en},
	number = {9},
	urldate = {2026-10-30},
	journal = {Proceedings of the American Mathematical Society},
	author = {Agore, Ana and Chirvasitu, Alexandru},
	month = jun,
	year = {2026},
	pages = {3619--3633},
}

