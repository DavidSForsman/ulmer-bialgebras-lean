@misc{forsman2026syntactic,
	title = {A {Syntactic} {Approach} to {Ulmer}'s {Bialgebras}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2607.19587},
	doi = {10.48550/ARXIV.2607.19587},
	abstract = {Ulmer introduced a semantic notion of bialgebras that unifies a broad class of algebraic and coalgebraic structures. We develop a syntactic counterpart by introducing signature pairs \$(Σ,σ)\$ and bialgebraic theories \$T\$, providing a uniform language for constructing internal bialgebras in a \$2\$-categorical setting. For every bialgebraic theory \$T\$ and \$Σ\$-model \$M\$ within a \$2\$-category with PIE limits, we construct the object \$M{\textasciicircum}T\$ of internal \$T\$-bialgebras. Our approach to bialgebras admits a general Induced Functor of Algebras Theorem extending the classical lifting of lax monoidal functors to the categories of internal monoids. Since the construction of \$M{\textasciicircum}T\$ is expressed entirely in terms of PIE limits, accessibility, local presentability, orthogonal factorization systems, regularity, and exactness lift along the construction \$M {\textbackslash}mapsto M{\textasciicircum}T\$ under suitable assumptions.},
	urldate = {2026-11-22},
	publisher = {arXiv},
	author = {Forsman, David},
	month = jul,
	year = {2026},
	keywords = {Category Theory (math.CT), FOS: Mathematics, Logic (math.LO), Quantum Algebra (math.QA)},
}

