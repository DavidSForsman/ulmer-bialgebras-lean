@article{GRAN20194171,
	title = {A semi-abelian extension of a theorem by {Takeuchi}},
	volume = {223},
	issn = {0022-4049},
	url = {https://www.sciencedirect.com/science/article/pii/S002240491930012X},
	doi = {10.1016/j.jpaa.2019.01.004},
	abstract = {We prove that the category of cocommutative Hopf algebras over a field is a semi-abelian category. This result extends a previous special case of it, based on the Milnor–Moore theorem, where the field was assumed to have zero characteristic. Takeuchi's theorem asserting that the category of commutative and cocommutative Hopf algebras over a field is abelian immediately follows from this new observation. We also prove that the category of cocommutative Hopf algebras over a field is action representable. We make some new observations concerning the categorical commutator of normal Hopf subalgebras, and this leads to the proof that two definitions of crossed modules of cocommutative Hopf algebras are equivalent in this context.},
	number = {10},
	journal = {Journal of Pure and Applied Algebra},
	author = {Gran, Marino and Sterck, Florence and Vercruysse, Joost},
	year = {2019},
	keywords = {Categorical commutator, Cocommutative Hopf algebras, Crossed modules, Internal groupoids, Semi-abelian categories},
	pages = {4171--4190},
}

