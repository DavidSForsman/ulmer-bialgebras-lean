module

public import Mathlib.RingTheory.HopkinsLevitzki
public import Hopf.Commutative.ComoduleCoeff
public import Hopf.Basic.CoalgebraLocallyFinite

/-!
# Takeuchi's ideal `N(V, W)` and Lemma 4.12

Let `H` be a commutative Hopf algebra over a field `k`, let `V` be a right `H`-comodule and let
`W ≤ V` be a subspace.  Takeuchi (Definition 4.9 of *A correspondence between Hopf ideals and
sub-Hopf algebras*, manuscripta math. **7** (1972)) associates with the pair `(V, W)` the ideal

```
N(V, W) = H · ρ(W^⊥ ⊗ W) + H · S(ρ(W^⊥ ⊗ W)),
```

where `W^⊥` is the space of linear functionals on `V` vanishing on `W` and
`ρ(χ ⊗ w) = ∑ ⟨χ, w₍₀₎⟩ w₍₁₎` is the *coefficient* of `w` against `χ`
(`HopfAlgebra.Commutative.comoduleCoeff`). It is the smallest Hopf ideal `J` of `H` such that `W` is
a subcomodule of `V` regarded as an `H/J`-comodule.

## Main definitions

* `HopfAlgebra.Commutative.coeffSet W`: the set of coefficients `∑ ⟨χ, w₍₀₎⟩ w₍₁₎`, for `w ∈ W` and
  `χ` vanishing on `W`;
* `HopfAlgebra.Commutative.NIdeal W`: Takeuchi's ideal `N(V, W)`, the ideal generated by
  `coeffSet W` together with the antipodes of its elements.

## Main results

* `HopfAlgebra.Commutative.nIdeal_le_of_coeff_mem`: minimality of `N(V, W)`;
* `HopfAlgebra.Commutative.self_mem_coeffSet`: for `V = H` and `W ⊆ ker ε`, every element of `W` is
  itself one of its coefficients (take `χ = ε`), so `W ⊆ N(H, W)`;
* `HopfAlgebra.Commutative.nIdeal_eq_of_isSubcomodule`: if `E` is a subcomodule of `H` and `I` is a
  Hopf ideal generated by `W = E ⊓ I`, then `I = N(H, W)`;
* `HopfAlgebra.Commutative.exists_NIdeal_eq` (**Takeuchi's Lemma 4.12**): every finitely generated
  Hopf ideal `I` of `H` is of the form `N(H, W)` for a finite-dimensional subspace `W` of `I` which
  is contained in a finite-dimensional subcomodule of `H` and generates `I` as an ideal; in
  particular this holds for every Hopf ideal when `H` is a noetherian ring, e.g. when `H` is a
  finitely generated `k`-algebra.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Lemma 4.8, Definition 4.9 and Lemma 4.12
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

section
open Coalgebra Coalgebra.Comodule HopfAlgebra HopfAlgebra.Commutative
namespace HopfAlgebra.Commutative

open Coalgebra.Comodule

universe u

variable {k H : Type u} [Field k] [CommRing H] [HopfAlgebra k H]

/-! ### Intersections of subspaces after tensoring -/

section TensorInf

variable {M N : Type u} [AddCommGroup M] [Module k M] [AddCommGroup N] [Module k N]

/-- `(A ⊗ N) ⊓ (B ⊗ N) = (A ⊓ B) ⊗ N` inside `M ⊗ N`, for subspaces `A, B ≤ M`. -/
theorem inf_range_rTensor (A B : Submodule k M) :
    LinearMap.range (LinearMap.rTensor N A.subtype) ⊓
        LinearMap.range (LinearMap.rTensor N B.subtype)
      = LinearMap.range (LinearMap.rTensor N (A ⊓ B).subtype) := by
  refine le_antisymm ?_ ?_
  · rintro t ⟨⟨s, rfl⟩, ht⟩
    -- `t` is killed by `(M → M/B) ⊗ id`
    have h0 : LinearMap.rTensor N B.mkQ (LinearMap.rTensor N A.subtype s) = 0 := by
      rw [TensorProduct.range_rTensor_subtype_eq_ker] at ht
      exact ht
    have h1 : LinearMap.rTensor N (B.mkQ ∘ₗ A.subtype) s = 0 := by
      simpa [LinearMap.rTensor_comp] using h0
    obtain ⟨y, hy⟩ := TensorProduct.mem_range_rTensor_ker (M := N) (B.mkQ ∘ₗ A.subtype) h1
    -- the kernel of `A → M/B` is `A ⊓ B`, sitting inside `A`
    have hker : ∀ z : ↥(LinearMap.ker (B.mkQ ∘ₗ A.subtype)), ((z : ↥A) : M) ∈ A ⊓ B := by
      intro z
      refine ⟨(z : ↥A).2, ?_⟩
      have hz := z.2
      simp only [LinearMap.mem_ker, LinearMap.coe_comp, Function.comp_apply,
        Submodule.subtype_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at hz
      exact hz
    let f : ↥(LinearMap.ker (B.mkQ ∘ₗ A.subtype)) →ₗ[k] ↥(A ⊓ B) :=
      { toFun := fun z => ⟨((z : ↥A) : M), hker z⟩
        map_add' _ _ := rfl
        map_smul' _ _ := rfl }
    refine ⟨LinearMap.rTensor N f y, ?_⟩
    rw [← hy, ← LinearMap.comp_apply, ← LinearMap.rTensor_comp, ← LinearMap.comp_apply,
      ← LinearMap.rTensor_comp]
    rfl
  · refine le_inf ?_ ?_
    · rintro t ⟨s, rfl⟩
      exact ⟨LinearMap.rTensor N (Submodule.inclusion (inf_le_left : A ⊓ B ≤ A)) s, by
        rw [← LinearMap.comp_apply, ← LinearMap.rTensor_comp,
          Submodule.subtype_comp_inclusion]⟩
    · rintro t ⟨s, rfl⟩
      exact ⟨LinearMap.rTensor N (Submodule.inclusion (inf_le_right : A ⊓ B ≤ B)) s, by
        rw [← LinearMap.comp_apply, ← LinearMap.rTensor_comp,
          Submodule.subtype_comp_inclusion]⟩

end TensorInf

/-! ### The ideal `N(V, W)` -/

section NIdeal

variable {V : Type u} [AddCommGroup V] [Module k V] [RightComodule k H V]

variable (H) in
/-- The set of coefficients `∑ ⟨χ, w₍₀₎⟩ w₍₁₎` of vectors `w ∈ W` against functionals `χ`
vanishing on `W`; Takeuchi's `ρ(W^⊥ ⊗ W)`. -/
def coeffSet (W : Submodule k V) : Set H :=
  {c : H | ∃ χ : V →ₗ[k] k, (∀ u ∈ W, χ u = 0) ∧ ∃ w ∈ W, c = comoduleCoeff χ w}

variable (H) in
/-- **Takeuchi's ideal `N(V, W)`** (Definition 4.9): the ideal of `H` generated by the
coefficients of the vectors of `W` against the functionals vanishing on `W`, together with the
antipodes of those coefficients. -/
noncomputable def NIdeal (W : Submodule k V) : Ideal H :=
  Ideal.span (coeffSet H W ∪ (fun c => antipode k c) '' coeffSet H W)

/-- The coefficients `coeffSet H W` lie in `N(V, W)`. -/
lemma coeffSet_subset_NIdeal (W : Submodule k V) :
    coeffSet H W ⊆ ((NIdeal H W : Ideal H) : Set H) :=
  fun _ hc => Ideal.subset_span (Or.inl hc)

/-- Minimality of `N(V, W)`: it is contained in every ideal containing the coefficients and their
antipodes. -/
theorem nIdeal_le_of_coeff_mem {W : Submodule k V} {J : Ideal H}
    (hc : ∀ c ∈ coeffSet H W, c ∈ J) (hS : ∀ c ∈ coeffSet H W, antipode k c ∈ J) :
    NIdeal H W ≤ J := by
  refine Ideal.span_le.2 ?_
  rintro c (hc' | ⟨d, hd, rfl⟩)
  · exact hc c hc'
  · exact hS d hd

end NIdeal

/-! ### Contraction against a functional, modulo an ideal -/

section Contract

variable {V : Type u} [AddCommGroup V] [Module k V]

/-- Contraction of the first tensor factor of `V ⊗ H/I` against a linear functional. -/
noncomputable def contractFstQ (I : Ideal H) (χ : V →ₗ[k] k) :
    V ⊗[k] (H ⧸ I) →ₗ[k] (H ⧸ I) :=
  (TensorProduct.lid k (H ⧸ I)).toLinearMap ∘ₗ LinearMap.rTensor (H ⧸ I) χ

/-- `contractFstQ I χ (u ⊗ q) = χ u • q`. -/
@[simp] lemma contractFstQ_tmul (I : Ideal H) (χ : V →ₗ[k] k) (u : V) (q : H ⧸ I) :
    contractFstQ I χ (u ⊗ₜ[k] q) = χ u • q := by
  simp [contractFstQ]

/-- Contracting after reducing modulo `I` is reducing the contraction modulo `I`. -/
lemma contractFstQ_lTensor (I : Ideal H) (χ : V →ₗ[k] k) (z : V ⊗[k] H) :
    contractFstQ I χ (LinearMap.lTensor V (Ideal.Quotient.mkₐ k I).toLinearMap z)
      = Ideal.Quotient.mk I (contractFst χ z) := by
  induction z with
  | tmul u h => simp [Algebra.smul_def, Ideal.Quotient.mk_algebraMap]
  | add p q hp hq => simp only [map_add, hp, hq]

/-- A functional vanishing on `W` kills `W ⊗ H/I`. -/
lemma contractFstQ_eq_zero_of_mem_range (I : Ideal H) {W : Submodule k V} {χ : V →ₗ[k] k}
    (hχ : ∀ u ∈ W, χ u = 0) {z : V ⊗[k] (H ⧸ I)}
    (hz : z ∈ LinearMap.range (LinearMap.rTensor (H ⧸ I) W.subtype)) :
    contractFstQ I χ z = 0 := by
  obtain ⟨y, rfl⟩ := hz
  induction y with
  | tmul w q =>
      rw [LinearMap.rTensor_tmul, Submodule.subtype_apply, contractFstQ_tmul, hχ _ w.2, zero_smul]
  | add p q hp hq => rw [map_add, map_add, hp, hq, add_zero]

end Contract

/-! ### `N(V, W)` is the smallest ideal making `W` a subcomodule (Lemmas 4.8 and 4.9) -/

section Minimality

/-- An element of `U ⊗ M` on which every linear functional of `U` vanishes is zero. -/
theorem tensor_eq_zero_of_forall_functional {U M : Type u} [AddCommGroup U] [Module k U]
    [AddCommGroup M] [Module k M] (y : U ⊗[k] M)
    (h : ∀ ψ : U →ₗ[k] k, (TensorProduct.lid k M) (LinearMap.rTensor M ψ y) = 0) : y = 0 := by
  classical
  set ι := Module.Basis.ofVectorSpaceIndex k U
  set b : Module.Basis ι k U := Module.Basis.ofVectorSpace k U with hb
  set e : U ⊗[k] M ≃ₗ[k] (ι →₀ k) ⊗[k] M := LinearEquiv.rTensor M b.repr with he
  set f : (ι →₀ k) ⊗[k] M ≃ₗ[k] (ι →₀ M) := TensorProduct.finsuppScalarLeft k M ι with hf
  have key : ∀ (z : U ⊗[k] M) (i : ι),
      (f (e z)) i = (TensorProduct.lid k M) (LinearMap.rTensor M (b.coord i) z) := by
    intro z i
    induction z with
    | tmul u m =>
        simp only [he, hf, LinearEquiv.rTensor, LinearMap.rTensor_tmul,
          TensorProduct.finsuppScalarLeft_apply_tmul, TensorProduct.congr_tmul,
          LinearEquiv.refl_apply, TensorProduct.lid_tmul, Module.Basis.coord_apply]
        simp only [Finsupp.sum, Finsupp.single_apply, Finsupp.coe_finsetSum, Finset.sum_apply,
          Finset.sum_ite_eq', Finsupp.mem_support_iff, ne_eq, ite_not]
        split_ifs with hi
        · simp [hi]
        · rfl
    | add p q hp hq => simp [hp, hq]
  have hzero : f (e y) = 0 := by
    ext i
    rw [key y i, h (b.coord i)]
    simp
  have h2 : e y = 0 := (LinearEquiv.map_eq_zero_iff f).1 hzero
  exact (LinearEquiv.map_eq_zero_iff e).1 h2

/-- An element of `V ⊗ M` killed by `χ ⊗ id` for every functional `χ` vanishing on a subspace `W`
lies in `W ⊗ M`. -/
theorem mem_range_rTensor_of_forall_functional {V M : Type u} [AddCommGroup V] [Module k V]
    [AddCommGroup M] [Module k M] (W : Submodule k V) (z : V ⊗[k] M)
    (h : ∀ χ : V →ₗ[k] k, (∀ u ∈ W, χ u = 0) →
      (TensorProduct.lid k M) (LinearMap.rTensor M χ z) = 0) :
    z ∈ LinearMap.range (LinearMap.rTensor M W.subtype) := by
  rw [TensorProduct.range_rTensor_subtype_eq_ker]
  refine tensor_eq_zero_of_forall_functional _ (fun ψ => ?_)
  have hcomp : LinearMap.rTensor M ψ (LinearMap.rTensor M W.mkQ z)
      = LinearMap.rTensor M (ψ ∘ₗ W.mkQ) z := by
    rw [LinearMap.rTensor_comp, LinearMap.comp_apply]
  rw [hcomp]
  exact h _ (fun u hu => by
    simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply]
    rw [(Submodule.Quotient.mk_eq_zero W).2 hu, map_zero])

variable {V : Type u} [AddCommGroup V] [Module k V] [RightComodule k H V]

/-- `W` is a subcomodule of `V` modulo the ideal `J`: the coaction of `W` lands in `W ⊗ H/J`. -/
def IsSubcomoduleMod (J : Ideal H) (W : Submodule k V) : Prop :=
  ∀ w ∈ W, LinearMap.lTensor V (Ideal.Quotient.mkₐ k J).toLinearMap
      (coact (R := k) (C := H) w) ∈ LinearMap.range (LinearMap.rTensor (H ⧸ J) W.subtype)

/-- **Takeuchi's Lemma 4.8**: `W` is a subcomodule of `V` modulo `J` exactly when all the
coefficients of `W` against the functionals vanishing on `W` lie in `J`. -/
theorem isSubcomoduleMod_iff_coeffSet_subset (J : Ideal H) (W : Submodule k V) :
    IsSubcomoduleMod J W ↔ coeffSet H W ⊆ (J : Set H) := by
  constructor
  · rintro hW c ⟨χ, hχ, w, hw, rfl⟩
    have hcf : comoduleCoeff (H := H) χ w = contractFst χ (coact (R := k) (C := H) w) := rfl
    have hcontract : Ideal.Quotient.mk J (comoduleCoeff (H := H) χ w) = 0 := by
      rw [hcf, ← contractFstQ_lTensor J χ (coact (R := k) (C := H) w)]
      exact contractFstQ_eq_zero_of_mem_range J hχ (hW w hw)
    exact Ideal.Quotient.eq_zero_iff_mem.1 hcontract
  · intro hc w hw
    refine mem_range_rTensor_of_forall_functional W _ (fun χ hχ => ?_)
    have hval : (TensorProduct.lid k (H ⧸ J)) (LinearMap.rTensor (H ⧸ J) χ
          (LinearMap.lTensor V (Ideal.Quotient.mkₐ k J).toLinearMap
            (coact (R := k) (C := H) w)))
        = Ideal.Quotient.mk J (comoduleCoeff (H := H) χ w) := by
      have hcf : comoduleCoeff (H := H) χ w = contractFst χ (coact (R := k) (C := H) w) := rfl
      rw [hcf, ← contractFstQ_lTensor J χ (coact (R := k) (C := H) w)]
      rfl
    rw [hval]
    exact Ideal.Quotient.eq_zero_iff_mem.2 (hc ⟨χ, hχ, w, hw, rfl⟩)

/-- **Takeuchi's Definition 4.9**: `W` is a subcomodule of `V` modulo `N(V, W)`. -/
theorem isSubcomoduleMod_NIdeal (W : Submodule k V) :
    IsSubcomoduleMod (NIdeal H W) W :=
  (isSubcomoduleMod_iff_coeffSet_subset _ W).2 (coeffSet_subset_NIdeal W)

/-- **Minimality of `N(V, W)`** among the ideals closed under the antipode: it is contained in
every such ideal `J` for which `W` is a subcomodule modulo `J`. -/
theorem nIdeal_le_iff {J : Ideal H} (hJ : ∀ x ∈ J, antipode k x ∈ J) (W : Submodule k V) :
    NIdeal H W ≤ J ↔ IsSubcomoduleMod J W := by
  constructor
  · intro hle
    exact (isSubcomoduleMod_iff_coeffSet_subset J W).2
      (fun c hc => hle (coeffSet_subset_NIdeal W hc))
  · intro hW
    have hc := (isSubcomoduleMod_iff_coeffSet_subset J W).1 hW
    exact nIdeal_le_of_coeff_mem (fun c hcc => hc hcc) (fun c hcc => hJ c (hc hcc))

end Minimality

/-! ### Takeuchi's Lemma 4.12 -/

section Lemma412

/-- For `V = H` and a subspace `W` of the augmentation ideal, every element of `W` is one of its
own coefficients: take `χ = ε`. -/
theorem self_mem_coeffSet {W : Submodule k H} (hW : ∀ w ∈ W, counit (R := k) (A := H) w = 0)
    {w : H} (hw : w ∈ W) : w ∈ coeffSet (V := H) H W := by
  refine ⟨(counit (R := k) (A := H) : H →ₗ[k] k), hW, w, hw, ?_⟩
  have hdef : comoduleCoeff (H := H) (V := H) (counit (R := k) (A := H)) w
      = (TensorProduct.lid k H)
          (LinearMap.rTensor H (counit (R := k) (A := H)) (comul (R := k) w)) := rfl
  rw [hdef]
  have hcu := congr($(Coalgebra.rTensor_counit_comp_comul (R := k) (A := H)) w)
  simp only [LinearMap.coe_comp, Function.comp_apply] at hcu
  rw [hcu]
  simp

/-- `W ⊆ N(H, W)` for a subspace `W` of the augmentation ideal. -/
theorem subset_NIdeal {W : Submodule k H} (hW : ∀ w ∈ W, counit (R := k) (A := H) w = 0) :
    (W : Set H) ⊆ ((NIdeal (V := H) H W : Ideal H) : Set H) :=
  fun _ hw => coeffSet_subset_NIdeal (V := H) W (self_mem_coeffSet hW hw)

variable {I : Ideal H}

/-- The key step of Lemma 4.12: if `E` is a subcomodule of `H` and `I` is a Hopf ideal, then the
coaction of an element of `W = E ⊓ I` lands in `W ⊗ H/I`, so that the coefficients of `W` against
functionals vanishing on `W` lie in `I`. -/
theorem coeffSet_subset_of_isSubcomodule {E : Submodule k H}
    (hE : Coalgebra.Comodule.IsSubcomodule (C := H) E) (hI : IsHopfIdeal k I) :
    coeffSet (V := H) H (E ⊓ I.restrictScalars k) ⊆ (I : Set H) := by
  classical
  set W : Submodule k H := E ⊓ I.restrictScalars k with hWdef
  rintro c ⟨χ, hχ, w, hw, rfl⟩
  -- the image of `Δ w` in `H ⊗ H/I`
  set z : H ⊗[k] (H ⧸ I) :=
    LinearMap.lTensor H (Ideal.Quotient.mkₐ k I).toLinearMap (comul (R := k) w) with hz
  -- `z` lies in `E ⊗ H/I`
  have hzE : z ∈ LinearMap.range (LinearMap.rTensor (H ⧸ I) E.subtype) := by
    obtain ⟨y, hy⟩ := hE w hw.1
    refine ⟨LinearMap.lTensor ↥E (Ideal.Quotient.mkₐ k I).toLinearMap y, ?_⟩
    have hcomm : ∀ t : ↥E ⊗[k] H,
        LinearMap.rTensor (H ⧸ I) E.subtype
            (LinearMap.lTensor ↥E (Ideal.Quotient.mkₐ k I).toLinearMap t)
          = LinearMap.lTensor H (Ideal.Quotient.mkₐ k I).toLinearMap
              (LinearMap.rTensor H E.subtype t) := by
      intro t
      induction t with
      | tmul u h => simp
      | add p q hp hq => simp only [map_add, hp, hq]
    rw [hcomm, hy, hz]
    simp
  -- `z` lies in `I ⊗ H/I`
  have hzI : z ∈ LinearMap.range (LinearMap.rTensor (H ⧸ I) (I.restrictScalars k).subtype) := by
    have h0 : LinearMap.rTensor (H ⧸ I) (Ideal.Quotient.mkₐ k I).toLinearMap z = 0 := by
      have hcm := IsHopfIdeal.comul_mem k hI w hw.2
      have hfact : ∀ t : H ⊗[k] H,
          LinearMap.rTensor (H ⧸ I) (Ideal.Quotient.mkₐ k I).toLinearMap
              (LinearMap.lTensor H (Ideal.Quotient.mkₐ k I).toLinearMap t)
            = Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k I) (Ideal.Quotient.mkₐ k I) t := by
        intro t
        induction t with
        | tmul a b => simp
        | add p q hp hq => simp only [map_add, hp, hq]
      rw [hz, hfact]
      exact hcm
    have hmem := TensorProduct.mem_range_rTensor_ker (M := H ⧸ I)
      (Ideal.Quotient.mkₐ k I).toLinearMap h0
    rwa [ker_quotMkₐ] at hmem
  -- hence in `W ⊗ H/I`
  have hzW : z ∈ LinearMap.range (LinearMap.rTensor (H ⧸ I) W.subtype) := by
    rw [hWdef, ← inf_range_rTensor (N := H ⧸ I) E (I.restrictScalars k)]
    exact ⟨hzE, hzI⟩
  -- contract with `χ`
  have hcontract : Ideal.Quotient.mk I (comoduleCoeff (H := H) (V := H) χ w) = 0 := by
    have hcf : comoduleCoeff (H := H) (V := H) χ w = contractFst χ (comul (R := k) w) := rfl
    rw [hcf, ← contractFstQ_lTensor (V := H) I χ (comul (R := k) w)]
    exact contractFstQ_eq_zero_of_mem_range (V := H) I hχ hzW
  exact Ideal.Quotient.eq_zero_iff_mem.1 hcontract

/-- **Takeuchi's Lemma 4.12, main step**: if `E` is a subcomodule of `H`, `I` a Hopf ideal
generated as an ideal by `W = E ⊓ I`, then `I = N(H, W)`. -/
theorem nIdeal_eq_of_isSubcomodule {E : Submodule k H} (hE : Coalgebra.Comodule.IsSubcomodule (C
    := H) E)
    (hI : IsHopfIdeal k I)
    (hgen : Ideal.span ((E ⊓ I.restrictScalars k : Submodule k H) : Set H) = I) :
    NIdeal (V := H) H (E ⊓ I.restrictScalars k) = I := by
  have hcoeff : coeffSet (V := H) H (E ⊓ I.restrictScalars k) ⊆ (I : Set H) :=
    coeffSet_subset_of_isSubcomodule hE hI
  refine le_antisymm ?_ ?_
  · exact nIdeal_le_of_coeff_mem (fun c hc => hcoeff hc)
      (fun c hc => IsHopfIdeal.antipode_mem k hI c (hcoeff hc))
  · intro x hx
    rw [← hgen] at hx
    exact Ideal.span_le.2 (subset_NIdeal (W := E ⊓ I.restrictScalars k)
      (fun w hw => IsHopfIdeal.counit_eq_zero k hI w hw.2)) hx

/-- **Takeuchi's Lemma 4.12** [Takeuchi1972]: every finitely generated Hopf ideal `I` of a
commutative Hopf algebra `H` over a field is Takeuchi's ideal `N(H, W)` of a finite-dimensional
subspace `W ⊆ I` which generates `I` as an ideal and which is contained in a finite-dimensional
subcomodule of `H`. -/
theorem exists_NIdeal_eq (hI : IsHopfIdeal k I) (hfg : I.FG) :
    ∃ E W : Submodule k H, W = E ⊓ I.restrictScalars k ∧ E.FG ∧ W.FG ∧
      Coalgebra.Comodule.IsSubcomodule (C := H) E ∧ Ideal.span (W : Set H) = I ∧
      NIdeal (V := H) H W = I := by
  classical
  obtain ⟨S, hS⟩ := hfg
  obtain ⟨E, hSE, hEfg, hEcl⟩ := Coalgebra.LocallyFinite.exists_fg_translClosed_finset (k := k) S
  have hEsub : Coalgebra.Comodule.IsSubcomodule (C := H) E := by
    intro y hy
    obtain ⟨t, ht⟩ := Coalgebra.LocallyFinite.comul_mem_of_isTranslClosed hEcl hy
    have hfact : ∀ s : ↥E ⊗[k] ↥E,
        LinearMap.rTensor H E.subtype (LinearMap.lTensor ↥E E.subtype s)
          = TensorProduct.map E.subtype E.subtype s := by
      intro s
      induction s with
      | tmul a b => simp
      | add p q hp hq => simp only [map_add, hp, hq]
    exact ⟨LinearMap.lTensor ↥E E.subtype t, by
      simp only [Coalgebra.Comodule.coact_self]; rw [hfact, ht]⟩
  set W : Submodule k H := E ⊓ I.restrictScalars k with hWdef
  have hWgen : Ideal.span (W : Set H) = I := by
    refine le_antisymm (Ideal.span_le.2 (fun x hx => hx.2)) ?_
    have hsub : (S : Set H) ⊆ ((Ideal.span (W : Set H) : Ideal H) : Set H) := by
      intro x hx
      have hxI : x ∈ I := by rw [← hS]; exact Ideal.subset_span hx
      exact Ideal.subset_span ⟨hSE x hx, hxI⟩
    calc I = Ideal.span (S : Set H) := hS.symm
      _ ≤ Ideal.span (W : Set H) := Ideal.span_le.2 hsub
  have hWfg : W.FG := by
    have hE' : Module.Finite k ↥E := Module.Finite.iff_fg.2 hEfg
    have hWfin : Module.Finite k ↥W :=
      Module.Finite.of_injective (Submodule.inclusion (inf_le_left : W ≤ E))
        (Submodule.inclusion_injective _)
    exact Module.Finite.iff_fg.1 hWfin
  exact ⟨E, W, rfl, hEfg, hWfg, hEsub, hWgen, nIdeal_eq_of_isSubcomodule hEsub hI hWgen⟩

/-- **Takeuchi's Lemma 4.12** for a noetherian Hopf algebra — in particular for a finitely
generated commutative Hopf algebra over a field: every Hopf ideal is of the form `N(H, W)`. -/
theorem exists_NIdeal_eq_of_isNoetherianRing [IsNoetherianRing H] (hI : IsHopfIdeal k I) :
    ∃ E W : Submodule k H, W = E ⊓ I.restrictScalars k ∧ E.FG ∧ W.FG ∧
      Coalgebra.Comodule.IsSubcomodule (C := H) E ∧ Ideal.span (W : Set H) = I ∧
      NIdeal (V := H) H W = I :=
  exists_NIdeal_eq hI (IsNoetherian.noetherian I)

end Lemma412

