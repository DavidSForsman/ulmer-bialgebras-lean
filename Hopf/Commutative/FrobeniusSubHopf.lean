module

public import Mathlib.Algebra.CharP.Algebra
public import Mathlib.FieldTheory.Perfect
public import Mathlib.RingTheory.Noetherian.Nilpotent
public import Hopf.Basic.AntipodeAlgHom
public import Hopf.Basic.SubHopfAlgebra

/-!
# The Frobenius sub-Hopf algebra `H^(pʳ)` in characteristic `p`

Let `k` be a perfect field of characteristic `p > 0` and let `H` be a commutative Hopf algebra
over `k`.  The set of `pʳ`-th powers

`H^(pʳ) = {x ^ pʳ | x ∈ H}`

is a `k`-subalgebra of `H` (it is closed under sums because of the freshman's dream, and under
multiplication by scalars because `k` is perfect), and it is a **sub-Hopf algebra**: the
comultiplication and the antipode are algebra maps, so they take `pʳ`-th powers to `pʳ`-th
powers.

This is the sub-Hopf algebra used in the characteristic-`p` half of the proof of Takeuchi's
Theorem 3.1 (M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*,
manuscripta math. **7** (1972), 251–270): for `H` finitely generated it is again finitely
generated, and it is *reduced* as soon as `pʳ` exceeds the nilpotency index of the nilradical
of `H`.

## Main definitions and results

* `HopfAlgebra.Commutative.Frobenius.frobSubalgebra p r`: the subalgebra `H^(pʳ)`;
* `HopfAlgebra.Commutative.Frobenius.isSubHopfAlgebra_frobSubalgebra`: it is a sub-Hopf algebra;
* `HopfAlgebra.Commutative.Frobenius.frobSubalgebra_eq_adjoin`: `H^(pʳ)` is generated by the `pʳ`-th
  powers of any set of algebra generators of `H`, hence
  `HopfAlgebra.Commutative.Frobenius.finiteType_frobSubalgebra`: it is finitely generated when `H`
  is;
* `HopfAlgebra.Commutative.Frobenius.isReduced_frobSubalgebra` and
  `HopfAlgebra.Commutative.Frobenius.exists_isReduced_frobSubalgebra`: over a noetherian `H` the
  subalgebra `H^(pʳ)` is reduced for `r` large.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972], Theorem
  3.1
-/

@[expose] public section

section
open HopfAlgebra
namespace HopfAlgebra.Commutative.Frobenius

open TensorProduct Coalgebra HopfAlgebra.Commutative

/-- A nontrivial algebra over a field of characteristic `p` has characteristic `p`. -/
lemma charP_of_algebra (k A : Type*) [Field k] [CommRing A] [Algebra k A] [Nontrivial A]
    (p : ℕ) [CharP k p] : CharP A p :=
  charP_of_injective_algebraMap (algebraMap k A).injective p

variable (k H : Type*) [Field k] [CommRing H] [HopfAlgebra k H]
  (p : ℕ) [Fact p.Prime] [CharP k p] [PerfectRing k p] [Nontrivial H] (r : ℕ)

/-- Every element of a perfect field of characteristic `p` is a `pʳ`-th power. -/
lemma exists_pow_eq (k : Type*) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] [PerfectRing k p]
    (r : ℕ) (c : k) : ∃ d : k, d ^ (p ^ r) = c :=
  ⟨(frobeniusEquiv k p).symm^[r] c, by simp⟩

/-- The subalgebra `H^(pʳ)` of `pʳ`-th powers of a commutative algebra over a perfect field of
characteristic `p`. -/
def frobSubalgebra : Subalgebra k H where
  carrier := {y | ∃ x : H, x ^ (p ^ r) = y}
  mul_mem' := by
    rintro a b ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x * y, mul_pow x y _⟩
  add_mem' := by
    have := charP_of_algebra k H p
    rintro a b ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x + y, add_pow_char_pow x y p r⟩
  algebraMap_mem' := by
    intro c
    obtain ⟨d, rfl⟩ := exists_pow_eq k p r c
    exact ⟨algebraMap k H d, by rw [← map_pow]⟩

/-- Every `p ^ r`-th power `x ^ (p ^ r)` lies in `frobSubalgebra k H p r`. -/
lemma pow_mem_frobSubalgebra (x : H) : x ^ (p ^ r) ∈ frobSubalgebra k H p r := ⟨x, rfl⟩

/-! ### `H^(pʳ)` is finitely generated when `H` is -/

/-- The preimage of a subalgebra under the `pʳ`-th power map is a subalgebra. -/
def frobComap (T : Subalgebra k H) : Subalgebra k H where
  carrier := {x : H | x ^ (p ^ r) ∈ T}
  mul_mem' := by
    intro a b ha hb
    simpa [mul_pow] using T.mul_mem ha hb
  add_mem' := by
    have := charP_of_algebra k H p
    intro a b ha hb
    simpa [add_pow_char_pow a b p r] using T.add_mem ha hb
  algebraMap_mem' := by
    intro c
    change (algebraMap k H c) ^ (p ^ r) ∈ T
    rw [← map_pow]
    exact T.algebraMap_mem _

/-- `H^(pʳ)` is generated as a `k`-algebra by the `pʳ`-th powers of any set of generators
of `H`. -/
theorem frobSubalgebra_eq_adjoin {S : Set H} (hS : Algebra.adjoin k S = ⊤) :
    frobSubalgebra k H p r = Algebra.adjoin k ((· ^ (p ^ r)) '' S) := by
  refine le_antisymm ?_ ?_
  · set T : Subalgebra k H := Algebra.adjoin k ((· ^ (p ^ r)) '' S) with hT
    have hsub : (⊤ : Subalgebra k H) ≤ frobComap k H p r T := by
      rw [← hS]
      refine Algebra.adjoin_le ?_
      intro x hx
      exact Algebra.subset_adjoin ⟨x, hx, rfl⟩
    rintro y ⟨x, rfl⟩
    exact hsub (Algebra.mem_top (R := k) (x := x))
  · refine Algebra.adjoin_le ?_
    rintro y ⟨x, -, rfl⟩
    exact pow_mem_frobSubalgebra k H p r x

/-- `H^(pʳ)` is a finitely generated `k`-algebra when `H` is. -/
theorem finiteType_frobSubalgebra [Algebra.FiniteType k H] :
    Algebra.FiniteType k (frobSubalgebra k H p r) := by
  classical
  obtain ⟨S, hS⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra k H).FG)
  rw [← Subalgebra.fg_iff_finiteType, frobSubalgebra_eq_adjoin k H p r hS]
  exact ⟨S.image (· ^ (p ^ r)), by rw [Finset.coe_image]⟩

/-! ### `H^(pʳ)` is reduced for large `r` -/

/-- If every nilpotent element of `H` is killed by the exponent `m ≤ pʳ`, then `H^(pʳ)` is
reduced. -/
theorem isReduced_frobSubalgebra {m : ℕ} (hm : m ≤ p ^ r)
    (hnil : ∀ x : H, IsNilpotent x → x ^ m = 0) :
    IsReduced (frobSubalgebra k H p r) := by
  constructor
  rintro ⟨y, hy⟩ ⟨n, hn⟩
  obtain ⟨x, rfl⟩ := hy
  have hzero : ((x ^ (p ^ r)) ^ n : H) = 0 := by
    have := congrArg (Subtype.val) hn
    simpa using this
  have hx : IsNilpotent x := ⟨p ^ r * n, by rw [pow_mul]; exact hzero⟩
  have hxm : x ^ m = 0 := hnil x hx
  have hxp : (x : H) ^ (p ^ r) = 0 := by
    obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le hm
    rw [hd, pow_add, hxm, zero_mul]
  exact Subtype.ext (by simpa using hxp)

/-- Over a noetherian `H`, the subalgebra `H^(pʳ)` is reduced for `r` large enough. -/
theorem exists_isReduced_frobSubalgebra [IsNoetherianRing H] :
    ∃ r : ℕ, IsReduced (frobSubalgebra k H p r) := by
  obtain ⟨m, hm⟩ := IsNoetherianRing.isNilpotent_nilradical H
  obtain ⟨r, hr⟩ : ∃ r : ℕ, m ≤ p ^ r :=
    ⟨m, le_of_lt (Nat.lt_pow_self (Fact.out : p.Prime).one_lt)⟩
  refine ⟨r, isReduced_frobSubalgebra k H p r hr ?_⟩
  intro x hx
  have hxmem : x ∈ nilradical H := hx
  have hpow : x ^ m ∈ (nilradical H) ^ m := Ideal.pow_mem_pow hxmem m
  rw [hm] at hpow
  simpa using hpow

/-! ### `H^(pʳ)` is a sub-Hopf algebra -/

/-- The `pʳ`-th power map commutes with the comultiplication, in the strong sense that the
comultiplication of a `pʳ`-th power lies in `H^(pʳ) ⊗ H^(pʳ)`. -/
theorem comul_pow_mem (x : H) :
    comul (R := k) (x ^ (p ^ r)) ∈
      LinearMap.range (TensorProduct.map
        (frobSubalgebra k H p r).toSubmodule.subtype
        (frobSubalgebra k H p r).toSubmodule.subtype) := by
  classical
  have : CharP (H ⊗[k] H) p :=
    charP_of_injective_algebraMap (algebraMap k (H ⊗[k] H)).injective p
  obtain ⟨s, hs⟩ := TensorProduct.exists_finset (comul (R := k) x)
  have hcomul : comul (R := k) (x ^ (p ^ r)) = (comul (R := k) x) ^ (p ^ r) := by simp
  have hsum : (comul (R := k) x) ^ (p ^ r)
      = ∑ i ∈ s, (i.1 ^ (p ^ r)) ⊗ₜ[k] (i.2 ^ (p ^ r)) := by
    rw [hs, sum_pow_char_pow p r]
    exact Finset.sum_congr rfl fun i _ => Algebra.TensorProduct.tmul_pow i.1 i.2 _
  refine ⟨∑ i ∈ s, (⟨i.1 ^ (p ^ r), pow_mem_frobSubalgebra k H p r i.1⟩ :
      (frobSubalgebra k H p r).toSubmodule) ⊗ₜ[k]
      (⟨i.2 ^ (p ^ r), pow_mem_frobSubalgebra k H p r i.2⟩ :
      (frobSubalgebra k H p r).toSubmodule), ?_⟩
  rw [map_sum, hcomul, hsum]
  exact Finset.sum_congr rfl fun i _ => rfl

/-- **The `pʳ`-th powers form a sub-Hopf algebra.** -/
instance isSubHopfAlgebra_frobSubalgebra :
    IsSubHopfAlgebra k (frobSubalgebra k H p r) where
  comul_mem := by
    rintro y ⟨x, rfl⟩
    exact comul_pow_mem k H p r x
  antipode_mem := by
    rintro y ⟨x, rfl⟩
    refine ⟨antipode k x, ?_⟩
    have := map_pow (HopfAlgebra.antipodeAlgHom k H) x (p ^ r)
    simpa using this.symm

end HopfAlgebra.Commutative.Frobenius
end
