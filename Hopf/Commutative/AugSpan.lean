/-!
# Augmentation ideals and Takeuchi surjectivity

Relations between augmentation ideals and coinvariants, and the surjectivity condition used in
Takeuchi's correspondence.

## Main results

* `HopfAlgebra.Commutative.augIdealB_eq_augIdeal`: for a sub-Hopf algebra `K`, the two descriptions
  `HopfAlgebra.augIdealB k K H` and `augIdeal K` of `K⁺H` agree.
* `HopfAlgebra.Commutative.augIdeal_coinv_le`: `K(I)⁺H ≤ I` for an ideal `I` (Takeuchi's Lemma 4.7).
* `HopfAlgebra.Commutative.NormalHopfIdealEqAugSpan`: the proposition that every normal Hopf ideal
  `I` of `H` satisfies `I = K(I)⁺H` (the surjectivity half of Takeuchi's Theorem 4.3).

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Lemmas 4.2, 4.4, 4.7, 4.8–4.15, Corollary 3.10 and Theorem 4.3
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

section
open HopfAlgebra HopfAlgebra.Commutative
namespace HopfAlgebra.Commutative

universe u

variable {k H : Type u} [CommRing k] [IsAbsFlat k] [CommRing H] [HopfAlgebra k H]

/-! ### `K⁺H` computed inside the Hopf algebra `K` -/

variable (K : Subalgebra k H) [IsSubHopfAlgebra k K]

/-- The ideal `K⁺H` of `H` is the ideal generated by the augmentation ideal of the Hopf algebra
`K` — the two descriptions of `K⁺H` agree. -/
lemma augIdealB_eq_augIdeal : HopfAlgebra.augIdealB k (↥K) H = augIdeal K := by
  have himg : (algebraMap (↥K) H) '' (augmentationIdeal k (↥K)) = augSet K := by
    ext x
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact ⟨u.2, hu⟩
    · rintro ⟨hxK, hxe⟩
      exact ⟨⟨x, hxK⟩, hxe, rfl⟩
  change Ideal.span _ = Ideal.span _
  rw [himg]

/-! ### Theorem 4.3 -/

omit [IsAbsFlat k] in
/-- `K(I)⁺H ⊆ I`: the easy half of the surjectivity statement (Takeuchi's Lemma 4.7). -/
theorem augIdeal_coinv_le (I : Ideal H) : augIdeal (coinvOfIdeal (k := k) I) ≤ I := by
  rw [augIdeal, Ideal.span_le]
  exact fun x hx => coinv_augmentation_le I hx.1 hx.2

variable (k H) in
/-- The **surjectivity** half of Takeuchi's Theorem 4.3 ([Takeuchi1972]): every normal Hopf ideal
`I` of a commutative Hopf algebra `H` over a field is generated by the augmentation ideal of the
sub-Hopf algebra `K(I)` of its coinvariants.

This is proved in §4 of Takeuchi's paper (Lemmas 4.8–4.15) by means of the theory of relative
Hopf modules, which is not available in Mathlib; it is therefore carried here as an explicit
hypothesis rather than assumed as an axiom.  It is proved for every field as
`HopfAlgebra.Commutative.normalHopfIdealEqAugSpan_holds` in
`Hopf/Commutative/AugSpanUnconditional.lean`. -/
def NormalHopfIdealEqAugSpan : Prop :=
  ∀ I : Ideal H, IsNormalHopfIdeal k I → I = augIdeal (coinvOfIdeal (k := k) I)

