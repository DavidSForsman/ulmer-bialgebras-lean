/-!
# Density of the points: Takeuchi's Lemmas 3.5 and 3.6

This file proves the last unproved input of Takeuchi's Proposition 3.7, namely the *density
hypothesis* `HopfAlgebra.Commutative.DensePointTranslates` of
`Hopf/Commutative/FlatOfDensePoints.lean`:

> Let `k` be an algebraically closed field, `H` and `K` commutative Hopf `k`-algebras which are
> finitely generated as algebras, with `K` reduced, and let `φ : K →ₐc[k] H` be an injective
> morphism of Hopf algebras.  Then for every `g ≠ 0` in `K` the translates
> `u ⇀ g = ∑ u (φ g₍₂₎) g₍₁₎`, `u` ranging over the `k`-points of `H`, generate the unit ideal
> of `K`.

The proof is the one of Takeuchi's Lemmas 3.5 and 3.6, organised so that only the weak
Nullstellensatz is needed:

* if the ideal generated by the translates were proper, it would be contained in a maximal ideal of
  `K`, which — `K` being a finitely generated algebra over an algebraically closed field — is the
  kernel of a `k`-point `v : K →ₐ[k] k`
  (`HopfAlgebra.Commutative.exists_algHom_ker_eq_of_isMaximal`);
* `v (u ⇀ g) = (v ⋆ (u ∘ φ)) (g) = (u ∘ φ) (v ⇁ g)`, where `v ⇁ g = ∑ v (g₍₁₎) g₍₂₎` is the
  *left* translate of `g` by `v` (`Coalgebra.translLeft`), an invertible operator because
  `v ∘ S` is a convolution inverse of `v`;
* so the nonzero element `φ (v ⇁ g)` of `H` — nonzero because `K` is reduced and `φ` injective —
  would be killed by every `k`-point of `H`, contradicting the fact that a finitely generated
  algebra over an algebraically closed field has enough points to detect non-nilpotent elements
  (`HopfAlgebra.Commutative.isNilpotent_of_forall_algHom_eq_zero`).

## Main results

* `HopfAlgebra.Commutative.exists_algHom_ker_eq_of_isMaximal`: the weak Nullstellensatz — every
  maximal ideal of a finitely generated algebra over an algebraically closed field is the kernel of
  a `k`-point;
* `HopfAlgebra.Commutative.isNilpotent_of_forall_algHom_eq_zero`: an element killed by all
  `k`-points is nilpotent;
* `Coalgebra.apply_translLeft`, `Coalgebra.translLeft_bijective`: properties of
  the left translation `Coalgebra.translLeft` (`Hopf/Basic/ComoduleTransl.lean`);
* `HopfAlgebra.Commutative.densePointTranslates`: **Takeuchi's Lemmas 3.5 and 3.6**, the density
  hypothesis;
* `HopfAlgebra.Commutative.faithfullyFlat_of_isReduced`: **Takeuchi's Proposition 3.7**, now
  unconditional: a commutative Hopf algebra is faithfully flat over a reduced Hopf subalgebra, both
  being finitely generated over an algebraically closed field.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972], Lemmas
  3.5, 3.6 and Proposition 3.7
-/

@[expose] public section

namespace HopfAlgebra.Commutative
open Coalgebra Coalgebra.Comodule HopfAlgebra.Commutative

open TensorProduct _root_.Coalgebra

/-! ## The weak Nullstellensatz -/

section Nullstellensatz

variable {k A : Type*} [Field k] [IsAlgClosed k] [CommRing A] [Algebra k A]
  [Algebra.FiniteType k A]

/-- **Weak Nullstellensatz.**  Every maximal ideal of a finitely generated algebra over an
algebraically closed field is the kernel of a `k`-point. -/
theorem exists_algHom_ker_eq_of_isMaximal (m : Ideal A) [m.IsMaximal] :
    ∃ v : A →ₐ[k] k, ∀ x, v x = 0 ↔ x ∈ m := by
  have : Algebra.FiniteType k (A ⧸ m) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k m) Ideal.Quotient.mk_surjective
  have : Module.Finite k (A ⧸ m) :=
    @finite_of_finite_type_of_isJacobsonRing k (A ⧸ m) _ (Ideal.Quotient.field m) _ _ _
  have : Algebra.IsIntegral k (A ⧸ m) := Algebra.IsIntegral.of_finite k _
  have : IsDomain (A ⧸ m) := Ideal.Quotient.isDomain m
  have hbij : Function.Bijective (algebraMap k (A ⧸ m)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : k ≃ₐ[k] (A ⧸ m) := AlgEquiv.ofBijective (Algebra.ofId k (A ⧸ m)) hbij
  refine ⟨(e.symm : (A ⧸ m) →ₐ[k] k).comp (Ideal.Quotient.mkₐ k m), fun x => ?_⟩
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
  constructor
  · intro h
    have hz : (Ideal.Quotient.mk m) x = 0 := by
      simpa using congr(e $h)
    exact (Ideal.Quotient.eq_zero_iff_mem).1 hz
  · intro h
    rw [(Ideal.Quotient.eq_zero_iff_mem).2 h]
    simp

/-- A finitely generated algebra over an algebraically closed field has enough `k`-points: an
element annihilated by all of them is nilpotent. -/
theorem isNilpotent_of_forall_algHom_eq_zero {a : A} (ha : ∀ v : A →ₐ[k] k, v a = 0) :
    IsNilpotent a := by
  have : IsJacobsonRing A := isJacobsonRing_of_finiteType (A := k)
  have h1 : a ∈ (⊥ : Ideal A).jacobson := by
    rw [Ideal.jacobson]
    refine Submodule.mem_sInf.2 ?_
    rintro J ⟨-, hJ⟩
    have := hJ
    obtain ⟨v, hv⟩ := exists_algHom_ker_eq_of_isMaximal (k := k) J
    exact (hv a).1 (ha v)
  have h2 : a ∈ (⊥ : Ideal A).radical := by rwa [Ideal.radical_eq_jacobson]
  exact (Ideal.mem_radical_iff.1 h2).imp fun n hn => by simpa using hn

/-- If a proper ideal is given, there is a `k`-point vanishing on it. -/
theorem exists_algHom_eq_zero_of_ne_top {I : Ideal A} (hI : I ≠ ⊤) :
    ∃ v : A →ₐ[k] k, ∀ x ∈ I, v x = 0 := by
  obtain ⟨m, hm, hIm⟩ := Ideal.exists_le_maximal I hI
  have := hm
  obtain ⟨v, hv⟩ := exists_algHom_ker_eq_of_isMaximal (k := k) m
  exact ⟨v, fun x hx => (hv x).2 (hIm hx)⟩

end Nullstellensatz

/-! ## Left translation of a coalgebra by a functional -/

namespace Coalgebra

section TranslLeft

variable {R C : Type*} [CommSemiring R] [AddCommMonoid C] [Module R C] [Coalgebra R C]

/-- Applying a functional to a left translate gives the convolution product. -/
lemma _root_.Coalgebra.apply_translLeft (v w : C →ₗ[R] R) (c : C) :
    w (translLeft v c) = Coalgebra.Comodule.convFun v w c := by
  classical
  set r := Coalgebra.Repr.arbitrary R c with hr
  rw [translLeft_apply v r, Coalgebra.Comodule.convFun_apply v w r, map_sum]
  exact Finset.sum_congr rfl fun i _ => by simp

/-- Applying a functional to a right translate gives the convolution product in the other
order. -/
lemma _root_.Coalgebra.apply_transl (v w : C →ₗ[R] R) (c : C) :
    v (Coalgebra.Comodule.transl w c) = Coalgebra.Comodule.convFun v w c := by
  classical
  set r := Coalgebra.Repr.arbitrary R c with hr
  rw [Coalgebra.Comodule.transl_apply w r.toComodule, Coalgebra.Comodule.convFun_apply v w r,
      map_sum]
  exact Finset.sum_congr rfl fun i _ => by simp [Coalgebra.Repr.toComodule, mul_comm]

/-- Left translation by a convolution-invertible functional is bijective. -/
lemma _root_.Coalgebra.translLeft_bijective {v u : C →ₗ[R] R}
    (h1 : Coalgebra.Comodule.convFun v u = (counit : C →ₗ[R] R))
    (h2 : Coalgebra.Comodule.convFun u v = (counit : C →ₗ[R] R)) :
    Function.Bijective (translLeft u : C →ₗ[R] C) := by
  have hid : ∀ w : C →ₗ[R] R, w = (counit : C →ₗ[R] R) → ∀ c : C, translLeft w c = c := by
    rintro w rfl c
    rw [translLeft_counit (C := C), LinearMap.id_apply]
  constructor
  · intro x y hxy
    have hx : translLeft v (translLeft u x) = x := by
      rw [translLeft_translLeft]; exact hid _ h2 x
    have hy : translLeft v (translLeft u y) = y := by
      rw [translLeft_translLeft]; exact hid _ h2 y
    rw [← hx, ← hy, hxy]
  · intro y
    refine ⟨translLeft v y, ?_⟩
    rw [translLeft_translLeft]
    exact hid _ h1 y

end TranslLeft

end Coalgebra

/-! ## The density of the points -/

section

open Coalgebra.Comodule

universe u

section Density

variable {k K H : Type u} [Field k] [CommRing K] [CommRing H] [HopfAlgebra k K] [HopfAlgebra k H]
  (φ : K →ₐc[k] H)

/-- Left translation of a Hopf algebra by a `k`-point is bijective, the convolution inverse of a
point being its composition with the antipode. -/
lemma translLeft_point_bijective (v : K →ₐ[k] k) :
    Function.Bijective (Coalgebra.translLeft (v.toLinearMap) : K →ₗ[k] K) :=
  Coalgebra.translLeft_bijective (convFun_comp_antipode_left v) (convFun_comp_antipode_right v)

/-- The value of a point on a right translate is the value of the translating point on the
left translate: `v (u ⇀ g) = (u ∘ φ) (v ⇁ g)`. -/
lemma point_pointAut_eq (u : H →ₐ[k] k) (v : K →ₐ[k] k) (g : K) :
    v (pointAut φ u g)
      = (u.comp (φ : K →ₐ[k] H)) (Coalgebra.translLeft (v.toLinearMap) g) := by
  have h1 : v.toLinearMap (Coalgebra.Comodule.transl (u.comp (φ : K →ₐ[k] H)).toLinearMap g)
      = Coalgebra.Comodule.convFun v.toLinearMap (u.comp (φ : K →ₐ[k] H)).toLinearMap g :=
    Coalgebra.apply_transl _ _ g
  have h2 : (u.comp (φ : K →ₐ[k] H)).toLinearMap (Coalgebra.translLeft v.toLinearMap g)
      = Coalgebra.Comodule.convFun v.toLinearMap (u.comp (φ : K →ₐ[k] H)).toLinearMap g :=
    Coalgebra.apply_translLeft _ _ g
  rw [pointAut_apply, translAlgHom_apply]
  exact h1.trans h2.symm

end Density

section Main

variable {k K H : Type u} [Field k] [IsAlgClosed k] [CommRing K] [CommRing H]
  [HopfAlgebra k K] [HopfAlgebra k H] [Algebra.FiniteType k K] [Algebra.FiniteType k H]
  [IsReduced K] (φ : K →ₐc[k] H)

/-- **Takeuchi's Lemmas 3.5 and 3.6.**  For an injective morphism `φ : K →ₐc[k] H` of finitely
generated commutative Hopf algebras over an algebraically closed field, with `K` reduced, the
translates of a nonzero element of `K` by the `k`-points of `H` generate the unit ideal of `K`. -/
theorem densePointTranslates (hφ : Function.Injective φ) : DensePointTranslates φ := by
  intro g hg
  by_contra hne
  obtain ⟨v, hv⟩ := exists_algHom_eq_zero_of_ne_top (k := k) hne
  -- every point of `H` kills the left translate of `g` by `v`
  set g' : K := Coalgebra.translLeft (v.toLinearMap) g with hg'
  have hzero : ∀ u : H →ₐ[k] k, u (φ g') = 0 := by
    intro u
    have hmem : pointAut φ u g ∈
        Ideal.span (Set.range fun u : H →ₐ[k] k => pointAut φ u g) :=
      Ideal.subset_span ⟨u, rfl⟩
    have := hv _ hmem
    rwa [point_pointAut_eq φ u v g, AlgHom.comp_apply] at this
  -- but `φ g'` is nonzero, hence not nilpotent, hence detected by some point
  have hg'ne : g' ≠ 0 := fun h => hg ((translLeft_point_bijective v).1 (by simpa [hg'] using h))
  have hφg' : φ g' ≠ 0 := fun h => hg'ne (hφ (by simpa using h))
  have hnil : IsNilpotent (φ g') := isNilpotent_of_forall_algHom_eq_zero (k := k) hzero
  obtain ⟨n, hn⟩ := hnil
  have : g' ^ n = 0 := hφ (by simpa using hn)
  exact hφg' (by simp [IsNilpotent.eq_zero ⟨n, this⟩])

variable [IsNoetherianRing K] [Nontrivial K]

/-- **Takeuchi's Proposition 3.7**, unconditionally: a finitely generated commutative Hopf algebra
`H` over an algebraically closed field is faithfully flat over a reduced finitely generated Hopf
subalgebra `K`. -/
theorem faithfullyFlat_of_isReduced [Algebra K H] [IsScalarTower k K H]
    (hφ : ∀ x : K, φ x = algebraMap K H x)
    (hinj : Function.Injective (algebraMap K H)) :
    Module.FaithfullyFlat K H :=
  faithfullyFlat_of_isReduced_of_densePointTranslates φ
    (densePointTranslates φ (fun a b h => hinj (by rw [← hφ a, ← hφ b]; exact h))) hφ hinj

end Main

end

end HopfAlgebra.Commutative
