module

public import Hopf.Commutative.NIdeal

/-!
# Takeuchi's ideal `N(V, W)` for a line `W = k v`

Let `H` be a commutative Hopf algebra over a field `k` and let `V` be a right `H`-comodule.  This
file computes Takeuchi's ideal `N(V, W)` of `Hopf/Commutative/NIdeal.lean` in the case
of a *line* `W = k v`, and connects it with the criterion
`HopfAlgebra.Commutative.eq_augIdeal_coinv_of_coeff_span` of
`Hopf/Commutative/ComoduleCoeff.lean`, which is the shape in which Takeuchi concludes the
surjectivity half of his Theorem 4.3.

## Main results

* `HopfAlgebra.Commutative.coeffSet_span_singleton`: the coefficients of the line `k v` are exactly
  the coefficients `∑ ⟨χ, v₍₀₎⟩ v₍₁₎` of `v` itself against the functionals `χ` with `⟨χ, v⟩ = 0`;
* `HopfAlgebra.Commutative.nIdeal_span_singleton`: hence `N(V, k v)` is the ideal generated by those
  coefficients and their antipodes;
* `HopfAlgebra.Commutative.eq_augIdeal_coinv_of_NIdeal_le`: **the criterion of Takeuchi's Lemma 4.15
  in terms of `N(V, W)`** — a normal Hopf ideal `I` contained in `N(V, k v)`, for a vector `v` which
  is coinvariant modulo `I`, satisfies `I = K(I)⁺H`.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Definition 4.9, Lemma 4.15 and Theorem 4.3
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

section
open Coalgebra HopfAlgebra HopfAlgebra.Commutative
namespace HopfAlgebra.Commutative

open Coalgebra.Comodule

universe u

variable {k H : Type u} [Field k] [CommRing H] [HopfAlgebra k H]
variable {V : Type u} [AddCommGroup V] [Module k V] [RightComodule k H V]

/-- The coefficient map is linear in the functional. -/
lemma comoduleCoeff_smul (a : k) (χ : V →ₗ[k] k) (v : V) :
    comoduleCoeff (H := H) (a • χ) v = a • comoduleCoeff (H := H) χ v := by
  rw [comoduleCoeff, comoduleCoeff]
  generalize coact (R := k) (C := H) v = z
  induction z with
  | tmul u h => simp [mul_smul]
  | add p q hp hq => rw [map_add, map_add, hp, hq, smul_add]

/-- A functional vanishes on the line `k v` exactly when it vanishes on `v`. -/
lemma forall_mem_span_singleton_eq_zero_iff (χ : V →ₗ[k] k) (v : V) :
    (∀ u ∈ (k ∙ v : Submodule k V), χ u = 0) ↔ χ v = 0 := by
  refine ⟨fun h => h v (Submodule.mem_span_singleton_self v), fun h u hu => ?_⟩
  obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.1 hu
  rw [map_smul, h, smul_zero]

variable (H) in
/-- **The coefficients of a line.**  The set `ρ(W^⊥ ⊗ W)` for `W = k v` consists exactly of the
coefficients of `v` against the functionals annihilating `v`. -/
theorem coeffSet_span_singleton (v : V) :
    coeffSet H (k ∙ v : Submodule k V)
      = {c : H | ∃ χ : V →ₗ[k] k, χ v = 0 ∧ c = comoduleCoeff χ v} := by
  ext c
  constructor
  · rintro ⟨χ, hχ, w, hw, rfl⟩
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.1 hw
    refine ⟨a • χ, ?_, ?_⟩
    · rw [LinearMap.smul_apply, (forall_mem_span_singleton_eq_zero_iff χ v).1 hχ, smul_zero]
    · rw [comoduleCoeff_smul]
      rw [comoduleCoeff, comoduleCoeff, map_smul, map_smul]
  · rintro ⟨χ, hχ, rfl⟩
    exact ⟨χ, (forall_mem_span_singleton_eq_zero_iff χ v).2 hχ, v,
      Submodule.mem_span_singleton_self v, rfl⟩

variable (H) in
/-- **Takeuchi's ideal of a line.**  `N(V, k v)` is generated by the coefficients of `v` against
the functionals annihilating `v`, together with their antipodes; this is exactly the ideal
appearing in the criterion `HopfAlgebra.Commutative.eq_augIdeal_coinv_of_coeff_span`. -/
theorem nIdeal_span_singleton (v : V) :
    NIdeal H (k ∙ v : Submodule k V)
      = Ideal.span {c : H | ∃ χ : V →ₗ[k] k, χ v = 0 ∧
          (c = comoduleCoeff χ v ∨ c = antipode k (comoduleCoeff χ v))} := by
  unfold NIdeal
  congr 1
  rw [coeffSet_span_singleton]
  ext c
  constructor
  · rintro (⟨χ, hχ, rfl⟩ | ⟨d, ⟨χ, hχ, rfl⟩, rfl⟩)
    · exact ⟨χ, hχ, Or.inl rfl⟩
    · exact ⟨χ, hχ, Or.inr rfl⟩
  · rintro ⟨χ, hχ, rfl | rfl⟩
    · exact Or.inl ⟨χ, hχ, rfl⟩
    · exact Or.inr ⟨comoduleCoeff χ v, ⟨χ, hχ, rfl⟩, rfl⟩

/-- **The criterion of Takeuchi's Lemma 4.15, in terms of `N(V, W)`.**  If a normal Hopf ideal `I`
of `H` is contained in Takeuchi's ideal `N(V, k v)` of a line spanned by a vector `v` which is
coinvariant modulo `I`, then `I = K(I)⁺H`: the conclusion of the surjectivity half of Takeuchi's
Theorem 4.3 holds for `I`. -/
theorem eq_augIdeal_coinv_of_NIdeal_le {I : Ideal H} (hI : IsNormalHopfIdeal k I) {v : V}
    (hv : IsCoinvMod k I v) (hle : I ≤ NIdeal H (k ∙ v : Submodule k V)) :
    I = augIdeal (coinvOfIdeal (k := k) I) :=
  eq_augIdeal_coinv_of_coeff_span hI hv (by rwa [nIdeal_span_singleton] at hle)

end HopfAlgebra.Commutative
end
