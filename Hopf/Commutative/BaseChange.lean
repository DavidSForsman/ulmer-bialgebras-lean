module

public import Mathlib.RingTheory.HopfAlgebra.TensorProduct
public import Foundations.RingTheory.AbsFlatClass
public import Hopf.Basic.NormalHopfIdeal

/-!
# Base change of Hopf algebras along a field extension

Let `k ⊆ L` be a field extension and let `H` be a commutative Hopf algebra over `k`.  Then
`L ⊗[k] H` is a commutative Hopf algebra over `L`, and the canonical `k`-algebra map
`ι : H → L ⊗[k] H` is compatible with all the structure maps.

The bulk of the file works with an *abstract* extension: a commutative `L`-Hopf algebra `H'`
together with a `k`-algebra map `ι : H →ₐ[k] H'` which is compatible with the counit, the
antipode and the comultiplication.  The main result is that the ideal `ι(I)H'` generated by a
(normal) Hopf ideal `I` of `H` is again a (normal) Hopf ideal; this is the first half of
Takeuchi's Lemma 4.6.

## Main results

* `HopfAlgebra.Commutative.HopfExt.isHopfIdeal_extIdeal`: for `ι : H →ₐ[k] H'` compatible with the
  structure maps, the ideal of `H'` generated by `ι(I)` is a Hopf ideal when `I` is one
  (first half of Takeuchi's Lemma 4.6).
* `HopfAlgebra.Commutative.HopfExt.isNormalHopfIdeal_extIdeal`: the same for normal Hopf ideals.
* `HopfAlgebra.Commutative.BaseChange.incl`: the canonical `k`-algebra map `H → L ⊗[k] H`.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Lemma 4.6
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

section
open HopfAlgebra
section

universe u

/-! ## An abstract extension of the base field -/

namespace HopfAlgebra.Commutative.HopfExt

variable {k L H H' : Type u} [CommRing k] [Field L] [Algebra k L]
  [CommRing H] [HopfAlgebra k H] [CommRing H'] [HopfAlgebra L H']
  [Algebra k H'] [IsScalarTower k L H']

variable (ι : H →ₐ[k] H')

/-- The `k`-algebra map `H ⊗[k] H → H' ⊗[L] H'`, `x ⊗ y ↦ ι x ⊗ ι y`. -/
noncomputable def extTensor : H ⊗[k] H →ₐ[k] H' ⊗[L] H' :=
  Algebra.TensorProduct.lift
    (((Algebra.TensorProduct.includeLeft :
        H' →ₐ[L] H' ⊗[L] H').restrictScalars k).comp ι)
    (((Algebra.TensorProduct.includeRight :
        H' →ₐ[L] H' ⊗[L] H').restrictScalars k).comp ι)
    (fun _ _ => by exact Commute.all (S := H' ⊗[L] H') _ _)

/-- `extTensor (x ⊗ y) = ι x ⊗ ι y`. -/
@[simp] lemma extTensor_tmul (x y : H) :
    extTensor ι (x ⊗ₜ[k] y) = (ι x) ⊗ₜ[L] (ι y) := by
  simp [extTensor, Algebra.TensorProduct.tmul_mul_tmul]

variable (hcomul : ∀ x : H, comul (R := L) (ι x) = extTensor ι (comul (R := k) x))
variable (hantipode : ∀ x : H, antipode L (ι x) = ι (antipode k x))
variable (hcounit : ∀ x : H, counit (R := L) (ι x) = algebraMap k L (counit (R := k) x))

include hcomul in
/-- A Sweedler representation of `x` gives one of `ι x`. -/
noncomputable def extRepr {x : H} {J : Type*} (r : Coalgebra.Repr k x J) :
    Coalgebra.Repr L (ι x) J where
  index := r.index
  left i := ι (r.left i)
  right i := ι (r.right i)
  eq := by
    rw [hcomul, ← r.eq, map_sum]
    exact Finset.sum_congr rfl fun i _ => by simp

include hcomul hantipode in
/-- The adjoint coaction is compatible with the extension. -/
lemma adAlgHom_ext (x : H) :
    adAlgHom L H' (ι x) = extTensor ι (adAlgHom k H x) := by
  classical
  obtain ⟨r⟩ : Nonempty (Coalgebra.Repr k x (H × H)) := ⟨Coalgebra.Repr.arbitrary k x⟩
  have r2 : ∀ i, Coalgebra.Repr k (r.right i) (H × H) := fun i => Coalgebra.Repr.arbitrary k _
  rw [adAlgHom_apply (k := L) (H := H') _ (extRepr ι hcomul r)
      (fun i => extRepr ι hcomul (r2 i)),
    adAlgHom_apply x r r2, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  change (ι (r.left i) * antipode L (ι ((r2 i).right j))) ⊗ₜ[L] (ι ((r2 i).left j)) = _
  rw [hantipode, extTensor_tmul, map_mul]

/-! ### The extended ideal -/

variable (I : Ideal H)

/-- The ideal of `H'` generated by the image of an ideal `I` of `H`. -/
noncomputable def extIdeal : Ideal H' := Ideal.map ι I

/-- For `y ∈ I`, `ι y` lies in the extended ideal `extIdeal ι I`. -/
lemma mem_extIdeal {y : H} (hy : y ∈ I) : ι y ∈ extIdeal ι I := Ideal.mem_map_of_mem _ hy

/-- `extIdeal ι I ≤ J` as soon as `ι` maps `I` into `J`. -/
lemma extIdeal_le {J : Ideal H'} (h : ∀ y ∈ I, ι y ∈ J) : extIdeal ι I ≤ J :=
  Ideal.map_le_iff_le_comap.2 h

/-- The induced `k`-algebra map `H ⧸ I → H' ⧸ ι(I)H'`. -/
noncomputable def extQuotMap : (H ⧸ I) →ₐ[k] (H' ⧸ extIdeal ι I) :=
  Ideal.Quotient.liftₐ I
    ((Ideal.Quotient.mkₐ k (extIdeal ι I)).comp ι) <| fun _ hy =>
      Ideal.Quotient.eq_zero_iff_mem.2 (mem_extIdeal ι I hy)
/-- `extQuotMap [y] = [ι y]`. -/
@[simp] lemma extQuotMap_mk (y : H) :
    extQuotMap ι I (Ideal.Quotient.mk I y) = Ideal.Quotient.mk (extIdeal ι I) (ι y) := rfl

/-- The `k`-algebra map `(H/I) ⊗[k] (H/I) → (H'/I') ⊗[L] (H'/I')`. -/
noncomputable def extQuotTensor :
    (H ⧸ I) ⊗[k] (H ⧸ I) →ₐ[k] (H' ⧸ extIdeal ι I) ⊗[L] (H' ⧸ extIdeal ι I) :=
  Algebra.TensorProduct.lift
    (((Algebra.TensorProduct.includeLeft :
        (H' ⧸ extIdeal ι I) →ₐ[L]
          (H' ⧸ extIdeal ι I) ⊗[L] (H' ⧸ extIdeal ι I)).restrictScalars k).comp (extQuotMap ι I))
    (((Algebra.TensorProduct.includeRight :
        (H' ⧸ extIdeal ι I) →ₐ[L]
          (H' ⧸ extIdeal ι I) ⊗[L] (H' ⧸ extIdeal ι I)).restrictScalars k).comp (extQuotMap ι I))
    (fun _ _ => by
      exact Commute.all (S := (H' ⧸ extIdeal ι I) ⊗[L] (H' ⧸ extIdeal ι I)) _ _)

/-- `extQuotTensor (a ⊗ b) = extQuotMap a ⊗ extQuotMap b`. -/
@[simp] lemma extQuotTensor_tmul (a b : H ⧸ I) :
    extQuotTensor ι I (a ⊗ₜ[k] b) = (extQuotMap ι I a) ⊗ₜ[L] (extQuotMap ι I b) := by
  simp [extQuotTensor, Algebra.TensorProduct.tmul_mul_tmul]

/-- `(π' ⊗ π') ∘ extTensor = extQuotTensor ∘ (π ⊗ π)`, for the quotient maps `π : H → H/I` and
`π' : H' → H'/ι(I)H'`. -/
lemma map_mk_extTensor (z : H ⊗[k] H) :
    Algebra.TensorProduct.map (Ideal.Quotient.mkₐ L (extIdeal ι I))
        (Ideal.Quotient.mkₐ L (extIdeal ι I)) (extTensor ι z)
      = extQuotTensor ι I
          (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k I) (Ideal.Quotient.mkₐ k I) z) := by
  induction z with
  | add u v hu hv => simp only [map_add, hu, hv]
  | tmul a b => simp

/-- The `k`-algebra map `H ⊗[k] (H/I) → H' ⊗[L] (H'/I')`. -/
noncomputable def extLQuotTensor :
    H ⊗[k] (H ⧸ I) →ₐ[k] H' ⊗[L] (H' ⧸ extIdeal ι I) :=
  Algebra.TensorProduct.lift
    (((Algebra.TensorProduct.includeLeft :
        H' →ₐ[L] H' ⊗[L] (H' ⧸ extIdeal ι I)).restrictScalars k).comp ι)
    (((Algebra.TensorProduct.includeRight :
        (H' ⧸ extIdeal ι I) →ₐ[L]
          H' ⊗[L] (H' ⧸ extIdeal ι I)).restrictScalars k).comp (extQuotMap ι I))
    (fun _ _ => by
      exact Commute.all (S := H' ⊗[L] (H' ⧸ extIdeal ι I)) _ _)

/-- `extLQuotTensor (x ⊗ a) = ι x ⊗ extQuotMap a`. -/
@[simp] lemma extLQuotTensor_tmul (x : H) (a : H ⧸ I) :
    extLQuotTensor ι I (x ⊗ₜ[k] a) = (ι x) ⊗ₜ[L] (extQuotMap ι I a) := by
  simp [extLQuotTensor, Algebra.TensorProduct.tmul_mul_tmul]

/-- `(id ⊗ π') ∘ extTensor = extLQuotTensor ∘ (id ⊗ π)`, for the quotient maps `π : H → H/I`
and `π' : H' → H'/ι(I)H'`. -/
lemma lTensorQuot_extTensor (z : H ⊗[k] H) :
    lTensorQuot (k := L) (extIdeal ι I) (extTensor ι z)
      = extLQuotTensor ι I (lTensorQuot (k := k) I z) := by
  induction z with
  | add u v hu hv => simp only [map_add, hu, hv]
  | tmul a b => simp [lTensorQuot]

/-! ### The extended ideal is a normal Hopf ideal -/

include hcomul hantipode hcounit in
/-- **Takeuchi's Lemma 4.6, first half**: the ideal generated by a Hopf ideal in an extension of
the base field is a Hopf ideal. -/
theorem isHopfIdeal_extIdeal (hI : IsHopfIdeal k I) : IsHopfIdeal L (extIdeal ι I) := by
  apply IsHopfIdeal.mk
  case hc =>
    have hle : extIdeal ι I ≤ RingHom.ker (Bialgebra.counitAlgHom L H') := by
      refine extIdeal_le ι I fun y hy => ?_
      simp only [RingHom.mem_ker, Bialgebra.counitAlgHom_apply]
      rw [hcounit, IsHopfIdeal.counit_eq_zero k hI y hy, map_zero]
    intro x hx
    exact hle hx
  case hd =>
    have hle : extIdeal ι I ≤ RingHom.ker
        ((Algebra.TensorProduct.map (Ideal.Quotient.mkₐ L (extIdeal ι I))
          (Ideal.Quotient.mkₐ L (extIdeal ι I))).comp (Bialgebra.comulAlgHom L H')) := by
      refine extIdeal_le ι I fun y hy => ?_
      simp only [RingHom.mem_ker, AlgHom.comp_apply, Bialgebra.comulAlgHom_apply]
      rw [hcomul, map_mk_extTensor, IsHopfIdeal.comul_mem k hI y hy, map_zero]
    intro x hx
    exact hle hx
  case hs =>
    have hle : extIdeal ι I ≤
        Ideal.comap (HopfAlgebra.antipodeAlgHom L H') (extIdeal ι I) := by
      refine extIdeal_le ι I fun y hy => ?_
      simp only [Ideal.mem_comap, HopfAlgebra.antipodeAlgHom_apply]
      rw [hantipode]
      exact mem_extIdeal ι I (IsHopfIdeal.antipode_mem k hI y hy)
    intro x hx
    exact hle hx

include hcomul hantipode hcounit in
/-- **Takeuchi's Lemma 4.6, first half**: the ideal generated by a normal Hopf ideal in an
extension of the base field is a normal Hopf ideal. -/
theorem isNormalHopfIdeal_extIdeal (hI : IsNormalHopfIdeal k I) :
    IsNormalHopfIdeal L (extIdeal ι I) where
  toIsHopfIdeal := isHopfIdeal_extIdeal ι hcomul hantipode hcounit I hI.toIsHopfIdeal
  ad_mem := by
    have hle : extIdeal ι I ≤ RingHom.ker
        ((lTensorQuot (k := L) (extIdeal ι I)).comp (adAlgHom L H')) := by
      refine extIdeal_le ι I fun y hy => ?_
      simp only [RingHom.mem_ker, AlgHom.comp_apply]
      rw [adAlgHom_ext ι hcomul hantipode, lTensorQuot_extTensor, hI.ad_mem y hy, map_zero]
    intro x hx
    exact hle hx

end HopfAlgebra.Commutative.HopfExt

/-! ## Base change to `L ⊗[k] H` -/

namespace HopfAlgebra.Commutative.BaseChange

variable (k L H : Type u) [CommRing k] [Field L] [Algebra k L] [CommRing H]
  [HopfAlgebra k H]

/-- The canonical `k`-algebra map `H → L ⊗[k] H`. -/
noncomputable abbrev incl : H →ₐ[k] L ⊗[k] H := Algebra.TensorProduct.includeRight

variable {k L H}

/-- `incl x = 1 ⊗ x`. -/
@[simp] lemma incl_apply (x : H) : incl k L H x = (1 : L) ⊗ₜ[k] x := rfl

/-- The counit is compatible with base change. -/
lemma counit_incl (x : H) :
    counit (R := L) (incl k L H x) = algebraMap k L (counit (R := k) x) := by
  rw [incl_apply, TensorProduct.counit_tmul]
  simp [Algebra.algebraMap_eq_smul_one]

/-- The antipode is compatible with base change. -/
lemma antipode_incl (x : H) :
    antipode L (incl k L H x) = incl k L H (antipode k x) := by
  simp [TensorProduct.antipode_def]

/-- The comultiplication is compatible with base change. -/
lemma comul_incl (x : H) :
    comul (R := L) (incl k L H x)
      = HopfExt.extTensor (incl k L H) (comul (R := k) x) := by
  rw [incl_apply, TensorProduct.comul_tmul]
  induction (comul (R := k) x) with
  | add u v hu hv => simp only [map_add, hu, hv, TensorProduct.tmul_add]
  | tmul a b => simp

variable (k L)

end HopfAlgebra.Commutative.BaseChange
end
end
