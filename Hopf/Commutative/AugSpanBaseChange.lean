module

public import Hopf.Commutative.BaseChange
public import Hopf.Commutative.AugSpan

/-!
# Descent of Takeuchi's correspondence along a field extension

This file proves the second half of Takeuchi's Lemma 4.6: the formation `I ↦ K(I)` of the
sub-Hopf algebra of coinvariants of a normal Hopf ideal commutes with extension of the base
field.  Combined with the first half (`Hopf/Commutative/BaseChange.lean`) this shows
that the surjectivity half of Takeuchi's Theorem 4.3 descends along a field extension: if it holds
for `L ⊗[k] H` over `L`, it holds for `H` over `k`.

Everything is phrased for an abstract commutative `L`-Hopf algebra `H'` equipped with a
`k`-algebra map `ι : H →ₐ[k] H'` which is compatible with the structure maps and identifies `H'`
with `L ⊗[k] H`.

## Main results

* `HopfAlgebra.Commutative.HopfExt.ext_mem_extIdeal_augIdeal_coinv`: if `extAlg L ι` is bijective
  and the surjectivity half of Theorem 4.3 holds for `H'`, then `ι y` lies in the ideal generated by
  `ι(K(I)⁺H)` for every `y` in a normal Hopf ideal `I` of `H`.
* `HopfAlgebra.Commutative.HopfExt.normalHopfIdealEqAugSpan_of_ext`: if moreover `k → L` is
  injective, the surjectivity half of Theorem 4.3 holds for `H` (Takeuchi's Lemma 4.6).
* `HopfAlgebra.Commutative.BaseChange.extAlg_incl_bijective`: for `H' = L ⊗[k] H`, the comparison
  map `extAlg` is bijective.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Lemma 4.6 and Theorem 4.3
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

section
open HopfAlgebra HopfAlgebra.Commutative HopfAlgebra.Commutative.BaseChange
open HopfAlgebra.Commutative.HopfExt
namespace HopfAlgebra.Commutative

universe u

variable {k H : Type u} [CommRing k] [CommRing H] [HopfAlgebra k H]

/-- The `k`-linear map `x ↦ Δx - x ⊗ 1̄` whose kernel is the subalgebra `K(I)`. -/
noncomputable def coinvMap (I : Ideal H) : H →ₗ[k] H ⊗[k] (H ⧸ I) :=
  (lTensorQuot (k := k) I).toLinearMap ∘ₗ (comul (R := k) (A := H)) -
    ((TensorProduct.mk k H (H ⧸ I)).flip 1)

/-- `coinvMap I x = (id ⊗ π) (Δ x) - x ⊗ 1`. -/
lemma coinvMap_apply (I : Ideal H) (x : H) :
    coinvMap I x = lTensorQuot I (comul (R := k) x) - x ⊗ₜ[k] (1 : H ⧸ I) := by
  simp [coinvMap]

/-- The kernel of `coinvMap I : x ↦ (1 ⊗ π)(Δ x) - x ⊗ 1` is the subalgebra `coinvLeft I`. -/
lemma ker_coinvMap (I : Ideal H) :
    LinearMap.ker (coinvMap I) = (coinvLeft I : Subalgebra k H).toSubmodule := by
  ext x
  rw [LinearMap.mem_ker, coinvMap_apply, sub_eq_zero]
  exact Iff.rfl

namespace HopfExt

variable (L : Type u) [Field L] [Algebra k L]
variable {H' : Type u} [CommRing H'] [HopfAlgebra L H'] [Algebra k H'] [IsScalarTower k L H']

variable (ι : H →ₐ[k] H')

/-- The `L`-algebra map `L ⊗[k] H → H'` induced by `ι`. -/
noncomputable def extAlg : L ⊗[k] H →ₐ[L] H' :=
  Algebra.TensorProduct.lift (Algebra.ofId L H') ι (fun _ _ => by exact Commute.all _ _)

/-- `extAlg (c ⊗ x) = c • ι x`. -/
@[simp] lemma extAlg_tmul (c : L) (x : H) : extAlg L ι (c ⊗ₜ[k] x) = c • ι x := by
  simp [extAlg, Algebra.ofId_apply, Algebra.smul_def]

section Down

variable (hbij : Function.Bijective (extAlg L ι))

include hbij in
/-- The inverse of `extAlg`, as an algebra isomorphism. -/
noncomputable def extEquiv : (L ⊗[k] H) ≃ₐ[L] H' := AlgEquiv.ofBijective (extAlg L ι) hbij

include hbij in
/-- The inverse of `extEquiv` sends `ι x` to `1 ⊗ x`. -/
lemma extEquiv_symm_ι (x : H) : (extEquiv L ι hbij).symm (ι x) = (1 : L) ⊗ₜ[k] x := by
  refine (extEquiv L ι hbij).symm_apply_eq.2 ?_
  exact ((extAlg_tmul L ι 1 x).trans (one_smul L (ι x))).symm

include hbij in
/-- The `L`-algebra map `H' → L ⊗[k] (H ⧸ M)` obtained by inverting `extAlg` and reducing the
second factor modulo `M`. -/
noncomputable def extDown (M : Ideal H) : H' →ₐ[L] L ⊗[k] (H ⧸ M) :=
  (Algebra.TensorProduct.map (AlgHom.id L L) (Ideal.Quotient.mkₐ k M)).comp
    (extEquiv L ι hbij).symm.toAlgHom

include hbij in
/-- `extDown M (ι x) = 1 ⊗ [x]`. -/
lemma extDown_ι (M : Ideal H) (x : H) :
    extDown L ι hbij M (ι x) = (1 : L) ⊗ₜ[k] (Ideal.Quotient.mk M x) := by
  have hx : ((extEquiv L ι hbij).symm.toAlgHom : (H' →ₐ[L] L ⊗[k] H)) (ι x) = (1 : L) ⊗ₜ[k] x :=
    extEquiv_symm_ι L ι hbij x
  rw [extDown, AlgHom.comp_apply, hx, Algebra.TensorProduct.map_tmul]
  rfl

include hbij in
/-- `extDown M` vanishes on the extended ideal `ι(M)H'`. -/
lemma extIdeal_le_ker_extDown (M : Ideal H) :
    extIdeal ι M ≤ RingHom.ker (extDown L ι hbij M) := by
  refine extIdeal_le ι M fun m hm => ?_
  simp only [RingHom.mem_ker, extDown_ι]
  rw [Ideal.Quotient.eq_zero_iff_mem.2 hm, TensorProduct.tmul_zero]

end Down

variable (I : Ideal H)

/-- The `L`-linear map `L ⊗[k] (H ⧸ I) → H' ⧸ ι(I)H'`. -/
noncomputable def extQuotLin : L ⊗[k] (H ⧸ I) →ₗ[L] (H' ⧸ extIdeal ι I) :=
  AlgebraTensorModule.lift
    (LinearMap.toSpanSingleton L ((H ⧸ I) →ₗ[k] (H' ⧸ extIdeal ι I))
      (extQuotMap ι I).toLinearMap)

/-- `extQuotLin (c ⊗ q) = c • extQuotMap q` (true by definition). -/
@[simp] lemma extQuotLin_tmul (c : L) (q : H ⧸ I) :
    extQuotLin L ι I (c ⊗ₜ[k] q) = c • extQuotMap ι I q := rfl

/-- The inverse of `extQuotLin`. -/
noncomputable def extQuotLinInv (hbij : Function.Bijective (extAlg L ι)) :
    (H' ⧸ extIdeal ι I) →ₐ[L] L ⊗[k] (H ⧸ I) :=
  Ideal.Quotient.liftₐ (extIdeal ι I) (extDown L ι hbij I) <| fun m hm => by
    have := extIdeal_le_ker_extDown L ι hbij I hm
    simpa [RingHom.mem_ker] using this

/-- `extQuotLinInv` on a class is `extDown`. -/
@[simp] lemma extQuotLinInv_mk (hbij : Function.Bijective (extAlg L ι)) (z : H') :
    extQuotLinInv L ι I hbij (Ideal.Quotient.mk (extIdeal ι I) z) = extDown L ι hbij I z := rfl

/-- If `extAlg L ι` is bijective, `extQuotLinInv` is a left inverse of `extQuotLin`. -/
lemma extQuotLinInv_leftInverse (hbij : Function.Bijective (extAlg L ι)) :
    Function.LeftInverse (extQuotLinInv L ι I hbij) (extQuotLin L ι I) := by
  intro w
  induction w with
  | add u v hu hv => rw [map_add, map_add, hu, hv]
  | tmul c q =>
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
      rw [extQuotLin_tmul, map_smul, extQuotMap_mk, extQuotLinInv_mk, extDown_ι,
        TensorProduct.smul_tmul']
      simp

/-- If `extAlg L ι` is bijective, `extQuotLin` is injective. -/
lemma extQuotLin_injective (hbij : Function.Bijective (extAlg L ι)) :
    Function.Injective (extQuotLin L ι I) :=
  (extQuotLinInv_leftInverse L ι I hbij).injective

/-- The `k`-linear map `L ⊗[k] (H ⊗[k] (H ⧸ I)) → H' ⊗[L] (H' ⧸ ι(I)H')`,
`c ⊗ (a ⊗ q) ↦ (c • ι a) ⊗ ψ q`. -/
noncomputable def extBigMap :
    L ⊗[k] (H ⊗[k] (H ⧸ I)) →ₗ[k] H' ⊗[L] (H' ⧸ extIdeal ι I) :=
  (LinearMap.lTensor H' (extQuotLin L ι I)).restrictScalars k ∘ₗ
    (AlgebraTensorModule.cancelBaseChange k L L H' (H ⧸ I)).symm.toLinearMap.restrictScalars k ∘ₗ
      (LinearMap.rTensor (H ⧸ I) ((extAlg L ι).toLinearMap.restrictScalars k)) ∘ₗ
        (TensorProduct.assoc k L H (H ⧸ I)).symm.toLinearMap

/-- `extBigMap (c ⊗ (a ⊗ q)) = (c • ι a) ⊗ extQuotMap q`. -/
@[simp] lemma extBigMap_tmul (c : L) (a : H) (q : H ⧸ I) :
    extBigMap L ι I (c ⊗ₜ[k] (a ⊗ₜ[k] q)) = (c • ι a) ⊗ₜ[L] (extQuotMap ι I q) := by
  simp [extBigMap]

/-- If `extAlg L ι` is bijective, `extBigMap` is injective. -/
lemma extBigMap_injective [IsAbsFlat k] (hbij : Function.Bijective (extAlg L ι)) :
    Function.Injective (extBigMap L ι I) := by
  -- `extBigMap` is a composite of four injective maps (flatness of `L` and of `H'` over `L`)
  have hassoc : Function.Injective ((TensorProduct.assoc k L H (H ⧸ I)).symm.toLinearMap) :=
    (TensorProduct.assoc k L H (H ⧸ I)).symm.injective
  have hext : Function.Injective
      (LinearMap.rTensor (H ⧸ I) ((extAlg L ι).toLinearMap.restrictScalars k)) :=
    Module.Flat.rTensor_preserves_injective_linearMap _ hbij.1
  have hcancel : Function.Injective
      ((AlgebraTensorModule.cancelBaseChange k L L H' (H ⧸ I)).symm.toLinearMap.restrictScalars
        k) :=
    (AlgebraTensorModule.cancelBaseChange k L L H' (H ⧸ I)).symm.injective
  have hquot : Function.Injective ((LinearMap.lTensor H' (extQuotLin L ι I)).restrictScalars k) :=
    Module.Flat.lTensor_preserves_injective_linearMap _ (extQuotLin_injective L ι I hbij)
  exact hquot.comp (hcancel.comp (hext.comp hassoc))

/-- `extBigMap (c ⊗ t) = c • extBigMap (1 ⊗ t)`. -/
lemma extBigMap_smul (c : L) (t : H ⊗[k] (H ⧸ I)) :
    extBigMap L ι I (c ⊗ₜ[k] t) = c • extBigMap L ι I ((1 : L) ⊗ₜ[k] t) := by
  induction t with
  | add u v hu hv => rw [TensorProduct.tmul_add, TensorProduct.tmul_add, map_add, map_add, hu, hv,
      smul_add]
  | tmul a q => rw [extBigMap_tmul, extBigMap_tmul, one_smul, TensorProduct.smul_tmul']

variable (hcomul : ∀ x : H, comul (R := L) (ι x) = extTensor ι (comul (R := k) x))

/-- `(id ⊗ π') (extTensor z) = extBigMap (1 ⊗ (id ⊗ π) z)`, for the quotient maps
`π : H → H/I` and `π' : H' → H'/ι(I)H'`. -/
lemma lTensorQuot_extTensor_eq (z : H ⊗[k] H) :
    lTensorQuot (k := L) (extIdeal ι I) (extTensor ι z)
      = extBigMap L ι I ((1 : L) ⊗ₜ[k] (lTensorQuot (k := k) I z)) := by
  induction z with
  | add u v hu hv => rw [map_add, map_add, hu, hv, ← map_add, ← TensorProduct.tmul_add, map_add]
  | tmul a b =>
      rw [extTensor_tmul, lTensorQuot_tmul, lTensorQuot_tmul, extBigMap_tmul, one_smul]
      rfl

include hcomul in
/-- If `ι` is compatible with the comultiplications, then
`coinvMap (ι(I)H') ∘ extAlg = extBigMap ∘ (id_L ⊗ coinvMap I)`. -/
lemma coinvMap_extAlg (w : L ⊗[k] H) :
    coinvMap (extIdeal ι I) (extAlg L ι w)
      = extBigMap L ι I (LinearMap.lTensor L (coinvMap I) w) := by
  induction w with
  | add u v hu hv => simp only [map_add, hu, hv]
  | tmul c x =>
      rw [extAlg_tmul, LinearMap.lTensor_tmul, extBigMap_smul, coinvMap_apply, coinvMap_apply,
        TensorProduct.tmul_sub, map_sub, smul_sub]
      congr 1
      · rw [map_smul, map_smul, hcomul, lTensorQuot_extTensor_eq]
      · rw [extBigMap_tmul, one_smul, map_one, TensorProduct.smul_tmul']

include hcomul in
/-- **Takeuchi's Lemma 4.6, second half**: the coinvariants of the extended ideal come from the
coinvariants of `I`. -/
lemma exists_of_mem_coinvLeft_extIdeal [IsAbsFlat k] (hbij : Function.Bijective (extAlg L ι))
    {z : H'} (hz : z ∈ (coinvLeft (extIdeal ι I) : Subalgebra L H')) :
    ∃ t : L ⊗[k] ↥(LinearMap.ker (coinvMap (k := k) I)),
      extAlg L ι
        (LinearMap.lTensor L (LinearMap.ker (coinvMap (k := k) I)).subtype t) = z := by
  obtain ⟨w, hw⟩ := hbij.2 z
  have hz0 : coinvMap (k := L) (extIdeal ι I) z = 0 := by
    have hmem : z ∈ LinearMap.ker (coinvMap (k := L) (extIdeal ι I)) := by
      rw [ker_coinvMap]; exact hz
    exact hmem
  have h1 : extBigMap L ι I (LinearMap.lTensor L (coinvMap (k := k) I) w) = 0 := by
    rw [← coinvMap_extAlg L ι I hcomul w, hw]; exact hz0
  have h2 : LinearMap.lTensor L (coinvMap I) w = 0 :=
    extBigMap_injective L ι I hbij (by rw [h1, map_zero])
  have hex := Module.Flat.lTensor_exact L
    (LinearMap.exact_subtype_ker_map (coinvMap (k := k) I))
  obtain ⟨t, ht⟩ := (hex w).1 h2
  exact ⟨t, by rw [ht, hw]⟩

variable (hcounit : ∀ x : H, counit (R := L) (ι x) = algebraMap k L (counit (R := k) x))

include hcounit in
/-- Helper for `augIdeal_coinvLeft_extIdeal_le`: on pure tensors `c ⊗ₜ u`,
`E (c ⊗ₜ u) = E (c ⊗ₜ (u - counit u)) + algebraMap L H' (counit u • c)` and
`counit (E (c ⊗ₜ u)) = counit u • c`. -/
private lemma augIdeal_coinvLeft_tensor_decomp :
    let Ksub : Submodule k H := LinearMap.ker (coinvMap (k := k) I)
    let eps : ↥Ksub →ₗ[k] k := (counit (R := k) (A := H)) ∘ₗ Ksub.subtype
    let augLin : ↥Ksub →ₗ[k] H := Ksub.subtype - (Algebra.linearMap k H) ∘ₗ eps
    let E : (L ⊗[k] H) →ₗ[k] H' := (extAlg L ι).toLinearMap.restrictScalars k
    let Amap : (L ⊗[k] ↥Ksub) →ₗ[k] H' := E ∘ₗ LinearMap.lTensor L Ksub.subtype
    let Bmap : (L ⊗[k] ↥Ksub) →ₗ[k] H' := E ∘ₗ LinearMap.lTensor L augLin
    let etaMap : (L ⊗[k] ↥Ksub) →ₗ[k] L :=
      (TensorProduct.rid k L).toLinearMap ∘ₗ LinearMap.lTensor L eps
    ∀ t : L ⊗[k] ↥Ksub,
      Amap t = Bmap t + algebraMap L H' (etaMap t) ∧
      counit (R := L) (Amap t) = etaMap t := by
  intro Ksub eps augLin E Amap Bmap etaMap t
  have hA : ∀ (c : L) (u : ↥Ksub), Amap (c ⊗ₜ[k] u) = c • ι (u : H) := fun c u => by
    change E (LinearMap.lTensor L Ksub.subtype (c ⊗ₜ[k] u)) = _
    rw [LinearMap.lTensor_tmul]; change extAlg L ι (c ⊗ₜ[k] (u : H)) = _; rw [extAlg_tmul]
  have hB : ∀ (c : L) (u : ↥Ksub),
      Bmap (c ⊗ₜ[k] u) = c • ι ((u : H) - algebraMap k H (counit (R := k) (u : H))) :=
    fun c u => by
      simp only [Bmap, E, LinearMap.comp_apply, LinearMap.lTensor_tmul,
        LinearMap.restrictScalars_apply, AlgHom.toLinearMap_apply, extAlg_tmul]
      rfl
  have heta : ∀ (c : L) (u : ↥Ksub), etaMap (c ⊗ₜ[k] u) = (counit (R := k) (u : H)) • c :=
    fun c u => by
      simp only [etaMap, LinearMap.comp_apply, LinearMap.lTensor_tmul, LinearEquiv.coe_coe]
      rfl
  induction t with
  | add u v hu hv =>
      refine ⟨?_, ?_⟩
      · rw [map_add, map_add, map_add, map_add, hu.1, hv.1]; ring
      · rw [map_add, map_add, map_add, hu.2, hv.2]
  | tmul c u =>
      refine ⟨?_, ?_⟩
      · rw [hA, hB, heta, map_sub, smul_sub, AlgHom.commutes]
        have hcm : algebraMap L H' ((counit (R := k) (u : H)) • c)
            = c • algebraMap k H' (counit (R := k) (u : H)) := by
          rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply,
            Algebra.smul_def, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
          ring
        rw [hcm]; ring
      · rw [hA, heta, map_smul, hcounit, Algebra.smul_def, Algebra.smul_def, mul_comm]; simp

include hcomul hcounit in
/-- The augmentation ideal of the coinvariants of the extended ideal is generated by that of the
coinvariants of `I`. -/
lemma augIdeal_coinvLeft_extIdeal_le [IsAbsFlat k] (hbij : Function.Bijective (extAlg L ι)) :
    augIdeal (coinvLeft (extIdeal ι I) : Subalgebra L H')
      ≤ extIdeal ι (augIdeal (coinvLeft I : Subalgebra k H)) := by
  classical
  -- `K = ker (coinvMap I)`, with its counit `eps` and its augmentation part `u ↦ u - ε(u)`
  set Ksub : Submodule k H := LinearMap.ker (coinvMap (k := k) I) with hKsub
  have hKmem : ∀ u : H, u ∈ Ksub ↔ u ∈ (coinvLeft I : Subalgebra k H) := fun u => by
    rw [hKsub, ker_coinvMap]; exact Iff.rfl
  set eps : ↥Ksub →ₗ[k] k := (counit (R := k) (A := H)) ∘ₗ Ksub.subtype
  set augLin : ↥Ksub →ₗ[k] H := Ksub.subtype - (Algebra.linearMap k H) ∘ₗ eps
  -- `Amap` and `Bmap`: an element of `L ⊗ K` and its augmentation part, mapped to `H'`
  set E : (L ⊗[k] H) →ₗ[k] H' := (extAlg L ι).toLinearMap.restrictScalars k
  set Amap : (L ⊗[k] ↥Ksub) →ₗ[k] H' := E ∘ₗ LinearMap.lTensor L Ksub.subtype
  set Bmap : (L ⊗[k] ↥Ksub) →ₗ[k] H' := E ∘ₗ LinearMap.lTensor L augLin
  set etaMap : (L ⊗[k] ↥Ksub) →ₗ[k] L :=
    (TensorProduct.rid k L).toLinearMap ∘ₗ LinearMap.lTensor L eps
  have hB : ∀ (c : L) (u : ↥Ksub),
      Bmap (c ⊗ₜ[k] u) = c • ι ((u : H) - algebraMap k H (counit (R := k) (u : H))) :=
    fun c u => by
      simp only [Bmap, E, LinearMap.comp_apply, LinearMap.lTensor_tmul,
        LinearMap.restrictScalars_apply, AlgHom.toLinearMap_apply, extAlg_tmul]
      rfl
  -- the augmentation parts land in the extension of `K(I)⁺`
  have hBmem : ∀ t : L ⊗[k] ↥Ksub,
      Bmap t ∈ extIdeal ι (augIdeal (coinvLeft I : Subalgebra k H)) := fun t => by
    induction t with
    | add u v hu hv => rw [map_add]; exact Ideal.add_mem _ hu hv
    | tmul c u =>
        rw [hB, Algebra.smul_def]
        refine Ideal.mul_mem_left _ _ (mem_extIdeal ι _ (mem_augIdeal_of_mem ?_ (by simp)))
        exact Subalgebra.sub_mem _ ((hKmem _).1 u.2) (Subalgebra.algebraMap_mem _ _)
  -- a generator `z` of the left side: `z ∈ K(ι(I)H')` with `ε(z) = 0`; lift it to `t ∈ L ⊗ K`
  -- (Lemma 4.6, second half); then `z = Amap t = Bmap t + η(t)` with `η(t) = ε(z) = 0`
  rw [augIdeal, Ideal.span_le]
  rintro z ⟨hzK, hzc⟩
  obtain ⟨t, ht⟩ := exists_of_mem_coinvLeft_extIdeal L ι I hcomul hbij hzK
  obtain ⟨key, hcount⟩ := augIdeal_coinvLeft_tensor_decomp L ι I (hcounit := hcounit) t
  have hAt : Amap t = z := ht
  have h0 : etaMap t = 0 := by rw [← hcount, hAt]; exact hzc
  have : z = Bmap t := hAt.symm.trans (key.trans (by rw [h0, map_zero, add_zero]))
  rw [this]
  exact hBmem t

/-- Faithful flatness: an element of `H` lying in the extension of an ideal `M` lies in `M`,
provided the base extension `k → L` is injective. -/
lemma mem_of_ext_mem [IsAbsFlat k] (hbij : Function.Bijective (extAlg L ι))
    (hfaith : Function.Injective (algebraMap k L)) (M : Ideal H) {y : H}
    (h : ι y ∈ extIdeal ι M) : y ∈ M := by
  have h0 : (1 : L) ⊗ₜ[k] (Ideal.Quotient.mk M y) = 0 := by
    rw [← extDown_ι L ι hbij M y]
    simpa [RingHom.mem_ker] using extIdeal_le_ker_extDown L ι hbij M h
  have hinj : Function.Injective
      (Algebra.TensorProduct.includeRight : (H ⧸ M) →ₐ[k] L ⊗[k] (H ⧸ M)) :=
    Algebra.TensorProduct.includeRight_injective hfaith
  have hy0 : (Ideal.Quotient.mk M y) = 0 := by
    refine hinj ?_
    rw [Algebra.TensorProduct.includeRight_apply, map_zero, h0]
  exact Ideal.Quotient.eq_zero_iff_mem.1 hy0

variable (hantipode : ∀ x : H, antipode L (ι x) = ι (antipode k x))

include hcomul hcounit hantipode in
/-- **The core of Takeuchi's Lemma 4.6**, without any faithfulness assumption on the extension:
if the surjectivity half of Theorem 4.3 holds over `L`, then every element of a normal Hopf
ideal `I` of `H` maps into the ideal of `H'` generated by `K(I)⁺H`. -/
theorem ext_mem_extIdeal_augIdeal_coinv [IsAbsFlat k] (hbij : Function.Bijective (extAlg L ι))
    (hSurj : NormalHopfIdealEqAugSpan L H') {I : Ideal H} (hI : IsNormalHopfIdeal k I) {y : H}
    (hy : y ∈ I) : ι y ∈ extIdeal ι (augIdeal (coinvOfIdeal (k := k) I)) := by
  have hI' : IsNormalHopfIdeal L (extIdeal ι I) :=
    isNormalHopfIdeal_extIdeal ι hcomul hantipode hcounit I hI
  have hy' : ι y ∈ extIdeal ι I := mem_extIdeal ι I hy
  rw [hSurj _ hI'] at hy'
  exact augIdeal_coinvLeft_extIdeal_le L ι I hcomul hcounit hbij hy'

include hcomul hcounit hantipode in
/-- **Takeuchi's Lemma 4.6** [Takeuchi1972]: the surjectivity half of Theorem 4.3 descends along an
extension of the base field. -/
theorem normalHopfIdealEqAugSpan_of_ext [IsAbsFlat k] (hbij : Function.Bijective (extAlg L ι))
    (hfaith : Function.Injective (algebraMap k L))
    (hSurj : NormalHopfIdealEqAugSpan L H') : NormalHopfIdealEqAugSpan k H := by
  intro I hI
  refine le_antisymm (fun y hy => ?_) (augIdeal_coinv_le I)
  exact mem_of_ext_mem L ι hbij hfaith _
    (ext_mem_extIdeal_augIdeal_coinv L ι hcomul hcounit hantipode hbij hSurj hI hy)

end HopfExt

/-! ## The standard base change `L ⊗[k] H` -/

namespace BaseChange

variable (L : Type u) [Field L] [Algebra k L]

variable (k H) in
/-- For `H' = L ⊗[k] H` and `ι` the canonical inclusion, the comparison map `extAlg` is the
identity. -/
lemma extAlg_incl_apply (w : L ⊗[k] H) : HopfExt.extAlg L (incl k L H) w = w := by
  induction w with
  | add u v hu hv => rw [map_add, hu, hv]
  | tmul c x =>
      rw [HopfExt.extAlg_tmul, incl_apply, TensorProduct.smul_tmul', smul_eq_mul, mul_one]

variable (k H) in
/-- The comparison map `extAlg` for the base change `L ⊗[k] H` is bijective. -/
lemma extAlg_incl_bijective : Function.Bijective (HopfExt.extAlg L (incl k L H)) := by
  refine ⟨fun a b hab => ?_, fun z => ⟨z, extAlg_incl_apply k H L z⟩⟩
  rw [← extAlg_incl_apply k H L a, ← extAlg_incl_apply k H L b, hab]

end BaseChange
end HopfAlgebra.Commutative
