module

public import Foundations.RingTheory.AbsFlatClass
public import Hopf.Basic.NormalHopfIdeal

/-!
# Takeuchi's correspondence: `K ↦ K⁺H`

This file continues the formalisation of §4 of M. Takeuchi, *A correspondence between Hopf ideals
and sub-Hopf algebras*, manuscripta math. **7** (1972), 251–270, for a commutative Hopf algebra `H`
over a commutative von Neumann regular ring `k` (for instance a field).

## Main results

* `HopfAlgebra.Commutative.augSet`: the augmentation ideal `K⁺ = {x ∈ K | ε x = 0}` of a subalgebra
  `K`, as a subset of `H`.
* `HopfAlgebra.Commutative.augIdeal`: the ideal `K⁺H` of `H` generated by `K⁺`.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Section 4 (Lemma 4.2) and Corollary 3.10
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra LinearMap

section
namespace HopfAlgebra.Commutative

variable {k H : Type*} [CommRing k] [CommRing H] [HopfAlgebra k H]

/-- The augmentation ideal `K⁺ = {x ∈ K | ε x = 0}` of a subalgebra `K`, as a subset of `H`. -/
def augSet (K : Subalgebra k H) : Set H := {x | x ∈ K ∧ Coalgebra.counit (R := k) x = 0}

/-- The ideal `K⁺H` of `H` generated by the augmentation ideal of the subalgebra `K`. -/
noncomputable def augIdeal (K : Subalgebra k H) : Ideal H := Ideal.span (augSet K)

variable {K : Subalgebra k H}

/-- `augIdeal K` is the ideal generated by `augSet K = K⁺` (true by definition). -/
lemma augIdeal_eq_span : augIdeal K = Ideal.span (augSet K) := rfl

/-- An element `x ∈ K` with `ε x = 0` lies in `augSet K`. -/
lemma mem_augSet {x : H} (hxK : x ∈ K) (hx : Coalgebra.counit (R := k) x = 0) :
    x ∈ augSet K := ⟨hxK, hx⟩

/-- An element of `K` with `ε x = 0` lies in `augIdeal K`. -/
lemma mem_augIdeal_of_mem {x : H} (hxK : x ∈ K) (hx : Coalgebra.counit (R := k) x = 0) :
    x ∈ augIdeal K :=
  Ideal.subset_span (mem_augSet hxK hx)

