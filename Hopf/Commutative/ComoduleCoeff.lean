module

public import Hopf.Basic.Comodule
public import Hopf.Commutative.AugSpan

/-!
# Coefficients of a relatively invariant vector

Let `H` be a commutative Hopf algebra over a field `k` and let `I` be a Hopf ideal of `H`, so
that `H̄ = H/I` is a quotient Hopf algebra and every right `H`-comodule becomes a right
`H̄`-comodule.

This file formalises the final computation in Takeuchi's proof of Theorem 4.3 of *A correspondence
between Hopf ideals and sub-Hopf algebras* (manuscripta math. **7** (1972)), in the form of a
self-contained, unconditional statement.

## Main definitions

* `HopfAlgebra.Commutative.comoduleCoeff χ v`: the coefficient `∑ ⟨χ, v₍₀₎⟩ v₍₁₎ ∈ H` of a vector
  `v` of a right `H`-comodule `V` against a linear functional `χ : V → k`;
* `HopfAlgebra.Commutative.IsCoinvMod k I v`: the vector `v` is coinvariant modulo `I`, i.e.
  `ρ v = v ⊗ 1` in `V ⊗ H/I`.

## Main results

* `HopfAlgebra.Commutative.counit_comoduleCoeff`: `ε (comoduleCoeff χ v) = ⟨χ, v⟩`;
* `HopfAlgebra.Commutative.comoduleCoeff_mem_coinvLeft`: **the coefficients of a vector which is
  coinvariant modulo `I` lie in `K(I)`**, the algebra of coinvariants of `I`;
* `HopfAlgebra.Commutative.comoduleCoeff_mem_augIdeal`: hence a coefficient against a functional
  vanishing on `v` lies in the ideal `K(I)⁺H`;
* `HopfAlgebra.Commutative.eq_augIdeal_coinv_of_coeff_span`: consequently, a normal Hopf ideal `I`
  which is contained in the ideal generated by the coefficients (and the antipodes of the
  coefficients) of a single vector which is coinvariant modulo `I` satisfies `I = K(I)⁺H`, the
  conclusion of the surjectivity half of Takeuchi's Theorem 4.3.

The last statement is the shape in which Takeuchi concludes: his Lemmas 4.10–4.15 produce, for a
normal Hopf ideal of a finitely generated commutative Hopf algebra over an algebraically closed
field, a finite-dimensional comodule `V` and a one-dimensional subspace `W = k v` with
`ρ v ≡ v ⊗ 1` modulo `V ⊗ I` such that `I` is exactly the ideal generated by the "off-diagonal"
coefficients of `v` and their antipodes.  That production (a Chevalley-type theorem) is *not*
formalised here; the surjectivity statement continues to be carried as the explicit hypothesis
`HopfAlgebra.Commutative.NormalHopfIdealEqAugSpan`.

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972],
  Lemmas 4.4, 4.10–4.15 and Theorem 4.3
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

section
open Coalgebra HopfAlgebra HopfAlgebra.Commutative
namespace HopfAlgebra.Commutative

open Coalgebra.Comodule

universe u

variable {k H : Type u} [Field k] [CommRing H] [HopfAlgebra k H]

section Comod

variable {V : Type u} [AddCommGroup V] [Module k V]

/-- Contraction of the first tensor factor against a linear functional. -/
noncomputable def contractFst (χ : V →ₗ[k] k) : V ⊗[k] H →ₗ[k] H :=
  (TensorProduct.lid k H).toLinearMap ∘ₗ LinearMap.rTensor H χ

/-- `contractFst χ (u ⊗ h) = χ(u) h`. -/
@[simp] lemma contractFst_tmul (χ : V →ₗ[k] k) (u : V) (h : H) :
    contractFst χ (u ⊗ₜ[k] h) = χ u • h := by
  simp [contractFst]

/-- Contracting a pure tensor `u ⊗ w` with `w : H ⊗ H` in the first factor. -/
lemma rTensor_contractFst_assoc_symm (χ : V →ₗ[k] k) (u : V) (w : H ⊗[k] H) :
    LinearMap.rTensor H (contractFst χ) ((TensorProduct.assoc k V H H).symm (u ⊗ₜ[k] w))
      = χ u • w := by
  induction w with
  | tmul a b => simp [TensorProduct.smul_tmul']
  | add p q hp hq => rw [TensorProduct.tmul_add, map_add, map_add, hp, hq, smul_add]

/-- Compatibility of the contraction with the comultiplication. -/
lemma comul_contractFst (χ : V →ₗ[k] k) (z : V ⊗[k] H) :
    comul (R := k) (A := H) (contractFst χ z)
      = LinearMap.rTensor H (contractFst χ)
          ((TensorProduct.assoc k V H H).symm
            (LinearMap.lTensor V (comul (R := k) (A := H)) z)) := by
  induction z with
  | tmul u h =>
      rw [contractFst_tmul, map_smul, LinearMap.lTensor_tmul,
        rTensor_contractFst_assoc_symm]
  | add p q hp hq => simp only [map_add, hp, hq]

variable [RightComodule k H V]

/-- The **coefficient** `∑ ⟨χ, v₍₀₎⟩ v₍₁₎ ∈ H` of a vector `v` of a right `H`-comodule against a
linear functional `χ`. -/
noncomputable def comoduleCoeff (χ : V →ₗ[k] k) (v : V) : H :=
  contractFst χ (coact (R := k) (C := H) v)

/-- A vector `v` of a right `H`-comodule is **coinvariant modulo the ideal `I`** if its coaction
becomes `v ⊗ 1` in `V ⊗ H/I`. -/
def IsCoinvMod (k : Type u) [Field k] [HopfAlgebra k H] [Module k V] [RightComodule k H V]
    (I : Ideal H) (v : V) : Prop :=
  LinearMap.lTensor V (Ideal.Quotient.mkₐ k I).toLinearMap (coact (R := k) (C := H) v)
    = v ⊗ₜ[k] (1 : H ⧸ I)

/-- The counit of a coefficient is the value of the functional: `ε (∑ ⟨χ, v₍₀₎⟩ v₍₁₎) = ⟨χ, v⟩`. -/
theorem counit_comoduleCoeff (χ : V →ₗ[k] k) (v : V) :
    Coalgebra.counit (R := k) (A := H) (comoduleCoeff χ v) = χ v := by
  have key : ∀ z : V ⊗[k] H,
      Coalgebra.counit (R := k) (A := H) (contractFst χ z)
        = χ ((TensorProduct.rid k V) (LinearMap.lTensor V
            (Coalgebra.counit (R := k) (A := H)) z)) := by
    intro z
    induction z with
    | tmul u h => simp [mul_comm]
    | add p q hp hq => simp only [map_add, hp, hq]
  have h := key (coact (R := k) (C := H) v)
  rw [comoduleCoeff, h]
  have hc := congr($(Coalgebra.RightComodule.counit_coact (R := k) (C := H) (M := V)) v)
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.id_coe, id_eq,
    LinearEquiv.coe_coe] at hc
  rw [hc]

/-- The image of `V ⊗ I` under `ρ` followed by a contraction lies in `H ⊗ I`. -/
lemma lTensorQuot_rTensor_contractFst_eq_zero (χ : V →ₗ[k] k) (I : Ideal H)
    (s : V ⊗[k] (I.restrictScalars k)) :
    lTensorQuot I (LinearMap.rTensor H (contractFst χ)
      (LinearMap.rTensor H (coact (R := k) (C := H))
        (LinearMap.lTensor V (I.restrictScalars k).subtype s))) = 0 := by
  induction s with
  | tmul u x =>
      simp only [LinearMap.lTensor_tmul, Submodule.subtype_apply, LinearMap.rTensor_tmul]
      rw [lTensorQuot_tmul, Ideal.Quotient.eq_zero_iff_mem.2 x.2, TensorProduct.tmul_zero]
  | add p q hp hq => rw [map_add, map_add, map_add, map_add, hp, hq, add_zero]

/-- **The coefficients of a vector which is coinvariant modulo `I` are coinvariant**: they lie in
the subalgebra `K(I) = {x | Δ x ≡ x ⊗ 1 mod H ⊗ I}` of Takeuchi's Lemma 4.4.

This is the computation at the end of Takeuchi's proof of Theorem 4.3. -/
theorem comoduleCoeff_mem_coinvLeft {I : Ideal H} {v : V} (hv : IsCoinvMod k I v)
    (χ : V →ₗ[k] k) : comoduleCoeff χ v ∈ (coinvLeft (k := k) I : Subalgebra k H) := by
  classical
  -- write `ρ v = v ⊗ 1 + t` with `t ∈ V ⊗ I`
  have h0 : LinearMap.lTensor V (Ideal.Quotient.mkₐ k I).toLinearMap
      (coact (R := k) (C := H) v - v ⊗ₜ[k] (1 : H)) = 0 := by
    rw [map_sub, hv]
    simp
  have ht : coact (R := k) (C := H) v - v ⊗ₜ[k] (1 : H)
      ∈ LinearMap.range (LinearMap.lTensor V (I.restrictScalars k).subtype) := by
    have := TensorProduct.mem_range_lTensor_ker (M := V) (Ideal.Quotient.mkₐ k I).toLinearMap h0
    rwa [ker_quotMkₐ] at this
  obtain ⟨s, hs⟩ := ht
  have hsplit : coact (R := k) (C := H) v
      = v ⊗ₜ[k] (1 : H) + LinearMap.lTensor V (I.restrictScalars k).subtype s := by
    rw [hs]; abel
  -- the main computation
  have hcoassoc : (TensorProduct.assoc k V H H)
      (LinearMap.rTensor H (coact (R := k) (C := H)) (coact (R := k) (C := H) v))
      = LinearMap.lTensor V (comul (R := k) (A := H)) (coact (R := k) (C := H) v) := by
    have := congr($(Coalgebra.RightComodule.coassoc (R := k) (C := H) (M := V)) v)
    simpa using this
  have hmain : comul (R := k) (A := H) (comoduleCoeff χ v)
      = LinearMap.rTensor H (contractFst χ)
          (LinearMap.rTensor H (coact (R := k) (C := H)) (coact (R := k) (C := H) v)) := by
    rw [comoduleCoeff, comul_contractFst, ← hcoassoc]
    simp
  rw [mem_coinvLeft, hmain]
  nth_rewrite 1 [hsplit]
  rw [map_add, map_add, map_add, lTensorQuot_rTensor_contractFst_eq_zero, add_zero]
  simp only [LinearMap.rTensor_tmul]
  rw [lTensorQuot_tmul]
  simp [comoduleCoeff]

/-- A coefficient taken against a functional vanishing on `v` lies in the augmentation ideal of
the coinvariants `K(I)`, hence in `I`. -/
theorem comoduleCoeff_mem_augIdeal {I : Ideal H} {v : V} (hv : IsCoinvMod k I v)
    {χ : V →ₗ[k] k} (hχ : χ v = 0) :
    comoduleCoeff χ v ∈ augIdeal (coinvLeft (k := k) I : Subalgebra k H) :=
  Ideal.subset_span ⟨comoduleCoeff_mem_coinvLeft hv χ, by rw [counit_comoduleCoeff, hχ]⟩

/-- The antipode of such a coefficient also lies in `K(I)⁺H`, for a normal Hopf ideal. -/
theorem antipode_comoduleCoeff_mem_augIdeal {I : Ideal H} (hI : IsNormalHopfIdeal k I) {v : V}
    (hv : IsCoinvMod k I v) {χ : V →ₗ[k] k} (hχ : χ v = 0) :
    antipode k (comoduleCoeff χ v) ∈ augIdeal (coinvLeft (k := k) I : Subalgebra k H) := by
  refine Ideal.subset_span ⟨antipode_mem_coinvLeft I hI (comoduleCoeff_mem_coinvLeft hv χ), ?_⟩
  rw [show Coalgebra.counit (R := k) (A := H) (antipode k (comoduleCoeff χ v))
      = Coalgebra.counit (R := k) (A := H) (comoduleCoeff χ v) from
    HopfAlgebra.counit_antipode _, counit_comoduleCoeff, hχ]

/-- **The criterion of Takeuchi's Lemma 4.15.**  If a normal Hopf ideal `I` is contained in the
ideal generated by the coefficients — and the antipodes of the coefficients — of a single vector
`v` which is coinvariant modulo `I`, taken against the functionals vanishing on `v`, then
`I = K(I)⁺H`: the conclusion of the surjectivity half of Takeuchi's Theorem 4.3 holds for `I`. -/
theorem eq_augIdeal_coinv_of_coeff_span {I : Ideal H} (hI : IsNormalHopfIdeal k I) {v : V}
    (hv : IsCoinvMod k I v)
    (hspan : I ≤ Ideal.span {c : H | ∃ χ : V →ₗ[k] k, χ v = 0 ∧
      (c = comoduleCoeff χ v ∨ c = antipode k (comoduleCoeff χ v))}) :
    I = augIdeal (coinvOfIdeal (k := k) I) := by
  refine le_antisymm (hspan.trans (Ideal.span_le.2 ?_)) ?_
  · rintro c ⟨χ, hχ, rfl | rfl⟩
    · exact comoduleCoeff_mem_augIdeal hv hχ
    · exact antipode_comoduleCoeff_mem_augIdeal hI hv hχ
  · rw [coinvOfIdeal, augIdeal_eq_span]
    exact Ideal.span_le.2 fun x hx => coinv_augmentation_le I hx.1 hx.2

end Comod

end HopfAlgebra.Commutative
end
