module

public import Mathlib.RingTheory.HopfAlgebra.Basic
public import Hopf.Basic.IsSubHopfAlgebra

/-!
# Newman's correspondence: sub-Hopf algebras and left bi-ideals

Let `H` be a Hopf algebra over a field `k`.  Following Newman (*A correspondence between
bi-ideals and sub-Hopf algebras in cocommutative Hopf algebras*, J. Algebra **36** (1975)) we
study the two constructions

```
τ : K ↦ H K⁺          (the left ideal generated by the augmentation ideal of a sub-Hopf algebra)
μ : I ↦ H^{co H/I}    (Newman's `λ`-kernel: the elements with `Δ h ≡ h ⊗ 1` modulo `H ⊗ I`)
```

This file sets up the two sides of the correspondence and proves that `τ` and `μ` form a
*Galois connection* (an adjunction of posets)

```
τ K ≤ I  ↔  K ≤ μ I
```

for every sub-bialgebra `K` and every left ideal `I`.  Neither cocommutativity nor any flatness
input is needed for this: it is the Hopf-algebraic shadow of the categorical Galois connection
`Sub(H) ⇄ Quot(H)` between subobjects and equivariant quotients, whose construction does not
require the morphisms involved to be monic or epic — only *some* quasi-kernel and *some*
quasi-cokernel.

The two closure conditions `μ (τ K) = K` and `τ (μ I) = I`, which turn the adjunction into a
bijection, constitute Newman's theorem; they are not proved in this file.  They are proved for
every cocommutative Hopf algebra over a field in `Hopf/Cocommutative/Correspondence/Main.lean`
(`HopfAlgebra.Cocommutative.Correspondence.coinv_tau_eq`,
`HopfAlgebra.Cocommutative.Correspondence.tau_coinv_eq`).

## Main definitions

* `HopfAlgebra.Cocommutative.augPart K`: the augmentation part `K⁺ = K ∩ ker ε`;
* `HopfAlgebra.Cocommutative.tau K`: the left ideal `H K⁺` generated by `K⁺`;
* `HopfAlgebra.Cocommutative.coinv I`: Newman's `λ`-kernel `{h | Δ h - h ⊗ 1 ∈ H ⊗ I}`;
* `HopfAlgebra.Cocommutative.IsLeftBiIdeal I`: `I` is a left ideal and a two-sided coideal;
* `HopfAlgebra.IsSubHopfAlgebra k K`: the subalgebra `K` is closed under `Δ` and under the
  antipode.

## Main results

* `HopfAlgebra.Cocommutative.tau_le_iff_le_coinv`: the Galois connection;
* `HopfAlgebra.Cocommutative.le_coinv_tau`, `HopfAlgebra.Cocommutative.tau_coinv_le`: the two
  unit/counit inequalities.

## References

* [K. Newman, *A correspondence between bi-ideals and sub-Hopf algebras in cocommutative Hopf
  algebras*][Newman1975]
* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972]
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

namespace HopfAlgebra.Cocommutative

variable {k H : Type*} [CommRing k] [Ring H] [HopfAlgebra k H]

/-! ### Submodules of `H ⊗ H` -/

/-- The submodule `H ⊗ I` of `H ⊗ H`. -/
noncomputable def rightTensor (I : Submodule k H) : Submodule k (H ⊗[k] H) :=
  Submodule.map₂ (TensorProduct.mk k H H) ⊤ I

/-- The submodule `I ⊗ H` of `H ⊗ H`. -/
noncomputable def leftTensor (I : Submodule k H) : Submodule k (H ⊗[k] H) :=
  Submodule.map₂ (TensorProduct.mk k H H) I ⊤

/-- For `x ∈ I`, `h ⊗ x ∈ H ⊗ I`. -/
lemma tmul_mem_rightTensor {I : Submodule k H} (h : H) {x : H} (hx : x ∈ I) :
    h ⊗ₜ[k] x ∈ rightTensor I :=
  Submodule.apply_mem_map₂ _ Submodule.mem_top hx

/-- For `x ∈ I`, `x ⊗ h ∈ I ⊗ H`. -/
lemma tmul_mem_leftTensor {I : Submodule k H} {x : H} (hx : x ∈ I) (h : H) :
    x ⊗ₜ[k] h ∈ leftTensor I :=
  Submodule.apply_mem_map₂ _ hx Submodule.mem_top

/-- `rightTensor` is monotone: `I ≤ J` implies `H ⊗ I ≤ H ⊗ J`. -/
lemma rightTensor_mono {I J : Submodule k H} (h : I ≤ J) :
    rightTensor I ≤ rightTensor (k := k) J :=
  Submodule.map₂_le_map₂ le_rfl h

/-- `H ⊗ I ≤ P` as soon as `P` contains all `a ⊗ x` with `x ∈ I`. -/
lemma rightTensor_le {I : Submodule k H} {P : Submodule k (H ⊗[k] H)}
    (h : ∀ (a : H), ∀ x ∈ I, a ⊗ₜ[k] x ∈ P) : rightTensor I ≤ P :=
  Submodule.map₂_le.2 fun a _ x hx => h a x hx

/-- `I ⊗ H ≤ P` as soon as `P` contains all `x ⊗ a` with `x ∈ I`. -/
lemma leftTensor_le {I : Submodule k H} {P : Submodule k (H ⊗[k] H)}
    (h : ∀ x ∈ I, ∀ (a : H), x ⊗ₜ[k] a ∈ P) : leftTensor I ≤ P :=
  Submodule.map₂_le.2 fun x hx a _ => h x hx a

/-! ### The two sides of the correspondence -/

/-- The augmentation part `K⁺ = K ∩ ker ε` of a submodule. -/
def augPart (K : Submodule k H) : Submodule k H :=
  K ⊓ LinearMap.ker (counit (R := k) (A := H))

/-- `x ∈ K⁺ ↔ x ∈ K ∧ ε x = 0` (true by definition). -/
lemma mem_augPart {K : Submodule k H} {x : H} :
    x ∈ augPart K ↔ x ∈ K ∧ counit (R := k) x = 0 := Iff.rfl

/-- The left ideal `H K⁺` generated by the augmentation part of `K`. -/
noncomputable def tau (K : Submodule k H) : Submodule k H :=
  Submodule.map₂ (LinearMap.mul k H) ⊤ (augPart K)

/-- For `x ∈ K⁺`, `h x ∈ H K⁺`. -/
lemma mul_mem_tau {K : Submodule k H} (h : H) {x : H} (hx : x ∈ augPart K) :
    h * x ∈ tau K :=
  Submodule.apply_mem_map₂ _ Submodule.mem_top hx

/-- `K⁺ ≤ H K⁺`. -/
lemma augPart_le_tau {K : Submodule k H} : augPart K ≤ tau K := fun x hx => by
  simpa using mul_mem_tau 1 hx

/-- `H K⁺ ≤ I` as soon as `I` contains all `a x` with `x ∈ K⁺`. -/
lemma tau_le {K : Submodule k H} {I : Submodule k H}
    (h : ∀ (a : H), ∀ x ∈ augPart K, a * x ∈ I) : tau K ≤ I :=
  Submodule.map₂_le.2 fun a _ x hx => h a x hx

/-- `τ` is monotone: `K ≤ L` implies `H K⁺ ≤ H L⁺`. -/
lemma tau_mono {K L : Submodule k H} (h : K ≤ L) : tau K ≤ tau (k := k) L :=
  Submodule.map₂_le_map₂ le_rfl (inf_le_inf_right _ h)

/-- Newman's `λ`-kernel of `I`: the coinvariants `{h | Δ h - h ⊗ 1 ∈ H ⊗ I}`. -/
noncomputable def coinv (I : Submodule k H) : Submodule k H :=
  Submodule.comap (comul (R := k) (A := H) - (TensorProduct.mk k H H).flip 1) (rightTensor I)

/-- `h ∈ coinv I ↔ Δ h - h ⊗ 1 ∈ H ⊗ I` (true by definition). -/
lemma mem_coinv {I : Submodule k H} {h : H} :
    h ∈ coinv I ↔ comul (R := k) h - h ⊗ₜ[k] (1 : H) ∈ rightTensor I := Iff.rfl

/-- `coinv` is monotone: `I ≤ J` implies `coinv I ≤ coinv J`. -/
lemma coinv_mono {I J : Submodule k H} (h : I ≤ J) : coinv I ≤ coinv (k := k) J :=
  fun _ hx => rightTensor_mono h hx

/-! ### The structures -/

/-- A **left bi-ideal**: a left ideal which is a two-sided coideal. -/
structure IsLeftBiIdeal (I : Submodule k H) : Prop where
  /-- `I` is a left ideal. -/
  mul_mem : ∀ (h : H), ∀ x ∈ I, h * x ∈ I
  /-- `I` is contained in the kernel of the counit. -/
  counit_eq_zero : ∀ x ∈ I, counit (R := k) x = 0
  /-- `I` is a coideal: `Δ I ⊆ I ⊗ H + H ⊗ I`. -/
  comul_mem : ∀ x ∈ I, comul (R := k) x ∈ leftTensor I ⊔ rightTensor I

/-- A **sub-bialgebra**: a subalgebra closed under the comultiplication. -/
structure IsSubBialg (K : Subalgebra k H) : Prop where
  /-- `K` is a subcoalgebra. -/
  comul_mem : ∀ x ∈ K, comul (R := k) x ∈
    LinearMap.range (TensorProduct.mapIncl K.toSubmodule K.toSubmodule)

/-- A sub-Hopf algebra is a sub-bialgebra. -/
theorem _root_.HopfAlgebra.IsSubHopfAlgebra.toIsSubBialg {K : Subalgebra k H}
    (hK : IsSubHopfAlgebra k K) : IsSubBialg K :=
  ⟨hK.comul_mem⟩

/-! ### Two contractions -/

variable (k H) in
/-- The contraction `ε ⊗ id : H ⊗ H → H`. -/
noncomputable def epsLeft : H ⊗[k] H →ₗ[k] H :=
  (TensorProduct.lid k H).toLinearMap ∘ₗ LinearMap.rTensor H (counit (R := k) (A := H))

/-- `epsLeft (a ⊗ b) = ε(a) • b`. -/
@[simp] lemma epsLeft_tmul (a b : H) :
    epsLeft k H (a ⊗ₜ[k] b) = (counit (R := k) a) • b := by
  simp [epsLeft]

/-- The counit axiom: `(ε ⊗ id) (Δ h) = h`. -/
lemma epsLeft_comul (h : H) : epsLeft k H (comul (R := k) h) = h := by
  simp only [epsLeft, LinearMap.comp_apply, LinearEquiv.coe_coe]
  rw [show LinearMap.rTensor H (counit (R := k) (A := H)) (comul (R := k) h) = (1 : k) ⊗ₜ[k] h from
    congr($(rTensor_counit_comp_comul (R := k) (A := H)) h)]
  simp

/-- `ε ⊗ id` maps `H ⊗ I` into `I`. -/
lemma epsLeft_mem_of_mem_rightTensor {I : Submodule k H} {t : H ⊗[k] H}
    (ht : t ∈ rightTensor I) : epsLeft k H t ∈ I := by
  refine rightTensor_le (P := Submodule.comap (epsLeft k H) I) (fun a x hx => ?_) ht
  simpa using I.smul_mem _ hx

variable (k H) in
/-- The projection `π = id - 1 ∘ ε : H → H` onto the augmentation ideal. -/
noncomputable def augProj : H →ₗ[k] H :=
  LinearMap.id - (LinearMap.toSpanSingleton k H 1) ∘ₗ (counit (R := k) (A := H))

/-- `augProj x = x - ε(x) 1`. -/
@[simp] lemma augProj_apply (x : H) :
    augProj k H x = x - (counit (R := k) x) • (1 : H) := by
  simp [augProj]

/-- `(id ⊗ π) (Δ x) = Δ x - x ⊗ 1`. -/
lemma lTensor_augProj_comul (x : H) :
    LinearMap.lTensor H (augProj k H) (comul (R := k) x) = comul (R := k) x - x ⊗ₜ[k] (1 : H) := by
  have h1 : LinearMap.lTensor H (augProj k H)
      = LinearMap.id - LinearMap.lTensor H ((LinearMap.toSpanSingleton k H 1) ∘ₗ
        (counit (R := k) (A := H))) := by
    rw [augProj]; ext a b; simp
  rw [h1]
  simp only [LinearMap.sub_apply, LinearMap.id_apply, sub_right_inj]
  rw [LinearMap.lTensor_comp, LinearMap.comp_apply,
    show LinearMap.lTensor H (counit (R := k) (A := H)) (comul (R := k) x) = x ⊗ₜ[k] (1 : k) from
      congr($(lTensor_counit_comp_comul (R := k) (A := H)) x)]
  simp

/-! ### The Galois connection -/

/-- One half of the Galois connection: if `K ≤ μ I` then `K⁺ ≤ I`. -/
lemma augPart_le_of_le_coinv {K I : Submodule k H} (h : K ≤ coinv I) : augPart K ≤ I := by
  intro x hx
  have hx' : comul (R := k) x - x ⊗ₜ[k] (1 : H) ∈ rightTensor I := h hx.1
  have h2 := epsLeft_mem_of_mem_rightTensor hx'
  rwa [map_sub, epsLeft_comul, epsLeft_tmul, hx.2, zero_smul, sub_zero] at h2

/-- For a sub-bialgebra `K` and `x ∈ K`, the element `Δ x - x ⊗ 1` lies in `H ⊗ K⁺`. -/
lemma comul_sub_tmul_one_mem {K : Subalgebra k H} (hK : IsSubBialg K) {x : H} (hx : x ∈ K) :
    comul (R := k) x - x ⊗ₜ[k] (1 : H) ∈ rightTensor (augPart K.toSubmodule) := by
  rw [← lTensor_augProj_comul]
  have hle : LinearMap.range (TensorProduct.mapIncl K.toSubmodule K.toSubmodule)
      ≤ Submodule.comap (LinearMap.lTensor H (augProj k H))
        (rightTensor (augPart K.toSubmodule)) := by
    rw [TensorProduct.range_mapIncl]
    refine Submodule.map₂_le.2 fun a _ b hb => ?_
    simp only [Submodule.mem_comap, TensorProduct.mk_apply, LinearMap.lTensor_tmul, augProj_apply]
    refine tmul_mem_rightTensor _ ⟨K.toSubmodule.sub_mem hb
      (Submodule.smul_mem _ _ (by simp)), ?_⟩
    simp [Bialgebra.counit_one]
  exact hle (hK.comul_mem x hx)

/-- The other half of the Galois connection: for a sub-bialgebra `K`, if `K⁺ ≤ I` then
`K ≤ μ I`. -/
lemma le_coinv_of_augPart_le {K : Subalgebra k H} (hK : IsSubBialg K) {I : Submodule k H}
    (h : augPart K.toSubmodule ≤ I) : K.toSubmodule ≤ coinv I :=
  fun _ hx => rightTensor_mono h (comul_sub_tmul_one_mem hK hx)

/-- **The Galois connection.**  For a sub-bialgebra `K` and a left ideal `I`, the quasi-cokernel
`τ K = H K⁺` is contained in `I` if and only if `K` is contained in the quasi-kernel `μ I`. -/
theorem tau_le_iff_le_coinv {K : Subalgebra k H} (hK : IsSubBialg K) {I : Submodule k H}
    (hI : ∀ (h : H), ∀ x ∈ I, h * x ∈ I) :
    tau K.toSubmodule ≤ I ↔ K.toSubmodule ≤ coinv I := by
  refine ⟨fun h => le_coinv_of_augPart_le hK (le_trans augPart_le_tau h), fun h => ?_⟩
  exact tau_le fun a x hx => hI a x (augPart_le_of_le_coinv h hx)

/-- The unit of the Galois connection: `K ≤ μ (τ K)`. -/
lemma le_coinv_tau {K : Subalgebra k H} (hK : IsSubBialg K) :
    K.toSubmodule ≤ coinv (tau K.toSubmodule) :=
  le_coinv_of_augPart_le hK augPart_le_tau

/-- The counit of the Galois connection: `τ (μ I) ≤ I` for a left ideal `I`. -/
lemma tau_coinv_le {I : Submodule k H} (hI : ∀ (h : H), ∀ x ∈ I, h * x ∈ I) :
    tau (coinv I) ≤ I :=
  tau_le fun a x hx => hI a x (augPart_le_of_le_coinv (le_refl (coinv I)) hx)

/-- `τ K` is a left ideal. -/
lemma tau_isLeftIdeal (K : Submodule k H) (h : H) (x : H) (hx : x ∈ tau K) : h * x ∈ tau K := by
  have hle : tau K ≤ Submodule.comap (LinearMap.mulLeft k h) (tau K) := by
    refine Submodule.map₂_le.2 fun a _ y hy => ?_
    simpa [mul_assoc] using mul_mem_tau (K := K) (h * a) hy
  simpa using hle hx

/-! ### `τ K` is a left bi-ideal -/

/-- If `J` is a left ideal, then `H ⊗ J` is a left ideal of the ring `H ⊗ H`. -/
lemma mul_mem_rightTensor {J : Submodule k H} (hJ : ∀ (h : H), ∀ x ∈ J, h * x ∈ J)
    (w : H ⊗[k] H) {z : H ⊗[k] H} (hz : z ∈ rightTensor J) : w * z ∈ rightTensor J := by
  induction w using TensorProduct.inductionOn with
  | tmul u v =>
    have hle : rightTensor J
        ≤ Submodule.comap (LinearMap.mulLeft k (u ⊗ₜ[k] v)) (rightTensor J) := by
      refine rightTensor_le fun a y hy => ?_
      simp only [Submodule.mem_comap, LinearMap.mulLeft_apply, Algebra.TensorProduct.tmul_mul_tmul]
      exact tmul_mem_rightTensor _ (hJ v y hy)
    simpa using hle hz
  | add w1 w2 h1 h2 => rw [add_mul]; exact Submodule.add_mem _ h1 h2

/-- If `J` is a left ideal, then `J ⊗ H` is a left ideal of the ring `H ⊗ H`. -/
lemma mul_mem_leftTensor {J : Submodule k H} (hJ : ∀ (h : H), ∀ x ∈ J, h * x ∈ J)
    (w : H ⊗[k] H) {z : H ⊗[k] H} (hz : z ∈ leftTensor J) : w * z ∈ leftTensor J := by
  induction w using TensorProduct.inductionOn with
  | tmul u v =>
    have hle : leftTensor J ≤ Submodule.comap (LinearMap.mulLeft k (u ⊗ₜ[k] v)) (leftTensor J) := by
      refine leftTensor_le fun y hy a => ?_
      simp only [Submodule.mem_comap, LinearMap.mulLeft_apply, Algebra.TensorProduct.tmul_mul_tmul]
      exact tmul_mem_leftTensor (hJ u y hy) _
    simpa using hle hz
  | add w1 w2 h1 h2 => rw [add_mul]; exact Submodule.add_mem _ h1 h2

/-- The counit vanishes on `τ K = H K⁺`. -/
lemma counit_eq_zero_of_mem_tau (K : Submodule k H) (x : H) (hx : x ∈ tau K) :
    counit (R := k) x = 0 := by
  have hle : tau K ≤ LinearMap.ker (counit (R := k) (A := H)) :=
    tau_le fun a y hy => by
      have hy2 : counit (R := k) y = 0 := hy.2
      simp [LinearMap.mem_ker, Bialgebra.counit_mul, hy2]
  exact hle hx

/-- **The quasi-cokernel of a sub-bialgebra is a left bi-ideal**: `H K⁺` is a left ideal and a
two-sided coideal.  This is the well-definedness of the map `τ` of Newman's correspondence. -/
theorem isLeftBiIdeal_tau {K : Subalgebra k H} (hK : IsSubBialg K) :
    IsLeftBiIdeal (tau K.toSubmodule) where
  mul_mem := tau_isLeftIdeal _
  counit_eq_zero := counit_eq_zero_of_mem_tau _
  comul_mem := by
    intro x hx
    have hle : tau K.toSubmodule ≤ Submodule.comap (comul (R := k) (A := H))
        (leftTensor (tau K.toSubmodule) ⊔ rightTensor (tau K.toSubmodule)) := by
      refine tau_le fun a y hy => ?_
      simp only [Submodule.mem_comap]
      rw [Bialgebra.comul_mul]
      have h1 : comul (R := k) y = y ⊗ₜ[k] (1 : H) + (comul (R := k) y - y ⊗ₜ[k] (1 : H)) := by
        abel
      rw [h1, mul_add]
      refine Submodule.add_mem _ (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right ?_)
      · exact mul_mem_leftTensor (tau_isLeftIdeal _) _
          (tmul_mem_leftTensor (augPart_le_tau hy) 1)
      · exact mul_mem_rightTensor (tau_isLeftIdeal _) _
          (rightTensor_mono augPart_le_tau (comul_sub_tmul_one_mem hK hy.1))
    exact hle hx

/-! ### `μ I` is a subalgebra -/

/-- Right multiplication by `y ⊗ 1` preserves `H ⊗ I`. -/
lemma mul_tmul_one_mem_rightTensor {J : Submodule k H}
    (y : H) {z : H ⊗[k] H} (hz : z ∈ rightTensor J) : z * (y ⊗ₜ[k] (1 : H)) ∈ rightTensor J := by
  have hle : rightTensor J
      ≤ Submodule.comap (LinearMap.mulRight k (y ⊗ₜ[k] (1 : H))) (rightTensor J) := by
    refine rightTensor_le fun a x hx => ?_
    simp only [Submodule.mem_comap, LinearMap.mulRight_apply,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    exact tmul_mem_rightTensor _ hx
  simpa using hle hz

/-- `1 ∈ μ I`. -/
lemma one_mem_coinv (I : Submodule k H) : (1 : H) ∈ coinv I := by
  have : comul (R := k) (1 : H) - (1 : H) ⊗ₜ[k] (1 : H) = 0 := by
    rw [Bialgebra.comul_one, Algebra.TensorProduct.one_def, sub_self]
  rw [mem_coinv, this]
  exact Submodule.zero_mem _

/-- **`μ I` is closed under multiplication** whenever `I` is a left ideal.  No cocommutativity is
needed. -/
lemma mul_mem_coinv {I : Submodule k H} (hI : ∀ (h : H), ∀ x ∈ I, h * x ∈ I) {x y : H}
    (hx : x ∈ coinv I) (hy : y ∈ coinv I) : x * y ∈ coinv I := by
  rw [mem_coinv, Bialgebra.comul_mul]
  have hsplit : comul (R := k) x * comul (R := k) y - (x * y) ⊗ₜ[k] (1 : H)
      = comul (R := k) x * (comul (R := k) y - y ⊗ₜ[k] (1 : H))
        + (comul (R := k) x - x ⊗ₜ[k] (1 : H)) * (y ⊗ₜ[k] (1 : H)) := by
    rw [mul_sub, sub_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    abel
  rw [hsplit]
  exact Submodule.add_mem _ (mul_mem_rightTensor hI _ hy)
    (mul_tmul_one_mem_rightTensor _ hx)

/-- **The `λ`-kernel of a left ideal is a subalgebra**: this is the well-definedness of the map
`μ` of Newman's correspondence on the algebra level.  Cocommutativity is not needed. -/
noncomputable def coinvSubalgebra {I : Submodule k H} (hI : ∀ (h : H), ∀ x ∈ I, h * x ∈ I) :
    Subalgebra k H where
  carrier := (coinv I : Set H)
  mul_mem' hx hy := mul_mem_coinv hI hx hy
  add_mem' hx hy := Submodule.add_mem _ hx hy
  zero_mem' := Submodule.zero_mem _
  one_mem' := one_mem_coinv I
  algebraMap_mem' c := by
    have := (coinv I).smul_mem c (one_mem_coinv I)
    simpa [Algebra.algebraMap_eq_smul_one] using this

/-- The underlying subspace of `coinvSubalgebra hI` is `coinv I`. -/
@[simp] lemma coinvSubalgebra_toSubmodule {I : Submodule k H}
    (hI : ∀ (h : H), ∀ x ∈ I, h * x ∈ I) :
    (coinvSubalgebra hI).toSubmodule = coinv I := rfl

/-! ### The two sides as types -/

variable (k H) in
/-- The type of sub-Hopf algebras of `H`. -/
structure SubHopfAlg where
  /-- the underlying subalgebra -/
  carrier : Subalgebra k H
  /-- it is closed under the comultiplication and the antipode -/
  isSubHopf : IsSubHopfAlgebra k carrier

variable (k H) in
/-- The type of left bi-ideals of `H`. -/
structure LeftBiIdeal where
  /-- the underlying subspace -/
  carrier : Submodule k H
  /-- it is a left ideal and a two-sided coideal -/
  isLeftBiIdeal : IsLeftBiIdeal carrier

namespace SubHopfAlg

/-- Two sub-Hopf algebras with the same underlying subalgebra are equal. -/
@[ext] lemma ext {K L : SubHopfAlg k H} (h : K.carrier = L.carrier) : K = L := by
  cases K; cases L; simp_all

end SubHopfAlg

namespace LeftBiIdeal

/-- Two left bi-ideals with the same underlying subspace are equal. -/
@[ext] lemma ext {I J : LeftBiIdeal k H} (h : I.carrier = J.carrier) : I = J := by
  cases I; cases J; simp_all

end LeftBiIdeal

/-- The quasi-cokernel map `τ : K ↦ H K⁺` from sub-Hopf algebras to left bi-ideals. -/
noncomputable def tauMap (K : SubHopfAlg k H) : LeftBiIdeal k H :=
  ⟨tau K.carrier.toSubmodule, isLeftBiIdeal_tau K.isSubHopf.toIsSubBialg⟩

/-- The underlying subspace of `tauMap K` is `H K⁺`. -/
@[simp] lemma tauMap_carrier (K : SubHopfAlg k H) :
    (tauMap K).carrier = tau K.carrier.toSubmodule := rfl

end HopfAlgebra.Cocommutative
