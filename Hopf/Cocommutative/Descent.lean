module

public import Foundations.RingTheory.AbsFlatClass
public import Hopf.Cocommutative.HopfBiIdeal
public import Hopf.Cocommutative.BiIdealQuotient
public import Hopf.Cocommutative.CoinvSubcoalgebra

/-!
# Descent for Newman's correspondence: `μ (τ K) = K`

Let `H` be a Hopf algebra over a field `k` and `K ⊆ H` a sub-bialgebra, with
`I = τ K = H K⁺` the associated left bi-ideal and `π : H ↠ H ⧸ I` the coset quotient.
Newman's correspondence needs the closure identity `μ (τ K) = K`, i.e. that the coinvariants
of the quotient coalgebra `H ⧸ H K⁺` are exactly `K`.  The Galois connection of
`Hopf/Cocommutative/HopfBiIdeal.lean` gives `K ≤ μ (τ K)` unconditionally; the converse is
the descent statement, and this file isolates exactly what it needs.

The two inputs are the classical ones of Hopf–Galois theory, phrased concretely:

* the **Galois map** `β : H ⊗ H → H ⊗ (H ⧸ I)`, `x ⊗ y ↦ ∑ x₁ y ⊗ π x₂`
  (`HopfAlgebra.Cocommutative.gal`), which kills the `K`-balanced relations `x a ⊗ y - x ⊗ a y`
  (`HopfAlgebra.Cocommutative.balRel_le_ker_gal`), so that it descends to a map
  `H ⊗_K H → H ⊗ (H ⧸ I)`; the hypothesis is that this descended map is *injective*, i.e.
  `ker β ≤ balRel K`;
* **descent along `K ⊆ H`**: an element `h` with `h ⊗ 1 = 1 ⊗ h` in `H ⊗_K H` lies in `K`.
  `HopfAlgebra.Cocommutative.descent_of_retraction` proves this whenever `K` is a direct summand of
  `H` as a right `K`-module (in particular whenever `H` is free as a right `K`-module on a basis
  containing `1`), which is the elementary shadow of faithful flatness.

## Main results

* `HopfAlgebra.Cocommutative.gal`, `HopfAlgebra.Cocommutative.balRel` — the Galois map and the
  balanced relations;
* `HopfAlgebra.Cocommutative.balRel_le_ker_gal` — the Galois map is `K`-balanced;
* `HopfAlgebra.Cocommutative.gal_tmul_one`, `HopfAlgebra.Cocommutative.gal_one_tmul` —
  `β (h ⊗ 1) = ρ h` and `β (1 ⊗ h) = h ⊗ π 1`, so that `h` is a coinvariant exactly when
  `β (h ⊗ 1 - 1 ⊗ h) = 0`;
* `HopfAlgebra.Cocommutative.descent_of_retraction` — descent from a right `K`-linear retraction
  `H ↠ K`;
* `HopfAlgebra.Cocommutative.coinv_tau_eq_of_ker_gal_le_of_descent` — **the closure identity**
  `μ (τ K) = K` from injectivity of the descended Galois map together with descent.

## References

* [K. Newman, *A correspondence between bi-ideals and sub-Hopf algebras in cocommutative Hopf
  algebras*][Newman1975]
* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972]
* [S. U. Chase, M. E. Sweedler, *Hopf algebras and Galois theory*][chaseHopfAlgebrasGalois1969]
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra

namespace HopfAlgebra.Cocommutative

variable {k H : Type*} [CommRing k] [Ring H] [HopfAlgebra k H]

/-! ### The balanced relations -/

/-- The submodule of `H ⊗ H` generated by the `K`-balanced relations `x a ⊗ y - x ⊗ a y`
(`a ∈ K`).  The quotient `(H ⊗ H) ⧸ balRel K` is the tensor product `H ⊗_K H` over the
(possibly noncommutative) subalgebra `K`. -/
def balRel (K : Submodule k H) : Submodule k (H ⊗[k] H) :=
  Submodule.span k {t | ∃ x y a : H, a ∈ K ∧ t = (x * a) ⊗ₜ[k] y - x ⊗ₜ[k] (a * y)}

/-- The generators `x a ⊗ y - x ⊗ a y` (`a ∈ K`) lie in `balRel K`. -/
lemma sub_mem_balRel {K : Submodule k H} (x y : H) {a : H} (ha : a ∈ K) :
    (x * a) ⊗ₜ[k] y - x ⊗ₜ[k] (a * y) ∈ balRel K :=
  Submodule.subset_span ⟨x, y, a, ha, rfl⟩

/-- `balRel K ≤ P` as soon as `P` contains all the `x a ⊗ y - x ⊗ a y` with `a ∈ K`. -/
lemma balRel_le {K : Submodule k H} {P : Submodule k (H ⊗[k] H)}
    (h : ∀ (x y : H), ∀ a ∈ K, (x * a) ⊗ₜ[k] y - x ⊗ₜ[k] (a * y) ∈ P) : balRel K ≤ P := by
  refine Submodule.span_le.2 ?_
  rintro t ⟨x, y, a, ha, rfl⟩
  exact h x y a ha

/-! ### The Galois map -/

section Gal

variable (I : Submodule k H)

/-- The second half of the Galois map: `(x ⊗ v) ⊗ y ↦ x y ⊗ v`. -/
noncomputable def galCore : (H ⊗[k] (H ⧸ I)) ⊗[k] H →ₗ[k] H ⊗[k] (H ⧸ I) :=
  TensorProduct.map (LinearMap.mul' k H) LinearMap.id
    ∘ₗ (TensorProduct.assoc k H H (H ⧸ I)).symm.toLinearMap
    ∘ₗ TensorProduct.map LinearMap.id (TensorProduct.comm k (H ⧸ I) H).toLinearMap
    ∘ₗ (TensorProduct.assoc k H (H ⧸ I) H).toLinearMap

/-- `galCore I (t ⊗ y) = ((· * y) ⊗ id) t`. -/
lemma galCore_tmul (t : H ⊗[k] (H ⧸ I)) (y : H) :
    galCore I (t ⊗ₜ[k] y) = LinearMap.rTensor (H ⧸ I) ((LinearMap.mul k H).flip y) t := by
  induction t using TensorProduct.inductionOn with
  | tmul a v => simp [galCore]
  | add u v hu hv => rw [add_tmul, map_add, map_add, hu, hv]

/-- The **Galois map** `β : H ⊗ H → H ⊗ (H ⧸ I)`, `x ⊗ y ↦ ∑ x₁ y ⊗ π x₂`. -/
noncomputable def gal : H ⊗[k] H →ₗ[k] H ⊗[k] (H ⧸ I) :=
  galCore I ∘ₗ TensorProduct.map (coact I) LinearMap.id

/-- `gal I (x ⊗ y) = ((· * y) ⊗ id) (coact I x)`. -/
lemma gal_tmul (x y : H) :
    gal I (x ⊗ₜ[k] y) = LinearMap.rTensor (H ⧸ I) ((LinearMap.mul k H).flip y) (coact I x) := by
  simp [gal, galCore_tmul]

/-- `gal I (x ⊗ y) = ∑ x₁ y ⊗ π x₂`, written as `((· * y) ⊗ π) (Δ x)`. -/
lemma gal_tmul_eq_map (x y : H) :
    gal I (x ⊗ₜ[k] y)
      = TensorProduct.map ((LinearMap.mul k H).flip y) I.mkQ (comul (R := k) x) := by
  rw [gal_tmul, coact, LinearMap.comp_apply, ← LinearMap.comp_apply,
    LinearMap.rTensor_comp_lTensor]

/-- `gal I (h ⊗ 1) = coact I h`. -/
lemma gal_tmul_one (h : H) : gal I (h ⊗ₜ[k] (1 : H)) = coact I h := by
  rw [gal_tmul]
  have : ((LinearMap.mul k H).flip (1 : H)) = LinearMap.id (R := k) (M := H) := by
    ext x; simp
  rw [this, LinearMap.rTensor_id]
  rfl

/-- `gal I (1 ⊗ h) = h ⊗ π 1`. -/
lemma gal_one_tmul (h : H) : gal I ((1 : H) ⊗ₜ[k] h) = h ⊗ₜ[k] I.mkQ (1 : H) := by
  rw [gal_tmul_eq_map]
  simp [Bialgebra.comul_one, Algebra.TensorProduct.one_def]

/-- `h` is a coinvariant exactly when the Galois map identifies `h ⊗ 1` with `1 ⊗ h`. -/
lemma mem_coinv_iff_gal (h : H) :
    h ∈ coinv I ↔ gal I (h ⊗ₜ[k] (1 : H) - (1 : H) ⊗ₜ[k] h) = 0 := by
  rw [map_sub, gal_tmul_one, gal_one_tmul, sub_eq_zero]
  exact ⟨fun hh => coact_apply_of_mem_coinv I hh, fun hh => (mem_coinv_iff_lTensor_mkQ I h).2 hh⟩

end Gal

/-! ### The Galois map is balanced -/

section Balanced

variable {K : Subalgebra k H}

/-- The auxiliary map `w ↦ (·y ⊗ π) (Δ x · w)` used to prove that the Galois map is
`K`-balanced. -/
noncomputable def galAux (I : Submodule k H) (x y : H) : H ⊗[k] H →ₗ[k] H ⊗[k] (H ⧸ I) :=
  TensorProduct.map ((LinearMap.mul k H).flip y) I.mkQ ∘ₗ
    LinearMap.mulLeft k (comul (R := k) x)

/-- `galAux I x y (Δ a) = gal I ((x * a) ⊗ y)`. -/
lemma galAux_comul (I : Submodule k H) (x y a : H) :
    galAux I x y (comul (R := k) a) = gal I ((x * a) ⊗ₜ[k] y) := by
  rw [galAux, gal_tmul_eq_map, LinearMap.comp_apply, LinearMap.mulLeft_apply,
    ← Bialgebra.comul_mul]

/-- `galAux I x y (a ⊗ 1) = gal I (x ⊗ (a * y))`. -/
lemma galAux_tmul_one (I : Submodule k H) (x y a : H) :
    galAux I x y (a ⊗ₜ[k] (1 : H)) = gal I (x ⊗ₜ[k] (a * y)) := by
  rw [galAux, gal_tmul_eq_map, LinearMap.comp_apply, LinearMap.mulLeft_apply]
  induction (comul (R := k) x) using TensorProduct.inductionOn with
  | tmul u v => simp [Algebra.TensorProduct.tmul_mul_tmul, mul_assoc]
  | add s t hs ht => rw [add_mul, map_add, map_add, hs, ht]

/-- If `I` is closed under left multiplication by `H`, then `galAux I x y` vanishes on
`H ⊗ I`. -/
lemma galAux_apply_eq_zero_of_mem_rightTensor {I : Submodule k H}
    (hI : ∀ (h : H), ∀ z ∈ I, h * z ∈ I) (x y : H) {w : H ⊗[k] H} (hw : w ∈ rightTensor I) :
    galAux I x y w = 0 := by
  have hle : rightTensor I ≤ LinearMap.ker (galAux I x y) := by
    refine rightTensor_le fun u z hz => ?_
    rw [LinearMap.mem_ker, galAux, LinearMap.comp_apply, LinearMap.mulLeft_apply]
    induction (comul (R := k) x) using TensorProduct.inductionOn with
    | tmul c d =>
      simp only [Algebra.TensorProduct.tmul_mul_tmul, TensorProduct.map_tmul]
      rw [show I.mkQ (d * z) = 0 from (Submodule.Quotient.mk_eq_zero I).2 (hI d z hz)]
      simp
    | add s t hs ht => rw [add_mul, map_add, hs, ht, add_zero]
  exact hle hw

/-- The Galois map is `K`-balanced: it kills the relations `x a ⊗ y - x ⊗ a y` for `a ∈ K`,
so it descends to a linear map `H ⊗_K H → H ⊗ (H ⧸ τ K)`. -/
theorem balRel_le_ker_gal (hK : IsSubBialg K) :
    balRel K.toSubmodule ≤ LinearMap.ker (gal (tau K.toSubmodule)) := by
  refine balRel_le fun x y a ha => ?_
  set I := tau K.toSubmodule with hI
  have hmem : comul (R := k) a - a ⊗ₜ[k] (1 : H) ∈ rightTensor I := le_coinv_tau hK ha
  have hzero := galAux_apply_eq_zero_of_mem_rightTensor
    (I := I) (tau_isLeftIdeal _) x y hmem
  rw [map_sub, galAux_comul, galAux_tmul_one, sub_eq_zero] at hzero
  rw [LinearMap.mem_ker, map_sub, hzero, sub_self]

end Balanced

/-! ### Descent from a retraction -/

/-- **Descent along a split extension.**  If `K` is a direct summand of `H` as a right
`K`-module — i.e. there is a `k`-linear map `p : H → K` restricting to the identity on `K` and
satisfying `p (x a) = p x * a` for `a ∈ K` — then an element `h` with `h ⊗ 1 = 1 ⊗ h` in
`H ⊗_K H` already lies in `K`.  This is the elementary form of faithfully flat descent, and it
applies whenever `H` is free as a right `K`-module on a basis containing `1`. -/
theorem descent_of_retraction (K : Subalgebra k H) (p : H →ₗ[k] H)
    (hpmem : ∀ x : H, p x ∈ K) (hpid : ∀ a ∈ K, p a = a)
    (hpsemi : ∀ (x : H), ∀ a ∈ K, p (x * a) = p x * a) {h : H}
    (hh : h ⊗ₜ[k] (1 : H) - (1 : H) ⊗ₜ[k] h ∈ balRel K.toSubmodule) : h ∈ K := by
  set F : H ⊗[k] H →ₗ[k] H :=
    TensorProduct.lift ((LinearMap.mul k H) ∘ₗ p) with hF
  have hFtmul : ∀ x y : H, F (x ⊗ₜ[k] y) = p x * y := fun x y => rfl
  have hker : balRel K.toSubmodule ≤ LinearMap.ker F := by
    refine balRel_le fun x y a ha => ?_
    rw [LinearMap.mem_ker, map_sub, hFtmul, hFtmul, hpsemi x a ha, mul_assoc, sub_self]
  have h0 : F (h ⊗ₜ[k] (1 : H) - (1 : H) ⊗ₜ[k] h) = 0 := hker hh
  rw [map_sub, hFtmul, hFtmul, hpid 1 K.one_mem, mul_one, one_mul, sub_eq_zero] at h0
  exact h0 ▸ hpmem h

/-! ### The closure identity -/

/-- **The closure identity `μ (τ K) = K`** for a sub-bialgebra `K`, from the two descent inputs:
injectivity of the descended Galois map `H ⊗_K H → H ⊗ (H ⧸ τ K)` and descent along
`K ⊆ H`. -/
theorem coinv_tau_eq_of_ker_gal_le_of_descent {K : Subalgebra k H} (hK : IsSubBialg K)
    (hinj : LinearMap.ker (gal (tau K.toSubmodule)) ≤ balRel K.toSubmodule)
    (hdesc : ∀ h : H, h ⊗ₜ[k] (1 : H) - (1 : H) ⊗ₜ[k] h ∈ balRel K.toSubmodule → h ∈ K) :
    coinv (tau K.toSubmodule) = K.toSubmodule := by
  refine le_antisymm (fun h hh => ?_) (le_coinv_tau hK)
  exact hdesc h (hinj ((mem_coinv_iff_gal _ h).1 hh))

end HopfAlgebra.Cocommutative
