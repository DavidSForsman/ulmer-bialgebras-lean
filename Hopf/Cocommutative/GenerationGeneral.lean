module

public import Foundations.RingTheory.AbsFlatClass
public import Hopf.Cocommutative.GaloisSurjective

/-!
# The generation input of Newman's correspondence, for an arbitrary sub-Hopf algebra

Let `H` be a cocommutative Hopf algebra over a field `k` and let `K ⊆ H` be a sub-Hopf algebra.
`Hopf/Cocommutative/GaloisSurjective.lean` reduces Newman's closure identity `μ (τ K) = K` to
two independent inputs:

* **generation**: `H ⊗ H K⁺ ⊆ α (balRel K)`, where `α : x ⊗ y ↦ ∑ x₁ y ⊗ x₂` is the un-quotiented
  Galois map and `balRel K` is the submodule of `K`-balanced relations;
* **descent**: `h ⊗ 1 - 1 ⊗ h ∈ balRel K → h ∈ K`.

Previously the generation input was proved only for sub-bialgebras generated by group-like and
primitive elements.  This file proves it for an **arbitrary** sub-Hopf algebra of a cocommutative
Hopf algebra.

The computation is short.  Writing `α (x ⊗ y) = Δ x · (y ⊗ 1)` (a product in the ring `H ⊗ H`),
the balanced element

```
∑ (w S(a₁)) a₂ ⊗ v - (w S(a₁)) ⊗ a₂ v          (a ∈ K)
```

lies in `balRel K` because `a₂ ∈ K`, and its Galois image is

```
α (w ⊗ v) · (1 ⊗ (ε(a) 1 - S a)) .
```

Indeed the first summand contracts to `ε(a) w ⊗ v` by the antipode axiom, and the second is
`Δ w · (∑ Δ(S a₁) (a₂ ⊗ 1)) · (v ⊗ 1)`, whose middle factor is `1 ⊗ S a` — the convolution
identity `(Δ ∘ S) ⋆ L = SR` of `Hopf/Cocommutative/CoinvAntipode.lean`, valid in any Hopf
algebra.  Since `α` is bijective for a cocommutative `H`, the elements `α (w ⊗ v)` span `H ⊗ H`,
so `H ⊗ H (ε(a) 1 - S a) ⊆ α (balRel K)` for every `a ∈ K`; and as `K` is stable under the
antipode and `S² = id`, the elements `ε(a) 1 - S a` exhaust `K⁺`.

## Main results

* `HopfAlgebra.Cocommutative.galFull_balMap_comul` — the Galois image of the balanced element above;
* `HopfAlgebra.Cocommutative.rightTensor_tau_le_map_galFull` — **the generation input**, for every
  sub-Hopf algebra of a cocommutative Hopf algebra;
* `HopfAlgebra.Cocommutative.ker_gal_tau_eq_balRel` — equivalently, `ker β = balRel K`: the
  descended Galois map `H ⊗_K H → H ⊗ (H ⧸ H K⁺)` is *bijective*, i.e. `K ⊆ H` is a Hopf–Galois
  extension;
* `HopfAlgebra.Cocommutative.coinv_tau_eq_of_descent` — Newman's closure identity `μ (τ K) = K` for
  an arbitrary sub-Hopf algebra, assuming only descent along `K ⊆ H`.

## References

* [S. U. Chase, M. E. Sweedler, *Hopf algebras and Galois theory*][chaseHopfAlgebrasGalois1969]
* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972]
* [K. Newman, *A correspondence between bi-ideals and sub-Hopf algebras in cocommutative Hopf
  algebras*][Newman1975]
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra WithConv

namespace HopfAlgebra.Cocommutative

variable {k H : Type*} [CommRing k] [Ring H] [HopfAlgebra k H]

/-! ### The Galois map as a product in the ring `H ⊗ H` -/

/-- `α (x ⊗ y) = Δ x · (y ⊗ 1)`. -/
lemma galFull_tmul_eq_mul (x y : H) :
    galFull k H (x ⊗ₜ[k] y) = comul (R := k) x * (y ⊗ₜ[k] (1 : H)) := by
  classical
  rw [galFull_tmul_repr _ _ (ℛ k x), ← (ℛ k x).eq, Finset.sum_mul]
  exact Finset.sum_congr rfl fun i _ => by
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]

/-! ### The convolution identity `(Δ ∘ S) ⋆ L = SR` -/

/-- `(Δ ∘ S) ⋆ L = SR` in the convolution monoid of `H → H ⊗ H`: no cocommutativity is needed. -/
lemma comul_antipode_convMul_convL :
    toConv ((comul (R := k) (A := H)) ∘ₗ (antipode k : H →ₗ[k] H)) * convL k H = convSR k H := by
  rw [comul_comp_antipode_conv, mul_assoc, convSL_convMul_convL, mul_one]

/-- The Sweedler form of the identity above: `∑ Δ(S a₁) · (a₂ ⊗ 1) = 1 ⊗ S a`. -/
lemma sum_comul_antipode_tmul (a : H) {J : Type*} (r : Coalgebra.Repr k a J) :
    ∑ i ∈ r.index, comul (R := k) (antipode k (r.left i)) * (r.right i ⊗ₜ[k] (1 : H))
      = (1 : H) ⊗ₜ[k] antipode k a := by
  have h := congr(WithConv.ofConv $(comul_antipode_convMul_convL (k := k) (H := H)) a)
  rw [conv_apply _ _ a r] at h
  simpa only [convL_apply, convSR_apply, LinearMap.coe_comp, Function.comp_apply] using h

/-! ### The balanced element attached to `a ∈ K` -/

variable (k) in
/-- The linear map `b ⊗ c ↦ (w S(b)) c ⊗ v - (w S(b)) ⊗ c v`.  Applied to `Δ a` it produces a
`K`-balanced relation whenever `Δ a ∈ H ⊗ K`. -/
noncomputable def balMap (w v : H) : H ⊗[k] H →ₗ[k] H ⊗[k] H :=
  ((TensorProduct.mk k H H).flip v) ∘ₗ LinearMap.mul' k H ∘ₗ
      TensorProduct.map (LinearMap.mul k H w ∘ₗ (antipode k : H →ₗ[k] H)) LinearMap.id
    - TensorProduct.map (LinearMap.mul k H w ∘ₗ (antipode k : H →ₗ[k] H))
        ((LinearMap.mul k H).flip v)

/-- `balMap w v (b ⊗ c) = (w S(b)) c ⊗ v - (w S(b)) ⊗ c v`. -/
@[simp] lemma balMap_tmul (w v b c : H) :
    balMap k w v (b ⊗ₜ[k] c)
      = (w * antipode k b * c) ⊗ₜ[k] v - (w * antipode k b) ⊗ₜ[k] (c * v) := by
  simp [balMap]

/-- The balanced elements really are balanced: `balMap w v` carries `H ⊗ K` into `balRel K`. -/
lemma balMap_rightTensor_le (K : Submodule k H) (w v : H) :
    Submodule.map (balMap k w v) (rightTensor K) ≤ balRel K := by
  rw [Submodule.map_le_iff_le_comap]
  refine rightTensor_le fun b c hc => ?_
  simp only [Submodule.mem_comap, balMap_tmul]
  exact sub_mem_balRel _ _ hc

/-- **The Galois image of the balanced element**: `α (balMap w v (Δ a)) = α (w ⊗ v) ·
(1 ⊗ (ε(a) 1 - S a))`. -/
theorem galFull_balMap_comul (w v a : H) :
    galFull k H (balMap k w v (comul (R := k) a))
      = galFull k H (w ⊗ₜ[k] v) * ((1 : H) ⊗ₜ[k] (counit (R := k) a • (1 : H) - antipode k a)) := by
  classical
  set r := ℛ k a with hr
  have hcomul : comul (R := k) a = ∑ i ∈ r.index, r.left i ⊗ₜ[k] r.right i := (r.eq).symm
  -- split each summand into the two pieces
  have hsplit : ∀ i ∈ r.index, galFull k H (balMap k w v (r.left i ⊗ₜ[k] r.right i))
      = comul (R := k) (w * (antipode k (r.left i) * r.right i)) * (v ⊗ₜ[k] (1 : H))
        - comul (R := k) w *
            (comul (R := k) (antipode k (r.left i)) * (r.right i ⊗ₜ[k] (1 : H)))
            * (v ⊗ₜ[k] (1 : H)) := by
    intro i _
    rw [balMap_tmul, map_sub, galFull_tmul_eq_mul, galFull_tmul_eq_mul, mul_assoc w]
    congr 1
    have hc : ((r.right i * v) ⊗ₜ[k] (1 : H) : H ⊗[k] H)
        = (r.right i ⊗ₜ[k] (1 : H)) * (v ⊗ₜ[k] (1 : H)) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
    rw [hc, Bialgebra.comul_mul]
    simp only [mul_assoc]
  rw [hcomul, map_sum, map_sum, Finset.sum_congr rfl hsplit, Finset.sum_sub_distrib]
  -- the first piece contracts by the antipode axiom
  have h1 : ∑ i ∈ r.index,
      comul (R := k) (w * (antipode k (r.left i) * r.right i)) * (v ⊗ₜ[k] (1 : H))
      = (counit (R := k) a) • (comul (R := k) w * (v ⊗ₜ[k] (1 : H))) := by
    rw [← Finset.sum_mul, ← map_sum, ← Finset.mul_sum, HopfAlgebra.sum_antipode_mul_eq_smul r,
      mul_smul_comm, mul_one, map_smul, smul_mul_assoc]
  -- the second piece is the convolution identity
  have h2 : ∑ i ∈ r.index, comul (R := k) w *
        (comul (R := k) (antipode k (r.left i)) * (r.right i ⊗ₜ[k] (1 : H)))
        * (v ⊗ₜ[k] (1 : H))
      = comul (R := k) w * ((1 : H) ⊗ₜ[k] antipode k a) * (v ⊗ₜ[k] (1 : H)) := by
    rw [← Finset.sum_mul, ← Finset.mul_sum, sum_comul_antipode_tmul a r]
  have hA : comul (R := k) w * (v ⊗ₜ[k] (1 : H))
        * ((1 : H) ⊗ₜ[k] (counit (R := k) a • (1 : H)))
      = (counit (R := k) a) • (comul (R := k) w * (v ⊗ₜ[k] (1 : H))) := by
    rw [mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
      TensorProduct.tmul_smul, mul_smul_comm]
  have hB : comul (R := k) w * (v ⊗ₜ[k] (1 : H)) * ((1 : H) ⊗ₜ[k] antipode k a)
      = comul (R := k) w * ((1 : H) ⊗ₜ[k] antipode k a) * (v ⊗ₜ[k] (1 : H)) := by
    rw [mul_assoc, mul_assoc, Algebra.TensorProduct.tmul_mul_tmul,
      Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, one_mul, mul_one]
  rw [h1, h2, galFull_tmul_eq_mul, TensorProduct.tmul_sub, mul_sub, hA, hB]

/-! ### The generation input -/

section Cocomm

variable [Coalgebra.IsCocomm k H]

/-- For `a` in a sub-bialgebra `K` and an arbitrary `t ∈ H ⊗ H`, the element
`t · (1 ⊗ (ε(a) 1 - S a))` is the Galois image of a `K`-balanced relation. -/
theorem mul_mem_map_galFull {K : Subalgebra k H} (hK : IsSubBialg K) {a : H} (ha : a ∈ K)
    (t : H ⊗[k] H) :
    t * ((1 : H) ⊗ₜ[k] (counit (R := k) a • (1 : H) - antipode k a))
      ∈ Submodule.map (galFull k H) (balRel K.toSubmodule) := by
  have hcomul : comul (R := k) a ∈ rightTensor K.toSubmodule := by
    have hle : LinearMap.range (TensorProduct.mapIncl K.toSubmodule K.toSubmodule)
        ≤ rightTensor K.toSubmodule := by
      rw [TensorProduct.range_mapIncl]
      exact Submodule.map₂_le.2 fun b _ c hc => tmul_mem_rightTensor _ hc
    exact hle (hK.comul_mem a ha)
  obtain ⟨u, rfl⟩ := galFull_bijective.2 t
  induction u using TensorProduct.inductionOn with
  | tmul w v =>
    refine ⟨balMap k w v (comul (R := k) a), ?_, ?_⟩
    · exact balMap_rightTensor_le K.toSubmodule w v ⟨_, hcomul, rfl⟩
    · exact galFull_balMap_comul w v a
  | add p q hp hq =>
    rw [map_add, add_mul]
    exact Submodule.add_mem _ hp hq

/-- **The generation input of Newman's correspondence, in general**: for every sub-Hopf algebra
`K` of a cocommutative Hopf algebra `H`, the image under the Galois map `α` of the `K`-balanced
relations contains `H ⊗ H K⁺`. -/
theorem rightTensor_tau_le_map_galFull {K : Subalgebra k H} (hK : IsSubHopfAlgebra k K) :
    rightTensor (tau K.toSubmodule) ≤ Submodule.map (galFull k H) (balRel K.toSubmodule) := by
  set M := Submodule.map (galFull k H) (balRel K.toSubmodule) with hM
  refine rightTensor_le fun h z hz => ?_
  have hle : tau K.toSubmodule ≤ Submodule.comap (TensorProduct.mk k H H h) M := by
    refine Submodule.map₂_le.2 fun u _ y hy => ?_
    simp only [Submodule.mem_comap, LinearMap.mul_apply', TensorProduct.mk_apply]
    -- `y ∈ K⁺` is `ε(a) 1 - S a` for `a = S y ∈ K`
    have ha : antipode k y ∈ K := hK.antipode_mem y hy.1
    have hy0 : counit (R := k) y = 0 := hy.2
    have hcount : counit (R := k) (antipode k y) = 0 := by
      rw [HopfAlgebra.counit_antipode, hy0]
    have hval : counit (R := k) (antipode k y) • (1 : H) - antipode k (antipode k y) = -y := by
      rw [hcount, zero_smul, zero_sub, antipode_antipode]
    have hmem := mul_mem_map_galFull hK.toIsSubBialg ha (h ⊗ₜ[k] u)
    rw [hval] at hmem
    have : (h ⊗ₜ[k] u) * ((1 : H) ⊗ₜ[k] (-y)) = -(h ⊗ₜ[k] (u * y)) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_neg, TensorProduct.tmul_neg]
    rw [this] at hmem
    exact (Submodule.neg_mem_iff M).1 hmem
  exact hle hz

variable [IsAbsFlat k]

/-- **`K ⊆ H` is a Hopf–Galois extension** for every sub-Hopf algebra `K` of a cocommutative Hopf
algebra: the kernel of the Galois map `β : H ⊗ H → H ⊗ (H ⧸ H K⁺)` is exactly the submodule of
`K`-balanced relations, so the descended map `H ⊗_K H → H ⊗ (H ⧸ H K⁺)` is bijective. -/
theorem ker_gal_tau_eq_balRel {K : Subalgebra k H} (hK : IsSubHopfAlgebra k K) :
    LinearMap.ker (gal (tau K.toSubmodule)) = balRel K.toSubmodule :=
  le_antisymm ((ker_gal_le_balRel_iff K).2 (rightTensor_tau_le_map_galFull hK))
    (balRel_le_ker_gal hK.toIsSubBialg)

/-- **Newman's closure identity `μ (τ K) = K`** for an arbitrary sub-Hopf algebra `K` of a
cocommutative Hopf algebra, assuming only descent along `K ⊆ H` — for instance
(`HopfAlgebra.Cocommutative.descent_of_retraction`) whenever `K` is a direct summand of `H` as a
right `K`-module. -/
theorem coinv_tau_eq_of_descent {K : Subalgebra k H} (hK : IsSubHopfAlgebra k K)
    (hdesc : ∀ h : H, h ⊗ₜ[k] (1 : H) - (1 : H) ⊗ₜ[k] h ∈ balRel K.toSubmodule → h ∈ K) :
    coinv (tau K.toSubmodule) = K.toSubmodule :=
  coinv_tau_eq_of_rightTensor_le_of_descent hK.toIsSubBialg
    (rightTensor_tau_le_map_galFull hK) hdesc

/-- The same identity from a right `K`-linear retraction `H ↠ K`. -/
theorem coinv_tau_eq_of_retraction {K : Subalgebra k H} (hK : IsSubHopfAlgebra k K) (p : H →ₗ[k] H)
    (hp : ∀ x, p x ∈ K) (hp1 : ∀ a ∈ K, p a = a) (hpK : ∀ (x : H), ∀ a ∈ K, p (x * a) = p x * a) :
    coinv (tau K.toSubmodule) = K.toSubmodule :=
  coinv_tau_eq_of_descent hK fun _ hh => descent_of_retraction K p hp hp1 hpK hh

end Cocomm

end HopfAlgebra.Cocommutative
