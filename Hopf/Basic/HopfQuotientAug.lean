module

public import Foundations.RingTheory.AbsFlatClass
public import Hopf.Commutative.FaithfulFlatness

/-!
# The quotient `C = B / A⁺B` of a Hopf algebra by a Hopf subalgebra

Let `f : A →ₐc[k] B` be a morphism of commutative Hopf algebras over a commutative von Neumann
regular ring `k` (for instance a field), viewed as making `B` an `A`-algebra. Following Waterhouse
(*Introduction to Affine Group Schemes*, §14.2) we write

* `A⁺` for the augmentation ideal `ker ε_A` of `A` (`HopfAlgebra.Commutative.augmentationIdeal`),
* `A⁺B` for the ideal of `B` it generates (`HopfAlgebra.augIdealB`),
* `C = B / A⁺B` (`HopfAlgebra.QuotAug`), the coordinate ring of the kernel of `Spec B → Spec A`.

This file sets up `C` and the two basic facts about it:

* `HopfAlgebra.mkAug_algebraMap`: `f a ≡ ε(a)` in `C`, i.e. `A` acts on `C` through its counit;
* `HopfAlgebra.quotPairMap`: consequently `b ⊗ c ↦ [b] ⊗ [c]` is well defined on `B ⊗[A] B`,
  giving a `k`-linear map `B ⊗[A] B → C ⊗[k] C`.

## Main results

* `HopfAlgebra.augIdealB`: the ideal `A⁺B` of `B` generated by the augmentation ideal of `A`.
* `HopfAlgebra.QuotAug`: the quotient `C = B / A⁺B`, with quotient map `HopfAlgebra.mkAug`.
* `HopfAlgebra.mkAug_algebraMap`: `mkAug (algebraMap A B a) = algebraMap k C (ε a)`.
* `HopfAlgebra.quotPairMap`: the `A`-linear map `B ⊗[A] B → C ⊗[k] C`, `b ⊗ c ↦ [b] ⊗ [c]`.

## References

* [W. C. Waterhouse, *Introduction to Affine Group Schemes*]
  [waterhouseIntroductionAffineGroup1979], Section 14.2
* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972]
-/

@[expose] public section

section
open HopfAlgebra.Commutative
namespace HopfAlgebra

open TensorProduct Coalgebra

variable (k A B : Type*) [CommRing k] [CommRing A] [CommRing B] [HopfAlgebra k A]
    [HopfAlgebra k B]
  [Algebra A B]

/-- The ideal `A⁺B` of `B` generated by the augmentation ideal of `A`. -/
noncomputable def augIdealB : Ideal B :=
  (HopfAlgebra.Commutative.augmentationIdeal k A).map (algebraMap A B)

/-- The quotient Hopf algebra `C = B / A⁺B`; as a `k`-algebra it is the coordinate ring of the
kernel of the map of affine group schemes `Spec B → Spec A`. -/
abbrev QuotAug : Type _ := B ⧸ augIdealB k A B

/-- The quotient map `B → C = B / A⁺B`. -/
noncomputable def mkAug : B →ₐ[k] QuotAug k A B :=
  Ideal.Quotient.mkₐ k (augIdealB k A B)

variable {k A B}

/-- The quotient map `B → B/A⁺B` is surjective. -/
lemma mkAug_surjective : Function.Surjective (mkAug k A B) :=
  Ideal.Quotient.mk_surjective

omit [HopfAlgebra k B] in
/-- An element of `A` with vanishing counit maps into `A⁺B`. -/
lemma mem_augIdealB (a : A) (ha : Coalgebra.counit (R := k) a = 0) :
    algebraMap A B a ∈ augIdealB k A B :=
  Ideal.mem_map_of_mem _ ha

variable [IsScalarTower k A B]

/-- `A` acts on `C = B / A⁺B` through its counit: the image of `a ∈ A` in `C` is `ε(a)`. -/
lemma mkAug_algebraMap (a : A) :
    mkAug k A B (algebraMap A B a) =
      algebraMap k (QuotAug k A B) (Coalgebra.counit (R := k) a) := by
  have h : a - algebraMap k A (Coalgebra.counit (R := k) a)
      ∈ HopfAlgebra.Commutative.augmentationIdeal k A := by
    simp only [HopfAlgebra.Commutative.mem_augmentationIdeal, map_sub]
    rw [show Coalgebra.counit (R := k) (algebraMap k A (Coalgebra.counit (R := k) a))
        = Coalgebra.counit (R := k) a by
      simp]
    ring
  have h2 : algebraMap A B (a - algebraMap k A (Coalgebra.counit (R := k) a)) ∈ augIdealB k A B :=
    Ideal.mem_map_of_mem _ h
  rw [map_sub] at h2
  have h3 : algebraMap A B (algebraMap k A (Coalgebra.counit (R := k) a))
      = algebraMap k B (Coalgebra.counit (R := k) a) := by
    rw [← IsScalarTower.algebraMap_apply]
  rw [h3] at h2
  have h4 := (Submodule.Quotient.eq (augIdealB k A B)).mpr h2
  rw [IsScalarTower.algebraMap_apply k B (QuotAug k A B)]
  exact h4

/-- `A` acts on `C = B / A⁺B` through the counit of `A`. -/
lemma smul_quotAug (a : A) (x : QuotAug k A B) :
    a • x = (Coalgebra.counit (R := k) a) • x := by
  rw [Algebra.smul_def, IsScalarTower.algebraMap_apply A B (QuotAug k A B)]
  rw [show (algebraMap B (QuotAug k A B)) (algebraMap A B a) = mkAug k A B (algebraMap A B a) from
    rfl, mkAug_algebraMap a, ← Algebra.smul_def]

/-- Because `A` acts on `C` through `k`, the `A`-action on `C ⊗[k] C` may be switched between
the two factors. -/
instance compatibleSMul_quotAug :
    TensorProduct.CompatibleSMul k A (QuotAug k A B) (QuotAug k A B) :=
  ⟨fun a x y => by
    rw [smul_quotAug, smul_quotAug (k := k) (B := B) a y, TensorProduct.smul_tmul]⟩

variable (k A B)

/-- The quotient map `B → C`, as an `A`-linear map. -/
noncomputable def mkAugₗ : B →ₗ[A] QuotAug k A B :=
  (Ideal.Quotient.mkₐ A (augIdealB k A B)).toLinearMap

/-- The `A`-linear map `B ⊗[A] B → C ⊗[k] C`, `b ⊗ c ↦ [b] ⊗ [c]`.  It is well defined because
`A` acts on `C` through its counit. -/
noncomputable def quotPairMap :
    B ⊗[A] B →ₗ[A] (QuotAug k A B ⊗[k] QuotAug k A B) :=
  (TensorProduct.mapOfCompatibleSMul k A A (QuotAug k A B) (QuotAug k A B)) ∘ₗ
    (TensorProduct.map (mkAugₗ k A B) (mkAugₗ k A B))

variable {k A B}

/-- `quotPairMap` on pure tensors: `b ⊗ c ↦ [b] ⊗ [c]`. -/
@[simp] lemma quotPairMap_tmul (b c : B) :
    quotPairMap k A B (b ⊗ₜ[A] c) = mkAug k A B b ⊗ₜ[k] mkAug k A B c := rfl

end HopfAlgebra
end
