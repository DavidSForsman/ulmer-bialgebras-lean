module

public import Hopf.Basic.CoalgebraLocallyFinite
public import Hopf.Basic.AntipodeInvolutive
public import Hopf.Basic.AntipodeAlgHom
public import Hopf.Basic.HopfAdjointCoaction
public import Hopf.Basic.SubHopfAlgebra

/-!
# Local finiteness of commutative Hopf algebras

Every finite subset of a commutative Hopf algebra `H` over a field `k` is contained in a
**finitely generated sub-Hopf algebra** of `H`.

The proof combines the fundamental theorem of coalgebras
(`Coalgebra.LocallyFinite.exists_fg_translClosed_finset`) with the two structural facts about the
antipode of a commutative Hopf algebra: it is an algebra map
(`HopfAlgebra.antipodeAlgHom`) and an anti-morphism of coalgebras
(`HopfAlgebra.comul_antipode_apply`).  Given a finite subset `S` one takes a finitely
generated translation-closed subspace `E ∋ S`, replaces it by `V = E + S(E)` — still finitely
generated and translation-closed, and now stable under the antipode — and finally takes the
subalgebra generated by `V`.

## Main results

* `HopfAlgebra.LocallyFinite.exists_fg_isSubHopfAlgebra`: every finite subset of a commutative Hopf
  algebra over a field lies in a finitely generated sub-Hopf algebra.

## References

* [M. E. Sweedler, *Hopf algebras*][Sweedler], 2.2.1, 4.0.1
* [W. C. Waterhouse, *Introduction to Affine Group
  Schemes*][waterhouseIntroductionAffineGroup1979], Section 3.3
-/

@[expose] public section

open TensorProduct Coalgebra HopfAlgebra Coalgebra Coalgebra.Comodule Coalgebra.LocallyFinite

section
open Coalgebra Coalgebra.Comodule Coalgebra.LocallyFinite HopfAlgebra
namespace HopfAlgebra.LocallyFinite

variable {k H : Type*} [Field k] [CommRing H] [HopfAlgebra k H]

/-! ### Translations and the antipode -/

/-- Left translation of `S y` by `w` is `S` of the translation of `y` by `w ∘ S`. -/
lemma translLeft_antipode (w : H →ₗ[k] k) (y : H) :
    translLeft w (antipode k y) = antipode k (transl (R := k) (C := H) (w ∘ₗ antipode k) y) := by
  classical
  set r := ℛ k y with hr
  have hcomul : comul (R := k) (antipode k y)
      = ∑ i ∈ r.index, antipode k (r.right i) ⊗ₜ[k] antipode k (r.left i) :=
    HopfAlgebra.comul_antipode_apply y r
  have hL : translLeft w (antipode k y)
      = ∑ i ∈ r.index, w (antipode k (r.right i)) • antipode k (r.left i) := by
    rw [translLeft_eq_contractLeft, hcomul, map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [contractLeft_tmul]
  have hR : transl (R := k) (C := H) (w ∘ₗ antipode k) y
      = ∑ i ∈ r.index, w (antipode k (r.right i)) • r.left i := by
    rw [transl_apply _ r.toComodule]
    simp only [Repr.toComodule, LinearMap.coe_comp, Function.comp_apply]
  rw [hL, hR, map_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [map_smul]

/-- Translation of `S y` by `u` is `S` of the left translation of `y` by `u ∘ S`. -/
lemma transl_antipode (u : H →ₗ[k] k) (y : H) :
    transl (R := k) (C := H) u (antipode k y) = antipode k (translLeft (u ∘ₗ antipode k) y) := by
  classical
  set r := ℛ k y with hr
  have hcomul : comul (R := k) (antipode k y)
      = ∑ i ∈ r.index, antipode k (r.right i) ⊗ₜ[k] antipode k (r.left i) :=
    HopfAlgebra.comul_antipode_apply y r
  have hL : transl (R := k) (C := H) u (antipode k y)
      = ∑ i ∈ r.index, u (antipode k (r.left i)) • antipode k (r.right i) := by
    rw [transl_eq_contractRight, hcomul, map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [contractRight_tmul]
  have hR : translLeft (u ∘ₗ antipode k) y
      = ∑ i ∈ r.index, u (antipode k (r.left i)) • r.right i := by
    rw [translLeft_apply _ r]
    simp only [LinearMap.coe_comp, Function.comp_apply]
  rw [hL, hR, map_sum]
  exact Finset.sum_congr rfl fun i _ => by rw [map_smul]

/-- The image of a translation-closed subspace under the antipode is translation-closed. -/
lemma isTranslClosed_map_antipode {E : Submodule k H} (hE : IsTranslClosed k H E) :
    IsTranslClosed k H (E.map (antipode k)) := by
  constructor
  · rintro w - ⟨y, hy, rfl⟩
    rw [translLeft_antipode]
    exact ⟨_, hE.2 _ y hy, rfl⟩
  · rintro u - ⟨y, hy, rfl⟩
    rw [transl_antipode]
    exact ⟨_, hE.1 _ y hy, rfl⟩

/-- Every finite subset of a commutative Hopf algebra lies in a finitely generated
translation-closed subspace which is stable under the antipode. -/
theorem exists_fg_translClosed_antipode (S : Finset H) :
    ∃ V : Submodule k H, (∀ x ∈ S, x ∈ V) ∧ V.FG ∧ IsTranslClosed k H V ∧
      ∀ y ∈ V, antipode k y ∈ V := by
  obtain ⟨E, hES, hEfg, hEcl⟩ := exists_fg_translClosed_finset (k := k) S
  refine ⟨E ⊔ E.map (antipode k), fun x hx => Submodule.mem_sup_left (hES x hx),
    hEfg.sup (hEfg.map _), hEcl.sup (isTranslClosed_map_antipode hEcl), ?_⟩
  intro y hy
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hy
  rw [map_add]
  refine Submodule.add_mem _ (Submodule.mem_sup_right ⟨a, ha, rfl⟩) ?_
  obtain ⟨c, hc, rfl⟩ := hb
  rw [antipode_antipode]
  exact Submodule.mem_sup_left hc

/-! ### The sub-Hopf algebra generated by a finite set -/

/-- **Local finiteness of commutative Hopf algebras**: every finite subset of a commutative Hopf
algebra over a field is contained in a finitely generated sub-Hopf algebra
([waterhouseIntroductionAffineGroup1979], Section 3.3). -/
theorem exists_fg_isSubHopfAlgebra (S : Finset H) :
    ∃ K : Subalgebra k H, HopfAlgebra.IsSubHopfAlgebra k K ∧ Algebra.FiniteType k ↥K ∧
      ∀ x ∈ S, x ∈ K := by
  classical
  obtain ⟨V, hSV, hVfg, hVcl, hVanti⟩ := exists_fg_translClosed_antipode (k := k) S
  obtain ⟨T, hT⟩ := hVfg
  refine ⟨Algebra.adjoin k (V : Set H), ?_, ?_, ?_⟩
  · constructor
    · -- the comultiplication maps the generated subalgebra into its square
      intro x hx
      set K : Subalgebra k H := Algebra.adjoin k (V : Set H) with hK
      set R : Subalgebra k (H ⊗[k] H) := (Algebra.TensorProduct.map K.val K.val).range with hR
      have hcoe : ∀ z : (↥K) ⊗[k] (↥K), (Algebra.TensorProduct.map K.val K.val) z
          = TensorProduct.map K.toSubmodule.subtype K.toSubmodule.subtype z := fun z =>
        congr($(HopfAlgebra.mapVal2_algHom (K := K)) z)
      have hmem : ∀ z : H ⊗[k] H, z ∈ R ↔
          z ∈ LinearMap.range
            (TensorProduct.map K.toSubmodule.subtype K.toSubmodule.subtype) := by
        intro z
        constructor
        · rintro ⟨w, rfl⟩; exact ⟨w, hcoe w⟩
        · rintro ⟨w, rfl⟩; exact ⟨w, hcoe w⟩
      -- the set of elements whose comultiplication lands in `R` is a subalgebra
      have hsub : x ∈ Subalgebra.comap (Bialgebra.comulAlgHom k H) R := by
        refine Algebra.adjoin_le ?_ hx
        intro y hy
        have h1 : comul (R := k) y ∈
            LinearMap.range (TensorProduct.map V.subtype V.subtype) :=
          comul_mem_of_isTranslClosed hVcl hy
        obtain ⟨w, hw⟩ := h1
        have hVK : ∀ v : H, v ∈ V → v ∈ K := fun v hv => Algebra.subset_adjoin hv
        have hgoal : comul (R := k) y ∈ R := by
          have hmapeq : TensorProduct.map K.toSubmodule.subtype K.toSubmodule.subtype ∘ₗ
              TensorProduct.map (V.subtype.codRestrict K.toSubmodule fun v => hVK v v.2)
                (V.subtype.codRestrict K.toSubmodule fun v => hVK v v.2)
              = TensorProduct.map V.subtype V.subtype := by
            rw [← TensorProduct.map_comp]
            rfl
          exact (hmem _).2 ⟨TensorProduct.map
            (V.subtype.codRestrict K.toSubmodule fun v => hVK v v.2)
            (V.subtype.codRestrict K.toSubmodule fun v => hVK v v.2) w,
            congr($hmapeq w).trans hw⟩
        exact hgoal
      exact (hmem _).1 hsub
    · -- the antipode preserves the generated subalgebra
      intro x hx
      have : x ∈ Subalgebra.comap (HopfAlgebra.antipodeAlgHom k H)
          (Algebra.adjoin k (V : Set H)) := by
        refine Algebra.adjoin_le ?_ hx
        intro y hy
        exact Algebra.subset_adjoin (hVanti y hy)
      exact this
  · rw [show (V : Set H) = ((Submodule.span k (T : Set H) : Submodule k H) : Set H) by rw [hT]]
    rw [Algebra.adjoin_span]
    exact (Subalgebra.fg_iff_finiteType _).1 (Subalgebra.fg_adjoin_finset T)
  · intro x hx
    exact Algebra.subset_adjoin (hSV x hx)

/-- Local finiteness, in the form giving explicit algebra generators: every finite subset of a
commutative Hopf algebra over a field lies in a sub-Hopf algebra generated by a finite set. -/
theorem exists_finset_isSubHopfAlgebra (S : Finset H) :
    ∃ G : Finset H, HopfAlgebra.IsSubHopfAlgebra k (Algebra.adjoin k (G : Set H)) ∧
      ∀ x ∈ S, x ∈ Algebra.adjoin k (G : Set H) := by
  obtain ⟨K, hK, hft, hS⟩ := exists_fg_isSubHopfAlgebra (k := k) S
  obtain ⟨G, hG⟩ := (Subalgebra.fg_iff_finiteType K).2 hft
  exact ⟨G, hG ▸ hK, fun x hx => hG ▸ hS x hx⟩

end HopfAlgebra.LocallyFinite
end
