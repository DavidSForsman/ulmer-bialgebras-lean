module

public import Mathlib.RingTheory.Bialgebra.Hom
public import Hopf.Basic.ComoduleFinite
public import Hopf.Basic.HopfModule

/-!
# Relative Hopf modules

This file formalizes §2 of Takeuchi's paper *A correspondence between Hopf ideals and sub-Hopf
algebras*, manuscripta math. **7** (1972).

Let `k` be a field, `H` a `k`-bialgebra and `K` a `k`-bialgebra equipped with a morphism of
bialgebras `φ : K →ₐc[k] H` (in Takeuchi's situation `K` is a sub-Hopf algebra of `H` and `φ` is
the inclusion).  A **relative `(H,K)`-Hopf module** is a `K`-module `M` which is at the same time
a right `H`-comodule, the two structures being compatible in the sense that the coaction is
`K`-linear:

```
ρ (x • m) = ∑ (x₍₁₎ • m₍₀₎) ⊗ φ(x₍₂₎) m₍₁₎ .
```

## Main definitions

* `HopfAlgebra.relCompat`: the map `(K ⊗ K) ⊗ (M ⊗ H) → M ⊗ H` used to state the axiom;
* `HopfAlgebra.IsRelativeHopfModule`: Takeuchi's Definition 2.1.

## Main results

* `HopfAlgebra.IsRelativeHopfModule.isSubcomodule_span`: Takeuchi's Proposition 2.2 — if `V` is
  a subcomodule of `M`, then the `K`-submodule `V·K` generated by `V` is again a subcomodule.
  (Takeuchi's Corollary 2.3, that a relative Hopf module is the filtered union of its finitely
  generated sub-Hopf modules, is used in this form in
  `Hopf/Commutative/RelativeHopfModuleQuot.lean`.)

## References

* [M. Takeuchi, *A correspondence between Hopf ideals and sub-Hopf algebras*][Takeuchi1972], Section
  2
-/

@[expose] public section

section
open Coalgebra Coalgebra.Comodule
namespace HopfAlgebra

open TensorProduct _root_.Coalgebra

section Defs

variable (k K H M : Type*) [Field k] [CommRing K] [CommRing H]
  [Bialgebra k K] [Bialgebra k H] [AddCommGroup M] [Module k M] [Module K M]
  [IsScalarTower k K M]

/-- The action of `K` on `M` as a `k`-linear map `K ⊗[k] M →ₗ[k] M`. -/
noncomputable def relActMap : K ⊗[k] M →ₗ[k] M :=
  TensorProduct.lift (Algebra.lsmul k k M : K →ₐ[k] Module.End k M).toLinearMap

/-- `relActMap` on pure tensors: `x ⊗ m ↦ x • m`. -/
@[simp] lemma relActMap_tmul (x : K) (m : M) : relActMap k K M (x ⊗ₜ[k] m) = x • m := rfl

variable (φ : K →ₐc[k] H)

/-- The `k`-linear map `(K ⊗ K) ⊗ (M ⊗ H) → M ⊗ H`, `(a ⊗ b) ⊗ (m ⊗ h) ↦ (a • m) ⊗ (φ b * h)`,
used to state the compatibility axiom of a relative Hopf module. -/
noncomputable def relCompat : (K ⊗[k] K) ⊗[k] (M ⊗[k] H) →ₗ[k] M ⊗[k] H :=
  (TensorProduct.map (relActMap k K M)
      ((LinearMap.mul' k H) ∘ₗ (LinearMap.rTensor H (φ.toLinearMap)))) ∘ₗ
    (TensorProduct.tensorTensorTensorComm k K K M H).toLinearMap

/-- `relCompat` on pure tensors: `(a ⊗ b) ⊗ (m ⊗ h) ↦ (a • m) ⊗ (φ b * h)`. -/
@[simp] lemma relCompat_tmul (a b : K) (m : M) (h : H) :
    relCompat k K H M φ ((a ⊗ₜ[k] b) ⊗ₜ[k] (m ⊗ₜ[k] h)) = (a • m) ⊗ₜ[k] (φ b * h) := rfl

variable [RightComodule k H M]

/-- **Takeuchi, Definition 2.1**: `M` is a relative `(H,K)`-Hopf module if it is a `K`-module and
a right `H`-comodule whose coaction is `K`-linear, i.e.
`ρ (x • m) = ∑ (x₍₁₎ • m₍₀₎) ⊗ φ(x₍₂₎) m₍₁₎`. -/
def IsRelativeHopfModule : Prop :=
  ∀ (x : K) (m : M), Coalgebra.Comodule.coact (R := k) (C := H) (x • m)
    = relCompat k K H M φ (comul (R := k) x ⊗ₜ[k] Coalgebra.Comodule.coact (R := k) (C := H) m)

end Defs

section Props

variable {k K H M : Type*} [Field k] [CommRing K] [CommRing H]
  [Bialgebra k K] [Bialgebra k H] [AddCommGroup M] [Module k M] [Module K M]
  [IsScalarTower k K M] {φ : K →ₐc[k] H}

open Coalgebra.Comodule

/-- Membership in `N ⊗ H` is monotone in the submodule `N`. -/
lemma mem_range_rTensor_of_le {N P : Submodule k M} (h : N ≤ P) {t : M ⊗[k] H}
    (ht : t ∈ LinearMap.range (LinearMap.rTensor H N.subtype)) :
    t ∈ LinearMap.range (LinearMap.rTensor H P.subtype) := by
  obtain ⟨s, rfl⟩ := ht
  refine ⟨LinearMap.rTensor H (Submodule.inclusion h) s, ?_⟩
  rw [← LinearMap.comp_apply, ← LinearMap.rTensor_comp]
  rfl

/-- `W ⊗ H` is stable under the operation appearing in the axiom of a relative Hopf module,
for any `K`-submodule `W` of `M`. -/
lemma relCompat_mem_range (W : Submodule K M) (u : K ⊗[k] K) {t : M ⊗[k] H}
    (ht : t ∈ LinearMap.range
      (LinearMap.rTensor H (W.restrictScalars k).subtype)) :
    relCompat k K H M φ (u ⊗ₜ[k] t) ∈ LinearMap.range
      (LinearMap.rTensor H (W.restrictScalars k).subtype) := by
  obtain ⟨s, rfl⟩ := ht
  induction u with
  | add u v hu hv =>
    rw [TensorProduct.add_tmul, map_add]
    exact Submodule.add_mem _ hu hv
  | tmul a b =>
    induction s with
    | add s s' hs hs' =>
      rw [map_add, TensorProduct.tmul_add, map_add]
      exact Submodule.add_mem _ hs hs'
    | tmul w h =>
      refine ⟨(⟨a • (w : M), W.smul_mem a w.2⟩ : ↥(W.restrictScalars k)) ⊗ₜ[k] (φ b * h), ?_⟩
      simp

variable [RightComodule k H M]

variable (hM : IsRelativeHopfModule k K H M φ)
include hM

/-- **Takeuchi, Proposition 2.2**: if `V` is a subcomodule of a relative `(H,K)`-Hopf module `M`,
then the `K`-submodule `V·K` generated by `V` is again a subcomodule. -/
theorem IsRelativeHopfModule.isSubcomodule_span (V : Submodule k M)
    (hV : IsSubcomodule (C := H) V) :
    IsSubcomodule (C := H) ((Submodule.span K (V : Set M)).restrictScalars k) := by
  set W : Submodule K M := Submodule.span K (V : Set M) with hW
  have hle : V ≤ W.restrictScalars k := by
    intro v hv
    exact Submodule.subset_span hv
  intro y hy
  have hy' : y ∈ W := hy
  refine Submodule.span_induction (p := fun z _ => coact (R := k) (C := H) z ∈
    LinearMap.range (LinearMap.rTensor H (W.restrictScalars k).subtype)) ?_ ?_ ?_ ?_ hy'
  · intro v hv
    exact mem_range_rTensor_of_le hle (hV v hv)
  · simp
  · intro u v _ _ hu hv
    rw [map_add]
    exact Submodule.add_mem _ hu hv
  · intro c u _ hu
    rw [hM c u]
    exact relCompat_mem_range W _ hu

end Props

end HopfAlgebra
end
