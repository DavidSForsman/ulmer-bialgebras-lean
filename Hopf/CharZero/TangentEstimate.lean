module

public import Mathlib.RingTheory.MvPolynomial.EulerIdentity
public import Hopf.Commutative.FaithfulFlatness

/-!
# The tangent-space estimate behind Cartier's theorem

Let `A` be a commutative bialgebra over a field `k` of characteristic zero and let
`I = ker ε` be its augmentation ideal.  The main result of this file is

* `HopfAlgebra.CharZero.eq_zero_of_isHomogeneous`: if `x₁, …, x_r ∈ I` have linearly independent
  classes in `A ⧸ I²` and `P` is a homogeneous polynomial of degree `n` with
  `P (x₁, …, x_r) ∈ I ^ (n+1)`, then `P = 0`.

In other words the associated graded algebra `⨁ Iⁿ/Iⁿ⁺¹` of a commutative Hopf algebra in
characteristic zero is a *polynomial* algebra on `I/I²`; this is the local form of Cartier's
theorem, and it fails in characteristic `p` (take `A = k[x]/(xᵖ)`).

The proof is a first-order Taylor expansion of the comultiplication.  Writing `π₂ : A → A ⧸ I²`
and `π : A → A ⧸ Iⁿ` and `δ = (π₂ ⊗ π) ∘ Δ : A → (A ⧸ I²) ⊗ (A ⧸ Iⁿ)`, the augmentation ideal
maps into `Ja + Jb`, where `Ja` (resp. `Jb`) is generated by the image of `I` in the left
(resp. right) tensor factor, and `Ja² = 0`, `Jbⁿ = 0`.  Hence `δ` kills `I ^ (n+1)`, while the
Taylor expansion of `δ (P x) = P (δ x)` around the right-hand factor leaves exactly the term
`∑ i, [xᵢ] ⊗ [∂ᵢP (x)]`.  Linear independence of the `[xᵢ]` forces `∂ᵢP (x) ∈ Iⁿ`, and induction
on the degree together with Euler's identity (this is where characteristic zero enters) gives
`P = 0`.

## Main results

* `HopfAlgebra.CharZero.eq_zero_of_isHomogeneous`: in characteristic zero, if `x₁, …, x_r ∈ I` have
  linearly independent classes in `I/I²` and `P` is homogeneous of degree `N` with
  `P (x₁, …, x_r) ∈ I ^ (N+1)`, then `P = 0`.

## References

* [W. C. Waterhouse, *Introduction to Affine Group Schemes*][waterhouseIntroductionAffineGroup1979],
  Section 11.4
-/

@[expose] public section

section
open HopfAlgebra.Commutative
namespace HopfAlgebra.CharZero

open TensorProduct Coalgebra MvPolynomial

/-! ## General auxiliary lemmas -/

section Aux

variable {R : Type*} [CommRing R]

/-- A sharp form of `(I ⊔ J) ^ N ≤ I ^ a ⊔ J ^ b` for `a + b = N + 1`. -/
theorem sup_pow_le_sup_pow (I J : Ideal R) :
    ∀ N a b : ℕ, a + b = N + 1 → (I ⊔ J) ^ N ≤ I ^ a ⊔ J ^ b := by
  intro N
  induction N with
  | zero =>
      intro a b hab
      rcases Nat.eq_zero_or_pos a with ha | ha
      · subst ha; simp only [zero_add] at hab; subst hab; simp
      · have hb : b = 0 := by omega
        subst hb; simp
  | succ N ih =>
      intro a b hab
      rcases Nat.eq_zero_or_pos a with ha | ha
      · subst ha; simp
      rcases Nat.eq_zero_or_pos b with hb | hb
      · subst hb; simp
      obtain ⟨a', rfl⟩ : ∃ a', a = a' + 1 := ⟨a - 1, by omega⟩
      obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
      have h1 : (I ⊔ J) ^ N ≤ I ^ a' ⊔ J ^ (b' + 1) := ih a' (b' + 1) (by omega)
      have h2 : (I ⊔ J) ^ N ≤ I ^ (a' + 1) ⊔ J ^ b' := ih (a' + 1) b' (by omega)
      rw [pow_succ, Ideal.mul_sup]
      refine sup_le ?_ ?_
      · calc (I ⊔ J) ^ N * I ≤ (I ^ a' ⊔ J ^ (b' + 1)) * I := Ideal.mul_mono_left h1
          _ ≤ I ^ (a' + 1) ⊔ J ^ (b' + 1) := by
              rw [Ideal.sup_mul]
              exact sup_le (le_sup_of_le_left (by rw [← pow_succ]))
                (le_sup_of_le_right Ideal.mul_le_left)
      · calc (I ⊔ J) ^ N * J ≤ (I ^ (a' + 1) ⊔ J ^ b') * J := Ideal.mul_mono_left h2
          _ ≤ I ^ (a' + 1) ⊔ J ^ (b' + 1) := by
              rw [Ideal.sup_mul]
              exact sup_le (le_sup_of_le_left Ideal.mul_le_left)
                (le_sup_of_le_right (by rw [← pow_succ]))

/-- Evaluating a homogeneous polynomial of degree `n` at elements of an ideal `J` lands in
`J ^ n`. -/
theorem aeval_mem_pow_of_isHomogeneous {k σ : Type*} [Field k] [Algebra k R]
    (J : Ideal R) (f : σ → R) (hf : ∀ i, f i ∈ J) {n : ℕ} {P : MvPolynomial σ k}
    (hP : P.IsHomogeneous n) : aeval f P ∈ J ^ n := by
  rw [aeval_def, eval₂_eq]
  refine Ideal.sum_mem _ fun d hd => ?_
  have hdeg : ∑ i ∈ d.support, d i = n := by
    have h := hP (mem_support_iff.mp hd)
    rw [Finsupp.weight_apply] at h
    simpa [Finsupp.sum] using h
  have hprod : ∏ i ∈ d.support, f i ^ d i ∈ J ^ n := by
    rw [← hdeg, ← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun i _ => Ideal.pow_mem_pow (hf i) _
  exact Ideal.mul_mem_left _ _ hprod

/-- First-order Taylor expansion: `P (u + w) = P u + ∑ i, wᵢ ∂ᵢP (u)` modulo the square of the
ideal generated by the `wᵢ`. -/
theorem aeval_add_sub_mem_sq {k σ : Type*} [Field k] [Algebra k R] [Fintype σ]
    (u w : σ → R) (P : MvPolynomial σ k) :
    aeval (u + w) P - aeval u P - ∑ i, w i * aeval u (pderiv i P)
      ∈ (Ideal.span (Set.range w)) ^ 2 := by
  classical
  set W := Ideal.span (Set.range w) with hW
  have hwmem : ∀ i, w i ∈ W := fun i => Ideal.subset_span ⟨i, rfl⟩
  -- induction on `P`: constants have no error, and the error is additive
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
      have hsplit : aeval (u + w) (p + q) - aeval u (p + q)
            - ∑ i, w i * aeval u (pderiv i (p + q))
          = (aeval (u + w) p - aeval u p - ∑ i, w i * aeval u (pderiv i p))
            + (aeval (u + w) q - aeval u q - ∑ i, w i * aeval u (pderiv i q)) := by
        simp only [map_add, Finset.sum_add_distrib, mul_add]
        ring
      rw [hsplit]
      exact Ideal.add_mem _ hp hq
  | mul_X p j hp =>
      -- for `p * Xⱼ`: the Leibniz rule gives the derivatives, and writing
      -- `P(u + w) = P(u) + D + s` with `D = ∑ wᵢ ∂ᵢP(u)` and `s` the error for `p`, the new
      -- error is `s (uⱼ + wⱼ) + D wⱼ`, in `W²` since `s ∈ W²` and `D, wⱼ ∈ W`
      have hpd : ∀ i, aeval u (pderiv i (p * X j))
          = aeval u (pderiv i p) * u j + (if i = j then aeval u p else 0) := by
        intro i
        rw [Derivation.leibniz]
        by_cases h : i = j
        · subst h; simp [pderiv_X]; ring
        · simp [pderiv_X, h]; ring
      have hsum : ∑ i, w i * aeval u (pderiv i (p * X j))
          = (∑ i, w i * aeval u (pderiv i p)) * u j + w j * aeval u p := by
        simp only [hpd, mul_add, Finset.sum_add_distrib, Finset.sum_mul]
        congr 1
        · exact Finset.sum_congr rfl fun i _ => by ring
        · simp
      have hE : aeval (u + w) (p * X j)
          = (aeval u p + (∑ i, w i * aeval u (pderiv i p))
              + (aeval (u + w) p - aeval u p - ∑ i, w i * aeval u (pderiv i p)))
            * (u j + w j) := by
        simp [map_mul]
      rw [hE, hsum]
      set s := aeval (u + w) p - aeval u p - ∑ i, w i * aeval u (pderiv i p) with hs
      set D := ∑ i, w i * aeval u (pderiv i p) with hD
      have hrw : (aeval u p + D + s) * (u j + w j) - aeval u (p * X j)
            - (D * u j + w j * aeval u p)
          = s * (u j + w j) + D * w j := by
        simp [map_mul]; ring
      rw [hrw]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) ?_
      have hDW : D ∈ W := Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (hwmem i)
      have hmul : D * w j ∈ W * W := Ideal.mul_mem_mul hDW (hwmem j)
      simpa [pow_two] using hmul

end Aux

/-- If a family `v` is linearly independent over a field, then `∑ i, v i ⊗ y i = 0` forces all
`y i = 0`. -/
theorem eq_zero_of_sum_tmul_eq_zero {k M N : Type*} [Field k] [AddCommGroup M] [Module k M]
    [AddCommGroup N] [Module k N] {r : ℕ} (v : Fin r → M) (hv : LinearIndependent k v)
    (y : Fin r → N) (h : ∑ i, v i ⊗ₜ[k] y i = 0) : ∀ i, y i = 0 := by
  intro j
  obtain ⟨f, hf⟩ : ∃ f : M →ₗ[k] k, ∀ i, f (v i) = if i = j then 1 else 0 := by
    classical
    let g : Submodule.span k (Set.range v) →ₗ[k] k :=
      (Finsupp.lapply j : (Fin r →₀ k) →ₗ[k] k).comp hv.repr
    obtain ⟨F, hF⟩ := g.exists_extend
    refine ⟨F, fun i => ?_⟩
    have hvi : v i ∈ Submodule.span k (Set.range v) := Submodule.subset_span ⟨i, rfl⟩
    have hcong := LinearMap.congr_fun hF ⟨v i, hvi⟩
    simp only [LinearMap.comp_apply, Submodule.subtype_apply] at hcong
    rw [hcong]
    have hrepr : hv.repr ⟨v i, hvi⟩ = Finsupp.single i 1 := hv.repr_eq_single i ⟨v i, hvi⟩ rfl
    simp [g, hrepr, Finsupp.single_apply, eq_comm]
  have h2 := congrArg (fun z => TensorProduct.lid k N (LinearMap.rTensor N f z)) h
  simp only [map_sum, LinearMap.rTensor_tmul, map_zero] at h2
  simpa [hf, Finset.sum_ite_eq'] using h2

/-! ## The comultiplication modulo the augmentation ideal -/

section Bialg

variable {k A : Type*} [Field k] [CommRing A] [Bialgebra k A]

open HopfAlgebra.Commutative

/-- The projection `a ↦ a - ε(a)·1` of a bialgebra onto its augmentation ideal. -/
noncomputable def proj (k A : Type*) [Field k] [CommRing A] [Bialgebra k A] : A →ₗ[k] A :=
  LinearMap.id - (Algebra.linearMap k A) ∘ₗ (counit : A →ₗ[k] k)

/-- `a - ε(a)·1` lies in the augmentation ideal. -/
lemma proj_mem (a : A) : proj k A a ∈ augmentationIdeal k A := by
  simp [proj, mem_augmentationIdeal, Algebra.linearMap_apply, Algebra.algebraMap_eq_smul_one]

/-- The projection `a ↦ a - ε(a)·1` fixes the augmentation ideal. -/
lemma proj_eq_self {a : A} (ha : a ∈ augmentationIdeal k A) : proj k A a = a := by
  have : counit (R := k) a = 0 := ha
  simp [proj, this]

private lemma lTensor_unit_counit (x : A) :
    (LinearMap.lTensor A ((Algebra.linearMap k A) ∘ₗ (counit : A →ₗ[k] k))) (comul x)
      = x ⊗ₜ[k] (1 : A) := by
  rw [LinearMap.lTensor_comp, LinearMap.comp_apply, Coalgebra.lTensor_counit_comul]
  simp

private lemma rTensor_unit_counit (x : A) :
    (LinearMap.rTensor A ((Algebra.linearMap k A) ∘ₗ (counit : A →ₗ[k] k))) (comul x)
      = (1 : A) ⊗ₜ[k] x := by
  rw [LinearMap.rTensor_comp, LinearMap.comp_apply, Coalgebra.rTensor_counit_comul]
  simp

/-- The reduced comultiplication of an element of the augmentation ideal, expressed through the
projection `proj`. -/
theorem rTensor_lTensor_proj_comul {x : A} (hx : x ∈ augmentationIdeal k A) :
    (LinearMap.rTensor A (proj k A)) ((LinearMap.lTensor A (proj k A)) (comul x))
      = comul x - x ⊗ₜ[k] 1 - 1 ⊗ₜ[k] x := by
  have h1 : (LinearMap.lTensor A (proj k A)) (comul x) = comul x - x ⊗ₜ[k] (1 : A) := by
    rw [proj, LinearMap.lTensor_sub]
    simp only [LinearMap.sub_apply, LinearMap.lTensor_id, LinearMap.id_apply, lTensor_unit_counit]
  rw [h1, map_sub, LinearMap.rTensor_tmul]
  have h2 : (LinearMap.rTensor A (proj k A)) (comul x) = comul x - (1 : A) ⊗ₜ[k] x := by
    rw [proj, LinearMap.rTensor_sub]
    simp only [LinearMap.sub_apply, LinearMap.rTensor_id, LinearMap.id_apply, rTensor_unit_counit]
  rw [h2, proj_eq_self hx]
  abel

end Bialg

/-! ## The key step: differentiating a relation -/

section Step

variable {k A : Type*} [Field k] [CommRing A] [Bialgebra k A]

open HopfAlgebra.Commutative

/-- First-order expansion of `δ = (π₂ ⊗ πₙ₊₁) ∘ Δ` on the augmentation ideal `I`:
for `a ∈ I`, `δ a - (inl (π₂ a) + inr (πₙ₊₁ a)) ∈ Ja * Jb`. -/
private lemma comul_sub_prim_mem_mul (n : ℕ) {a : A} (ha : a ∈ augmentationIdeal k A) :
    let I := augmentationIdeal k A
    let π2 : A →ₐ[k] A ⧸ I ^ 2 := Ideal.Quotient.mkₐ k (I ^ 2)
    let πN : A →ₐ[k] A ⧸ I ^ (n + 1) := Ideal.Quotient.mkₐ k (I ^ (n + 1))
    let inl : (A ⧸ I ^ 2) →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
      Algebra.TensorProduct.includeLeft
    let inr : (A ⧸ I ^ (n + 1)) →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
      Algebra.TensorProduct.includeRight
    let δ : A →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
      (Algebra.TensorProduct.map π2 πN).comp (Bialgebra.comulAlgHom k A)
    let Ja := Ideal.map inl (Ideal.map π2 I)
    let Jb := Ideal.map inr (Ideal.map πN I)
    δ a - (inl (π2 a) + inr (πN a)) ∈ Ja * Jb := by
  intro I π2 πN inl inr δ Ja Jb
  have himg : ∀ t : A ⊗[k] A, (Algebra.TensorProduct.map π2 πN)
      ((LinearMap.rTensor A (proj k A)) ((LinearMap.lTensor A (proj k A)) t)) ∈ Ja * Jb := by
    intro t
    induction t with
    | add p q hp hq =>
        rw [map_add, map_add, map_add]
        exact Ideal.add_mem _ hp hq
    | tmul p q =>
        simp only [LinearMap.lTensor_tmul, LinearMap.rTensor_tmul, Algebra.TensorProduct.map_tmul]
        have h1 : π2 (proj k A p) ⊗ₜ[k] πN (proj k A q) =
            (inl (π2 (proj k A p))) * (inr (πN (proj k A q))) := by
          simp [inl, inr, Algebra.TensorProduct.includeLeft_apply,
            Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul]
        rw [h1]
        exact Ideal.mul_mem_mul
          (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (proj_mem p)))
          (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (proj_mem q)))
  have h := himg (comul a)
  rw [rTensor_lTensor_proj_comul (k := k) (A := A) ha] at h
  have hrw : (Algebra.TensorProduct.map π2 πN) (comul a - a ⊗ₜ[k] 1 - 1 ⊗ₜ[k] a) =
      δ a - (inl (π2 a) + inr (πN a)) := by
    rw [map_sub, map_sub]
    simp [δ, inl, inr, Algebra.TensorProduct.includeLeft_apply,
      Algebra.TensorProduct.includeRight_apply]
    abel
  rwa [hrw] at h

/-- `Ideal.map (Ideal.Quotient.mkₐ k K) K = ⊥` for any ideal `K`. -/
private lemma ideal_map_mkₐ_self {R : Type*} [CommRing R] [Algebra k R] (K : Ideal R) :
    Ideal.map (Ideal.Quotient.mkₐ k K) K = ⊥ := by
  apply (Ideal.map_eq_bot_iff_le_ker _).2
  intro a ha
  simp only [RingHom.mem_ker]
  exact Ideal.Quotient.eq_zero_iff_mem.2 ha

/-- The map `δ = (π₂ ⊗ πₙ₊₁) ∘ Δ` sends `I ^ (n + 2)` to `0`. -/
private lemma map_comul_pow_eq_zero (n : ℕ) {z : A}
    (hz : z ∈ (augmentationIdeal k A) ^ (n + 1 + 1)) :
    let I := augmentationIdeal k A
    let π2 : A →ₐ[k] A ⧸ I ^ 2 := Ideal.Quotient.mkₐ k (I ^ 2)
    let πN : A →ₐ[k] A ⧸ I ^ (n + 1) := Ideal.Quotient.mkₐ k (I ^ (n + 1))
    ((Algebra.TensorProduct.map π2 πN).comp (Bialgebra.comulAlgHom k A)) z = 0 := by
  intro I π2 πN
  set inl : (A ⧸ I ^ 2) →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
    Algebra.TensorProduct.includeLeft
  set inr : (A ⧸ I ^ (n + 1)) →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
    Algebra.TensorProduct.includeRight
  set δ := (Algebra.TensorProduct.map π2 πN).comp (Bialgebra.comulAlgHom k A)
  set Ja := Ideal.map inl (Ideal.map π2 I)
  set Jb := Ideal.map inr (Ideal.map πN I)
  have hJasq : Ja ^ 2 = ⊥ := by
    rw [show Ja = Ideal.map inl (Ideal.map π2 I) from rfl, ← Ideal.map_pow, ← Ideal.map_pow,
      ideal_map_mkₐ_self (I ^ 2), Ideal.map_bot]
  have hJbN : Jb ^ (n + 1) = ⊥ := by
    rw [show Jb = Ideal.map inr (Ideal.map πN I) from rfl, ← Ideal.map_pow, ← Ideal.map_pow,
      ideal_map_mkₐ_self (I ^ (n + 1)), Ideal.map_bot]
  have hδI : Ideal.map δ I ≤ Ja ⊔ Jb := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    have h1 := comul_sub_prim_mem_mul (k := k) n ha
    have h2 : δ a = (inl (π2 a) + inr (πN a)) + (δ a - (inl (π2 a) + inr (πN a))) := by ring
    rw [Ideal.mem_comap, h2]
    exact Ideal.add_mem _ (Ideal.add_mem _
      (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ ha)))
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ ha))))
      (Ideal.mem_sup_left (Ideal.mul_le_left h1))
  have hmap : Ideal.map δ (I ^ (n + 1 + 1)) = ⊥ := by
    refine le_antisymm ?_ bot_le
    rw [Ideal.map_pow]
    calc (Ideal.map δ I) ^ (n + 1 + 1) ≤ (Ja ⊔ Jb) ^ (n + 1 + 1) := Ideal.pow_right_mono hδI _
      _ ≤ Ja ^ 2 ⊔ Jb ^ (n + 1) := sup_pow_le_sup_pow Ja Jb (n + 1 + 1) 2 (n + 1) (by omega)
      _ = ⊥ := by rw [hJasq, hJbN]; simp
  have hin := Ideal.mem_map_of_mem δ hz
  rwa [hmap, Ideal.mem_bot] at hin

/-- The second-order error term in the Taylor expansion of `δ(P(x))` vanishes against
`pderiv i P`. -/
private lemma secondOrder_pderiv_eq_zero {r : ℕ} (n : ℕ) (x : Fin r → A)
    (hxI : ∀ i, x i ∈ augmentationIdeal k A) {P : MvPolynomial (Fin r) k}
    (hP : P.IsHomogeneous (n + 1)) (i : Fin r) :
    let I := augmentationIdeal k A
    let π2 : A →ₐ[k] A ⧸ I ^ 2 := Ideal.Quotient.mkₐ k (I ^ 2)
    let πN : A →ₐ[k] A ⧸ I ^ (n + 1) := Ideal.Quotient.mkₐ k (I ^ (n + 1))
    let inl : (A ⧸ I ^ 2) →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
      Algebra.TensorProduct.includeLeft
    let inr : (A ⧸ I ^ (n + 1)) →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
      Algebra.TensorProduct.includeRight
    let δ := (Algebra.TensorProduct.map π2 πN).comp (Bialgebra.comulAlgHom k A)
    ((δ (x i) - inr (πN (x i))) - inl (π2 (x i))) *
      aeval (fun j => inr (πN (x j))) (pderiv i P) = 0 := by
  intro I π2 πN inl inr δ
  set Ja := Ideal.map inl (Ideal.map π2 I)
  set Jb := Ideal.map inr (Ideal.map πN I)
  have hJbN : Jb ^ (n + 1) = ⊥ := by
    rw [show Jb = Ideal.map inr (Ideal.map πN I) from rfl, ← Ideal.map_pow, ← Ideal.map_pow,
      ideal_map_mkₐ_self (I ^ (n + 1)), Ideal.map_bot]
  have hti : (δ (x i) - inr (πN (x i))) - inl (π2 (x i)) ∈ Ja * Jb := by
    have h1 := comul_sub_prim_mem_mul (k := k) n (hxI i)
    rwa [show (δ (x i) - inr (πN (x i))) - inl (π2 (x i)) =
      δ (x i) - (inl (π2 (x i)) + inr (πN (x i))) by ring]
  have hhom : (pderiv i P).IsHomogeneous n := by simpa using hP.pderiv (i := i)
  have h1 : aeval (fun j => inr (πN (x j))) (pderiv i P) ∈ Jb ^ n :=
    aeval_mem_pow_of_isHomogeneous Jb (fun j => inr (πN (x j)))
      (fun j => Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (hxI j))) hhom
  have h3 : (Ja * Jb) * Jb ^ n ≤ Jb ^ (n + 1) := by
    calc (Ja * Jb) * Jb ^ n ≤ Jb * Jb ^ n := Ideal.mul_mono_left Ideal.mul_le_right
      _ = Jb ^ (n + 1) := (pow_succ' Jb n).symm
  have hmem := h3 (Ideal.mul_mem_mul hti h1)
  rwa [hJbN, Ideal.mem_bot] at hmem

/-- First-order reduction: under the hypotheses of `pderiv_aeval_mem_pow`,
`∑ j, π₂(x j) ⊗ₜ πₙ₊₁(Pⱼ(x)) = 0`. -/
private lemma pderiv_firstOrder_sum_eq_zero {r : ℕ} (n : ℕ) (x : Fin r → A)
    (hxI : ∀ i, x i ∈ augmentationIdeal k A) {P : MvPolynomial (Fin r) k}
    (hP : P.IsHomogeneous (n + 1)) (hmem : aeval x P ∈ (augmentationIdeal k A) ^ (n + 1 + 1)) :
    let I := augmentationIdeal k A
    ∑ j, (Ideal.Quotient.mkₐ k (I ^ 2) (x j)) ⊗ₜ[k]
      (Ideal.Quotient.mkₐ k (I ^ (n + 1)) (aeval x (pderiv j P))) = 0 := by
  classical
  intro I
  set π2 : A →ₐ[k] A ⧸ I ^ 2 := Ideal.Quotient.mkₐ k (I ^ 2)
  set πN : A →ₐ[k] A ⧸ I ^ (n + 1) := Ideal.Quotient.mkₐ k (I ^ (n + 1))
  set inl : (A ⧸ I ^ 2) →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
    Algebra.TensorProduct.includeLeft
  set inr : (A ⧸ I ^ (n + 1)) →ₐ[k] (A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1)) :=
    Algebra.TensorProduct.includeRight
  set δ := (Algebra.TensorProduct.map π2 πN).comp (Bialgebra.comulAlgHom k A)
  set Ja := Ideal.map inl (Ideal.map π2 I)
  have hJasq : Ja ^ 2 = ⊥ := by
    rw [show Ja = Ideal.map inl (Ideal.map π2 I) from rfl, ← Ideal.map_pow, ← Ideal.map_pow,
      ideal_map_mkₐ_self (I ^ 2), Ideal.map_bot]
  set u : Fin r → ((A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1))) := fun j => inr (πN (x j))
  set w : Fin r → ((A ⧸ I ^ 2) ⊗[k] (A ⧸ I ^ (n + 1))) := fun j => δ (x j) - u j
  have hsq : (Ideal.span (Set.range w)) ^ 2 = ⊥ := by
    refine le_antisymm (le_trans (Ideal.pow_right_mono (Ideal.span_le.2 ?_) 2)
      (le_of_eq hJasq)) bot_le
    rintro _ ⟨j, rfl⟩
    have h1 := comul_sub_prim_mem_mul (k := k) n (hxI j)
    rw [show w j = inl (π2 (x j)) + (δ (x j) - (inl (π2 (x j)) + inr (πN (x j)))) by
      simp [w, u]; ring]
    exact Ideal.add_mem _ (Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (hxI j)))
      (Ideal.mul_le_left h1)
  have htaylor := aeval_add_sub_mem_sq u w P
  rw [hsq] at htaylor
  have haeval_u : ∀ Q : MvPolynomial (Fin r) k, aeval u Q = (inr.comp πN) (aeval x Q) := fun Q =>
    (MvPolynomial.comp_aeval_apply x (inr.comp πN) Q).symm
  have hPu : aeval u P = 0 := by
    rw [haeval_u, AlgHom.comp_apply, show πN (aeval x P) = 0 from by
      exact Ideal.Quotient.eq_zero_iff_mem.2 ((Ideal.pow_le_pow_right (by omega)) hmem), map_zero]
  have hsum0 : ∑ j, w j * aeval u (pderiv j P) = 0 := by
    have h := Ideal.mem_bot.1 htaylor
    have haeval_uw : aeval (u + w) P = δ (aeval x P) := by
      rw [show u + w = fun j => δ (x j) by funext j; simp [w]]
      exact (MvPolynomial.comp_aeval_apply x δ P).symm
    rw [haeval_uw, map_comul_pow_eq_zero (k := k) n hmem, hPu] at h
    simpa using h.symm
  rw [← hsum0]
  refine Finset.sum_congr rfl fun j _ => ?_
  have h1 : w j * aeval u (pderiv j P) =
      inl (π2 (x j)) * aeval u (pderiv j P) + (w j - inl (π2 (x j))) * aeval u (pderiv j P) := by
    ring
  rw [h1, secondOrder_pderiv_eq_zero (k := k) n x hxI hP j, add_zero, haeval_u]
  simp [inl, inr, Algebra.TensorProduct.includeLeft_apply,
    Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul,
    AlgHom.comp_apply]

/-- **The key step.**  If a homogeneous polynomial of degree `N` in elements `xᵢ` of the
augmentation ideal with linearly independent classes in `A ⧸ I²` evaluates into `I ^ (N+1)`,
then each of its partial derivatives evaluates into `I ^ N`. -/
theorem pderiv_aeval_mem_pow
    {r : ℕ} (x : Fin r → A) (hxI : ∀ i, x i ∈ augmentationIdeal k A)
    (hindep : LinearIndependent k fun i => Ideal.Quotient.mk ((augmentationIdeal k A) ^ 2) (x i))
    {N : ℕ} {P : MvPolynomial (Fin r) k} (hP : P.IsHomogeneous N)
    (hmem : aeval x P ∈ (augmentationIdeal k A) ^ (N + 1)) (i : Fin r) :
    aeval x (pderiv i P) ∈ (augmentationIdeal k A) ^ N := by
  classical
  set I := augmentationIdeal k A
  rcases Nat.eq_zero_or_pos N with hN | hN
  · subst hN; simp
  obtain ⟨n, rfl⟩ : ∃ n, N = n + 1 := ⟨N - 1, by omega⟩
  have hfinal := pderiv_firstOrder_sum_eq_zero (k := k) n x hxI hP hmem
  have hzero := eq_zero_of_sum_tmul_eq_zero (k := k)
    (fun j => Ideal.Quotient.mk (I ^ 2) (x j)) hindep
    (fun j => Ideal.Quotient.mkₐ k (I ^ (n + 1)) (aeval x (pderiv j P)))
    (by simpa [Ideal.Quotient.mkₐ_eq_mk] using hfinal) i
  exact (Ideal.Quotient.eq_zero_iff_mem).1 (by simpa [Ideal.Quotient.mkₐ_eq_mk] using hzero)

/-- **The polynomial independence theorem.**  Over a field of characteristic zero, elements of
the augmentation ideal whose classes modulo `I²` are linearly independent satisfy no nontrivial
homogeneous polynomial relation of degree `n` modulo `I ^ (n+1)`.

Equivalently: the associated graded algebra of a commutative bialgebra for the augmentation
filtration is a polynomial algebra on `I/I²`. -/
theorem eq_zero_of_isHomogeneous [CharZero k]
    {r : ℕ} (x : Fin r → A) (hxI : ∀ i, x i ∈ augmentationIdeal k A)
    (hindep : LinearIndependent k fun i => Ideal.Quotient.mk ((augmentationIdeal k A) ^ 2) (x i))
    {N : ℕ} {P : MvPolynomial (Fin r) k} (hP : P.IsHomogeneous N)
    (hmem : aeval x P ∈ (augmentationIdeal k A) ^ (N + 1)) : P = 0 := by
  induction N generalizing P with
  | zero =>
      have hC : P = C (P.coeff 0) := by
        rw [← totalDegree_zero_iff_isHomogeneous] at hP
        exact (totalDegree_eq_zero_iff_eq_C).1 hP
      rw [hC] at hmem ⊢
      have h1 : (algebraMap k A) (P.coeff 0) ∈ augmentationIdeal k A := by
        simpa using hmem
      have h2 : P.coeff 0 = 0 := by
        have := (mem_augmentationIdeal (k := k) (A := A)).1 h1
        simpa using this
      rw [h2, map_zero]
  | succ n ih =>
      have hpd : ∀ i, pderiv i P = 0 := by
        intro i
        refine ih (P := pderiv i P) (by simpa using hP.pderiv (i := i)) ?_
        exact pderiv_aeval_mem_pow x hxI hindep hP hmem i
      have heuler := hP.sum_X_mul_pderiv
      rw [Finset.sum_congr rfl (fun i _ => by rw [hpd i, mul_zero])] at heuler
      simp only [Finset.sum_const_zero] at heuler
      have hcast : ((n + 1 : ℕ) : k) • P = 0 := by
        rw [Nat.cast_smul_eq_nsmul k (n + 1) P]
        exact heuler.symm
      rcases smul_eq_zero.1 hcast with h | h
      · exact absurd h (Nat.cast_ne_zero.2 (by omega))
      · exact h

end Step

end HopfAlgebra.CharZero
