module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import Mathlib.RingTheory.Coalgebra.Convolution
public import Mathlib.RingTheory.TensorProduct.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Bialgebra.Basic
public import Mathlib.RingTheory.HopfAlgebra.Basic

/-!
# The commutative Hopf algebra of convolution units of a coalgebra

For a coalgebra `C` over a commutative ring `k`, `UnitsHopf k C` is the commutative `k`-algebra
generated by two copies `g(c)`, `h(c)` of `C`, subject to the relations `g * h = 1` and `h * g = 1`
in the convolution ring `Conv(C, -)`. It represents the functor sending a commutative `k`-algebra
`R` to the group of units of the convolution ring `Conv(C, R) = Hom_k(C, R)`: algebra maps
`UnitsHopf k C →ₐ[k] R` are the pairs `(u, v)` of mutually inverse elements of `Conv(C, R)`
(`UnitsHopf.lift`, `UnitsHopf.algHom_ext`).

## Main definitions

* `UnitsHopf k C`: the algebra.
* `UnitsHopf.gen`, `UnitsHopf.genInv`: the generic unit `g` of `Conv(C, UnitsHopf k C)` and its
  inverse `h`.
* `UnitsHopf.lift`: the algebra map classifying a pair of mutually inverse elements.

## References

* M. E. Sweedler, *Hopf Algebras* (1969)
-/

@[expose] public section

noncomputable section

universe u v

open TensorProduct WithConv Coalgebra
open scoped RingTheory.LinearMap

namespace Coalgebra

namespace UnitsHopf

variable (k : Type u) [CommRing k] (C : Type v) [AddCommGroup C] [Module k C] [Coalgebra k C]

/-- The generic element `g` of `Conv(C, Sym(C × C))`: `c ↦ ι (c, 0)`. -/
abbrev symGen : WithConv (C →ₗ[k] SymmetricAlgebra k (C × C)) :=
  toConv (SymmetricAlgebra.ι k (C × C) ∘ₗ LinearMap.inl k C C)

/-- The second generic element `h` of `Conv(C, Sym(C × C))`: `c ↦ ι (0, c)`. -/
abbrev symGenInv : WithConv (C →ₗ[k] SymmetricAlgebra k (C × C)) :=
  toConv (SymmetricAlgebra.ι k (C × C) ∘ₗ LinearMap.inr k C C)

/-- The relations: `g * h = 1` and `h * g = 1`, evaluated at every `c : C`. -/
def relations : Set (SymmetricAlgebra k (C × C)) :=
  Set.range (fun c => (symGen k C * symGenInv k C - 1).ofConv c) ∪
    Set.range (fun c => (symGenInv k C * symGen k C - 1).ofConv c)

/-- The ideal of relations. -/
def ideal : Ideal (SymmetricAlgebra k (C × C)) := Ideal.span (relations k C)

end UnitsHopf

/-- **The commutative Hopf algebra of convolution units of `C`**: `Sym(C × C)` modulo the relations
`g * h = 1 = h * g`. -/
def UnitsHopf (k : Type u) [CommRing k] (C : Type v) [AddCommGroup C] [Module k C]
    [Coalgebra k C] : Type (max u v) :=
  SymmetricAlgebra k (C × C) ⧸ UnitsHopf.ideal k C

namespace UnitsHopf

variable (k : Type u) [CommRing k] (C : Type v) [AddCommGroup C] [Module k C] [Coalgebra k C]

instance : CommRing (UnitsHopf k C) := Ideal.Quotient.commRing _

instance : Algebra k (UnitsHopf k C) := Ideal.Quotient.algebra _

/-- The quotient map. -/
def mk : SymmetricAlgebra k (C × C) →ₐ[k] UnitsHopf k C := Ideal.Quotient.mkₐ k (ideal k C)

/-- The generic unit `g` of `Conv(C, UnitsHopf k C)`. -/
def gen : WithConv (C →ₗ[k] UnitsHopf k C) := (mk k C).convPostcomp (symGen k C)

/-- The inverse `h` of the generic unit. -/
def genInv : WithConv (C →ₗ[k] UnitsHopf k C) := (mk k C).convPostcomp (symGenInv k C)

/-- The quotient map `mk` sends every defining relation to zero. -/
lemma mk_relation {x : SymmetricAlgebra k (C × C)} (hx : x ∈ relations k C) : mk k C x = 0 :=
  (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span hx)

/-- The generic unit times its inverse is one: `g * h = 1` in `Conv(C, UnitsHopf k C)`. -/
lemma gen_mul_genInv : gen k C * genInv k C = 1 := by
  rw [gen, genInv, ← map_mul, ← sub_eq_zero, ← map_one ((mk k C).convPostcomp (C := C)),
    ← map_sub]
  ext c
  exact mk_relation k C (Or.inl ⟨c, rfl⟩)

/-- The inverse of the generic unit times the generic unit is one: `h * g = 1` in
`Conv(C, UnitsHopf k C)`. -/
lemma genInv_mul_gen : genInv k C * gen k C = 1 := by
  rw [gen, genInv, ← map_mul, ← sub_eq_zero, ← map_one ((mk k C).convPostcomp (C := C)),
    ← map_sub]
  ext c
  exact mk_relation k C (Or.inr ⟨c, rfl⟩)

variable {k C} {R : Type*} [CommRing R] [Algebra k R]

/-- The algebra map `Sym(C × C) → R` sending `g` to `u` and `h` to `v`. -/
def symLift (u v : WithConv (C →ₗ[k] R)) : SymmetricAlgebra k (C × C) →ₐ[k] R :=
  SymmetricAlgebra.lift (u.ofConv.coprod v.ofConv)

/-- Postcomposing the first generic element `g` with `symLift u v` gives `u`. -/
lemma symLift_symGen (u v : WithConv (C →ₗ[k] R)) :
    (symLift u v).convPostcomp (symGen k C) = u := by
  ext c
  simp [symLift, AlgHom.convPostcomp]

/-- Postcomposing the second generic element `h` with `symLift u v` gives `v`. -/
lemma symLift_symGenInv (u v : WithConv (C →ₗ[k] R)) :
    (symLift u v).convPostcomp (symGenInv k C) = v := by
  ext c
  simp [symLift, AlgHom.convPostcomp]

/-- **The universal property**: the algebra map `UnitsHopf k C → R` classifying a pair `(u, v)` of
mutually inverse elements of `Conv(C, R)`. -/
def lift (u v : WithConv (C →ₗ[k] R)) (huv : u * v = 1) (hvu : v * u = 1) :
    UnitsHopf k C →ₐ[k] R :=
  Ideal.Quotient.liftₐ (ideal k C) (symLift u v) fun x hx => by
    refine (Ideal.span_le (I := RingHom.ker (symLift u v).toRingHom)).mpr ?_ hx
    rintro _ (⟨c, rfl⟩ | ⟨c, rfl⟩)
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      have := congr(($(map_sub ((symLift u v).convPostcomp (C := C))
        (symGen k C * symGenInv k C) 1)).ofConv c)
      simp only [map_mul, map_one, symLift_symGen, symLift_symGenInv, huv, sub_self] at this
      exact this
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      have := congr(($(map_sub ((symLift u v).convPostcomp (C := C))
        (symGenInv k C * symGen k C) 1)).ofConv c)
      simp only [map_mul, map_one, symLift_symGen, symLift_symGenInv, hvu, sub_self] at this
      exact this

/-- The lift `lift u v` composed with the quotient map `mk` is `symLift u v`. -/
lemma lift_comp_mk (u v : WithConv (C →ₗ[k] R)) (huv : u * v = 1) (hvu : v * u = 1) :
    (lift u v huv hvu).comp (mk k C) = symLift u v :=
  AlgHom.ext fun _ => rfl

/-- The lift `lift u v` sends the generic unit `g` to `u`. -/
@[simp] lemma lift_gen (u v : WithConv (C →ₗ[k] R)) (huv : u * v = 1) (hvu : v * u = 1) :
    (lift u v huv hvu).convPostcomp (gen k C) = u := by
  rw [gen, ← AlgHom.comp_apply, ← AlgHom.convPostcomp_comp, lift_comp_mk]
  exact symLift_symGen u v

/-- The lift `lift u v` sends the inverse `h` of the generic unit to `v`. -/
@[simp] lemma lift_genInv (u v : WithConv (C →ₗ[k] R)) (huv : u * v = 1) (hvu : v * u = 1) :
    (lift u v huv hvu).convPostcomp (genInv k C) = v := by
  rw [genInv, ← AlgHom.comp_apply, ← AlgHom.convPostcomp_comp, lift_comp_mk]
  exact symLift_symGenInv u v

/-- Two algebra maps out of `UnitsHopf k C` agreeing on `g` and `h` are equal. -/
lemma algHom_ext {φ ψ : UnitsHopf k C →ₐ[k] R}
    (hg : φ.convPostcomp (gen k C) = ψ.convPostcomp (gen k C))
    (hh : φ.convPostcomp (genInv k C) = ψ.convPostcomp (genInv k C)) : φ = ψ := by
  refine Ideal.Quotient.algHom_ext k (SymmetricAlgebra.algHom_ext ?_)
  refine LinearMap.prod_ext ?_ ?_
  · ext c
    exact congr(($hg).ofConv c)
  · ext c
    exact congr(($hh).ofConv c)


/-! ### The bialgebra and Hopf algebra structures -/

section Hopf

variable (k C)

/-- Postcomposition in the convolution ring is functorial: postcomposing with `φ.comp ψ` is
postcomposing with `ψ` and then with `φ`. -/
lemma convPostcomp_comp_apply {A B D : Type*} [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    [CommRing D] [Algebra k D] (φ : B →ₐ[k] D) (ψ : A →ₐ[k] B) (x : WithConv (C →ₗ[k] A)) :
    (φ.comp ψ).convPostcomp x = φ.convPostcomp (ψ.convPostcomp x) := by
  rw [AlgHom.convPostcomp_comp]
  rfl

/-- The left inclusion into `UnitsHopf k C ⊗ UnitsHopf k C`. -/
abbrev inl : UnitsHopf k C →ₐ[k] UnitsHopf k C ⊗[k] UnitsHopf k C :=
  Algebra.TensorProduct.includeLeft

/-- The right inclusion into `UnitsHopf k C ⊗ UnitsHopf k C`. -/
abbrev inr : UnitsHopf k C →ₐ[k] UnitsHopf k C ⊗[k] UnitsHopf k C :=
  Algebra.TensorProduct.includeRight

/-- The comultiplication: `g ↦ g' * g''` and `h ↦ h'' * h'`, where `'` and `''` are the two
inclusions into `UnitsHopf k C ⊗ UnitsHopf k C`. -/
def comulAlg : UnitsHopf k C →ₐ[k] UnitsHopf k C ⊗[k] UnitsHopf k C :=
  lift (R := UnitsHopf k C ⊗[k] UnitsHopf k C)
    ((inl k C).convPostcomp (gen k C) * (inr k C).convPostcomp (gen k C))
    ((inr k C).convPostcomp (genInv k C) * (inl k C).convPostcomp (genInv k C))
    (by
      rw [mul_assoc, ← mul_assoc ((inr k C).convPostcomp (gen k C)), ← map_mul,
        gen_mul_genInv, map_one,
        one_mul, ← map_mul, gen_mul_genInv, map_one])
    (by
      rw [mul_assoc, ← mul_assoc ((inl k C).convPostcomp (genInv k C)), ← map_mul, genInv_mul_gen,
        map_one, one_mul, ← map_mul, genInv_mul_gen, map_one])

/-- The counit: `g, h ↦ 1`. -/
def counitAlg : UnitsHopf k C →ₐ[k] k := lift 1 1 (mul_one 1) (mul_one 1)

/-- The comultiplication sends the generic unit `g` to `g' * g''`. -/
@[simp] lemma comulAlg_gen : (comulAlg k C).convPostcomp (gen k C) =
    (inl k C).convPostcomp (gen k C) * (inr k C).convPostcomp (gen k C) := lift_gen _ _ _ _

/-- The comultiplication sends the inverse `h` to `h'' * h'`. -/
@[simp] lemma comulAlg_genInv : (comulAlg k C).convPostcomp (genInv k C) =
    (inr k C).convPostcomp (genInv k C) * (inl k C).convPostcomp (genInv k C) := lift_genInv _ _ _ _

/-- The counit sends the generic unit `g` to `1`. -/
@[simp] lemma counitAlg_gen : (counitAlg k C).convPostcomp (gen k C) = 1 := lift_gen _ _ _ _

/-- The counit sends the inverse `h` to `1`. -/
@[simp] lemma counitAlg_genInv : (counitAlg k C).convPostcomp (genInv k C) = 1 :=
  lift_genInv _ _ _ _


section TensorLemmas

variable {A B A' B' : Type*} [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
  [CommRing A'] [Algebra k A'] [CommRing B'] [Algebra k B']

open Algebra.TensorProduct in
/-- Postcomposing with `map f g` after the left inclusion equals postcomposing with `f` and then
with the left inclusion. -/
lemma map_convPostcomp_includeLeft (f : A →ₐ[k] A') (g : B →ₐ[k] B') (x : WithConv (C →ₗ[k] A)) :
    (map f g).convPostcomp ((includeLeft (S := k) (B := B)).convPostcomp x) =
      (includeLeft (S := k) (B := B')).convPostcomp (f.convPostcomp x) := by
  rw [← convPostcomp_comp_apply, ← convPostcomp_comp_apply, map_comp_includeLeft]

open Algebra.TensorProduct in
/-- Postcomposing with `map f g` after the right inclusion equals postcomposing with `g` and then
with the right inclusion. -/
lemma map_convPostcomp_includeRight (f : A →ₐ[k] A') (g : B →ₐ[k] B') (x : WithConv (C →ₗ[k] B)) :
    (map f g).convPostcomp ((includeRight (A := A)).convPostcomp x) =
      (includeRight (A := A')).convPostcomp (g.convPostcomp x) := by
  rw [← convPostcomp_comp_apply, ← convPostcomp_comp_apply, map_comp_includeRight]

variable {D : Type*} [CommRing D] [Algebra k D]

open Algebra.TensorProduct in
/-- The associator `(A ⊗ B) ⊗ D ≅ A ⊗ (B ⊗ D)` carries the composite of the two left inclusions of
`A` to the left inclusion of `A`, after postcomposition. -/
lemma assoc_convPostcomp_inl_inl (x : WithConv (C →ₗ[k] A)) :
    (Algebra.TensorProduct.assoc k k k A B D).toAlgHom.convPostcomp
      ((includeLeft (S := k) (B := D)).convPostcomp
      ((includeLeft (S := k) (B := B)).convPostcomp x)) =
      (includeLeft (S := k) (B := B ⊗[k] D)).convPostcomp x := by
  rw [← convPostcomp_comp_apply, ← convPostcomp_comp_apply]
  congr 1

open Algebra.TensorProduct in
/-- The associator `(A ⊗ B) ⊗ D ≅ A ⊗ (B ⊗ D)` carries the inclusion of the middle factor `B` on the
left side to the corresponding inclusion on the right side, after postcomposition. -/
lemma assoc_convPostcomp_inl_inr (x : WithConv (C →ₗ[k] B)) :
    (Algebra.TensorProduct.assoc k k k A B D).toAlgHom.convPostcomp
      ((includeLeft (S := k) (B := D)).convPostcomp
      ((includeRight (A := A)).convPostcomp x)) =
      (includeRight (A := A)).convPostcomp ((includeLeft (S := k) (B := D)).convPostcomp x) := by
  rw [← convPostcomp_comp_apply, ← convPostcomp_comp_apply, ← convPostcomp_comp_apply]
  congr 1

open Algebra.TensorProduct in
/-- The associator `(A ⊗ B) ⊗ D ≅ A ⊗ (B ⊗ D)` carries the right inclusion of `D` to the composite
of the two right inclusions, after postcomposition. -/
lemma assoc_convPostcomp_inr (x : WithConv (C →ₗ[k] D)) :
    (Algebra.TensorProduct.assoc k k k A B D).toAlgHom.convPostcomp
      ((includeRight (A := A ⊗[k] B)).convPostcomp x) =
      (includeRight (A := A)).convPostcomp ((includeRight (A := B)).convPostcomp x) := by
  rw [← convPostcomp_comp_apply, ← convPostcomp_comp_apply]
  congr 1

end TensorLemmas

/-- The comultiplication `comulAlg` is coassociative, as a statement about algebra maps. -/
lemma comul_coassoc :
    (Algebra.TensorProduct.assoc k k k (UnitsHopf k C) (UnitsHopf k C)
      (UnitsHopf k C)).toAlgHom.comp
      ((Algebra.TensorProduct.map (comulAlg k C) (.id k (UnitsHopf k C))).comp (comulAlg k C)) =
    (Algebra.TensorProduct.map (.id k (UnitsHopf k C)) (comulAlg k C)).comp (comulAlg k C) := by
  refine algHom_ext (R := UnitsHopf k C ⊗[k] (UnitsHopf k C ⊗[k] UnitsHopf k C)) ?_ ?_
  · simp only [convPostcomp_comp_apply, comulAlg_gen, map_mul, map_convPostcomp_includeLeft,
      map_convPostcomp_includeRight, assoc_convPostcomp_inl_inl, assoc_convPostcomp_inl_inr,
      assoc_convPostcomp_inr, AlgHom.convPostcomp_id, AlgHom.id_apply, mul_assoc]
  · simp only [convPostcomp_comp_apply, comulAlg_genInv, map_mul, map_convPostcomp_includeLeft,
      map_convPostcomp_includeRight, assoc_convPostcomp_inl_inl, assoc_convPostcomp_inl_inr,
      assoc_convPostcomp_inr, AlgHom.convPostcomp_id, AlgHom.id_apply, mul_assoc]


/-- The inverse of the left unitor `k ⊗ UnitsHopf k C ≅ UnitsHopf k C` is the right inclusion. -/
lemma lid_symm_eq_includeRight :
    ((Algebra.TensorProduct.lid k (UnitsHopf k C)).symm : UnitsHopf k C →ₐ[k] k ⊗[k] _) =
      Algebra.TensorProduct.includeRight :=
  AlgHom.ext fun _ => rfl

/-- The inverse of the right unitor `UnitsHopf k C ⊗ k ≅ UnitsHopf k C` is the left inclusion. -/
lemma rid_symm_eq_includeLeft :
    ((Algebra.TensorProduct.rid k k (UnitsHopf k C)).symm : UnitsHopf k C →ₐ[k] _ ⊗[k] k) =
      Algebra.TensorProduct.includeLeft :=
  AlgHom.ext fun _ => rfl

/-- Left counit law: applying `counitAlg` to the left factor of `comulAlg` gives the inverse of the
left unitor. -/
lemma comul_rTensor :
    (Algebra.TensorProduct.map (counitAlg k C) (.id k (UnitsHopf k C))).comp (comulAlg k C) =
      (Algebra.TensorProduct.lid k (UnitsHopf k C)).symm := by
  rw [lid_symm_eq_includeRight]
  refine algHom_ext (R := k ⊗[k] UnitsHopf k C) ?_ ?_
  · simp only [convPostcomp_comp_apply, comulAlg_gen, map_mul, map_convPostcomp_includeLeft,
      map_convPostcomp_includeRight, counitAlg_gen, map_one, one_mul, AlgHom.convPostcomp_id,
      AlgHom.id_apply]
  · simp only [convPostcomp_comp_apply, comulAlg_genInv, map_mul, map_convPostcomp_includeLeft,
      map_convPostcomp_includeRight, counitAlg_genInv, map_one, mul_one, AlgHom.convPostcomp_id,
      AlgHom.id_apply]

/-- Right counit law: applying `counitAlg` to the right factor of `comulAlg` gives the inverse of
the right unitor. -/
lemma comul_lTensor :
    (Algebra.TensorProduct.map (.id k (UnitsHopf k C)) (counitAlg k C)).comp (comulAlg k C) =
      (Algebra.TensorProduct.rid k k (UnitsHopf k C)).symm := by
  rw [rid_symm_eq_includeLeft]
  refine algHom_ext (R := UnitsHopf k C ⊗[k] k) ?_ ?_
  · simp only [convPostcomp_comp_apply, comulAlg_gen, map_mul, map_convPostcomp_includeLeft,
      map_convPostcomp_includeRight, counitAlg_gen, map_one, mul_one, AlgHom.convPostcomp_id,
      AlgHom.id_apply]
  · simp only [convPostcomp_comp_apply, comulAlg_genInv, map_mul, map_convPostcomp_includeLeft,
      map_convPostcomp_includeRight, counitAlg_genInv, map_one, one_mul, AlgHom.convPostcomp_id,
      AlgHom.id_apply]

instance : Bialgebra k (UnitsHopf k C) :=
  Bialgebra.ofAlgHom (comulAlg k C) (counitAlg k C) (comul_coassoc k C) (comul_rTensor k C)
    (comul_lTensor k C)

/-- The comultiplication of the bialgebra structure on `UnitsHopf k C` is `comulAlg`. -/
lemma comulAlgHom_eq : Bialgebra.comulAlgHom k (UnitsHopf k C) = comulAlg k C :=
  AlgHom.ext fun _ => rfl

/-- The counit of the bialgebra structure on `UnitsHopf k C` is `counitAlg`. -/
lemma counitAlgHom_eq : Bialgebra.counitAlgHom k (UnitsHopf k C) = counitAlg k C :=
  AlgHom.ext fun _ => rfl

/-- The antipode: `g ↦ h` and `h ↦ g`. -/
def antipodeAlg : UnitsHopf k C →ₐ[k] UnitsHopf k C :=
  lift (genInv k C) (gen k C) (genInv_mul_gen k C) (gen_mul_genInv k C)

/-- The antipode sends the generic unit `g` to its inverse `h`. -/
@[simp] lemma antipodeAlg_gen : (antipodeAlg k C).convPostcomp (gen k C) = genInv k C :=
  lift_gen _ _ _ _

/-- The antipode sends the inverse `h` to the generic unit `g`. -/
@[simp] lemma antipodeAlg_genInv : (antipodeAlg k C).convPostcomp (genInv k C) = gen k C :=
  lift_genInv _ _ _ _


/-- The algebra map `x ⊗ y ↦ S(x) * y` restricted along the left inclusion is the antipode `S`. -/
lemma lift_antipode_id_comp_inl :
    (Algebra.TensorProduct.lift (antipodeAlg k C) (.id k (UnitsHopf k C))
      fun _ ↦ Commute.all _).comp (inl k C) = antipodeAlg k C :=
  AlgHom.ext fun x => (Algebra.TensorProduct.lift_tmul _ _ (fun _ ↦ Commute.all _) x 1).trans
    (by rw [map_one, mul_one])

/-- The algebra map `x ⊗ y ↦ S(x) * y` restricted along the right inclusion is the identity. -/
lemma lift_antipode_id_comp_inr :
    (Algebra.TensorProduct.lift (antipodeAlg k C) (.id k (UnitsHopf k C))
      fun _ ↦ Commute.all _).comp (inr k C) = .id k (UnitsHopf k C) :=
  AlgHom.ext fun x => (Algebra.TensorProduct.lift_tmul _ _ (fun _ ↦ Commute.all _) 1 x).trans
    (by rw [map_one, one_mul])

/-- The algebra map `x ⊗ y ↦ x * S(y)` restricted along the left inclusion is the identity. -/
lemma lift_id_antipode_comp_inl :
    (Algebra.TensorProduct.lift (.id k (UnitsHopf k C)) (antipodeAlg k C)
      fun _ _ ↦ Commute.all _ _).comp (inl k C) = .id k (UnitsHopf k C) :=
  AlgHom.ext fun _ => by simp

/-- The algebra map `x ⊗ y ↦ x * S(y)` restricted along the right inclusion is the antipode `S`. -/
lemma lift_id_antipode_comp_inr :
    (Algebra.TensorProduct.lift (.id k (UnitsHopf k C)) (antipodeAlg k C)
      fun _ _ ↦ Commute.all _ _).comp (inr k C) = antipodeAlg k C :=
  AlgHom.ext fun _ => by simp

instance : HopfAlgebra k (UnitsHopf k C) :=
  HopfAlgebra.ofAlgHom (antipodeAlg k C)
    (by
      rw [comulAlgHom_eq, counitAlgHom_eq]
      refine algHom_ext (R := UnitsHopf k C) ?_ ?_
      · rw [convPostcomp_comp_apply, comulAlg_gen, map_mul, ← convPostcomp_comp_apply,
          ← convPostcomp_comp_apply, lift_antipode_id_comp_inl, lift_antipode_id_comp_inr,
          convPostcomp_comp_apply, counitAlg_gen, map_one, antipodeAlg_gen,
          AlgHom.convPostcomp_id, AlgHom.id_apply, genInv_mul_gen]
      · rw [convPostcomp_comp_apply, comulAlg_genInv, map_mul, ← convPostcomp_comp_apply,
          ← convPostcomp_comp_apply, lift_antipode_id_comp_inl, lift_antipode_id_comp_inr,
          convPostcomp_comp_apply, counitAlg_genInv, map_one, antipodeAlg_genInv,
          AlgHom.convPostcomp_id, AlgHom.id_apply, genInv_mul_gen])
    (by
      rw [comulAlgHom_eq, counitAlgHom_eq]
      refine algHom_ext (R := UnitsHopf k C) ?_ ?_
      · rw [convPostcomp_comp_apply, comulAlg_gen, map_mul, ← convPostcomp_comp_apply,
          ← convPostcomp_comp_apply, lift_id_antipode_comp_inl, lift_id_antipode_comp_inr,
          convPostcomp_comp_apply, counitAlg_gen, map_one, antipodeAlg_gen,
          AlgHom.convPostcomp_id, AlgHom.id_apply, gen_mul_genInv]
      · rw [convPostcomp_comp_apply, comulAlg_genInv, map_mul, ← convPostcomp_comp_apply,
          ← convPostcomp_comp_apply, lift_id_antipode_comp_inl, lift_id_antipode_comp_inr,
          convPostcomp_comp_apply, counitAlg_genInv, map_one, antipodeAlg_genInv,
          AlgHom.convPostcomp_id, AlgHom.id_apply, gen_mul_genInv])

end Hopf

end UnitsHopf

/-! ### The embedding `C → UnitsHopf k C` -/

namespace UnitsHopf

section Embed

variable (k : Type u) [CommRing k] (C : Type v) [AddCommGroup C] [Module k C] [Coalgebra k C]

/-- The canonical map `C → UnitsHopf k C`, `c ↦ g(c)`. -/
def toUnitsHopf : C →ₗ[k] UnitsHopf k C := (gen k C).ofConv

/-- **The map `c ↦ g(c)` is injective.** It has a left inverse through the square-zero extension
`k ⊕ C`: the convolution unit `1 + f`, where `f(c) = (0, c)` squares to zero, has inverse `1 - f`,
and the classifying map sends `g(c)` to `(ε(c), c)`. -/
theorem toUnitsHopf_injective : Function.Injective (toUnitsHopf k C) := by
  let _ : Module kᵐᵒᵖ C := Module.compHom C ((RingEquiv.toOpposite k).symm : kᵐᵒᵖ →+* k)
  have : IsCentralScalar k C := ⟨fun _ _ => rfl⟩
  let f : WithConv (C →ₗ[k] TrivSqZeroExt k C) := toConv (TrivSqZeroExt.inrHom k C)
  have hf : f * f = 0 := by
    have h0 : LinearMap.mul' k (TrivSqZeroExt k C) ∘ₗ
        (TrivSqZeroExt.inrHom k C ⊗ₘ TrivSqZeroExt.inrHom k C) = 0 :=
      TensorProduct.ext' fun a b => by simp
    rw [LinearMap.convMul_def, ← LinearMap.comp_assoc]
    simp only [f, h0, LinearMap.zero_comp]
    rfl
  have h1 : (1 + f) * (1 - f) = 1 := by rw [add_mul, one_mul, mul_sub, mul_one, hf]; abel
  have h2 : (1 - f) * (1 + f) = 1 := by rw [sub_mul, one_mul, mul_add, mul_one, hf]; abel
  let φ := lift (R := TrivSqZeroExt k C) (1 + f) (1 - f) h1 h2
  have key : ∀ c, (φ (toUnitsHopf k C c)).snd = c := fun c => by
    have : φ (toUnitsHopf k C c) = _ := congr(($(lift_gen (1 + f) (1 - f) h1 h2)).ofConv c)
    rw [this]
    simp [f, LinearMap.convOne_apply, TrivSqZeroExt.algebraMap_eq_inl]
  exact Function.LeftInverse.injective (g := fun x => (φ x).snd) key

/-- In `Conv(C, A ⊗ A)`, the product of `a` included on the left and `b` included on the right is
`(a ⊗ b) ∘ Δ`. -/
lemma inl_mul_inr_eq {A : Type*} [CommRing A] [Algebra k A] (a b : C →ₗ[k] A) :
    (Algebra.TensorProduct.includeLeft (S := k) (B := A)).convPostcomp (toConv a) *
      (Algebra.TensorProduct.includeRight (A := A)).convPostcomp (toConv b) =
      toConv ((a ⊗ₘ b) ∘ₗ comul) := by
  rw [LinearMap.convMul_def]
  congr 1
  rw [← LinearMap.comp_assoc]
  congr 1
  exact TensorProduct.ext' fun x y => by simp

/-- **`C` is a subcoalgebra of the Hopf algebra `UnitsHopf k C`**: `c ↦ g(c)` as a coalgebra map. -/
def coalgHom : C →ₗc[k] UnitsHopf k C where
  toLinearMap := toUnitsHopf k C
  counit_comp := by
    ext c
    exact congr(($(counitAlg_gen k C)).ofConv c).trans (by simp [LinearMap.convOne_apply])
  map_comp_comul := by
    ext c
    have hg := congr(($(comulAlg_gen k C)).ofConv c)
    have h := congr(($(inl_mul_inr_eq k C (gen k C).ofConv (gen k C).ofConv)).ofConv c)
    exact (hg.trans h).symm

/-- The coalgebra map `coalgHom : C → UnitsHopf k C` is injective. -/
lemma coalgHom_injective : Function.Injective (coalgHom k C) := toUnitsHopf_injective k C

end Embed

section Cocomm

variable (k : Type u) [CommRing k] (C : Type v) [AddCommGroup C] [Module k C] [Coalgebra k C]

/-- The swap `A ⊗ A ≅ A ⊗ A` carries the left inclusion to the right inclusion, after
postcomposition. -/
lemma comm_convPostcomp_inl (x : WithConv (C →ₗ[k] UnitsHopf k C)) :
    (Algebra.TensorProduct.comm k (UnitsHopf k C) (UnitsHopf k C)).toAlgHom.convPostcomp
      ((inl k C).convPostcomp x) = (inr k C).convPostcomp x := by
  rw [← convPostcomp_comp_apply]
  congr 1

/-- The swap `A ⊗ A ≅ A ⊗ A` carries the right inclusion to the left inclusion, after
postcomposition. -/
lemma comm_convPostcomp_inr (x : WithConv (C →ₗ[k] UnitsHopf k C)) :
    (Algebra.TensorProduct.comm k (UnitsHopf k C) (UnitsHopf k C)).toAlgHom.convPostcomp
      ((inr k C).convPostcomp x) = (inl k C).convPostcomp x := by
  rw [← convPostcomp_comp_apply]
  congr 1

/-- **If `C` is cocommutative, so is `UnitsHopf k C`**: the convolution ring `Conv(C, -)` is then
commutative, so its group of units is commutative. -/
instance [IsCocomm k C] : IsCocomm k (UnitsHopf k C) where
  comm_comp_comul := by
    have h : (Algebra.TensorProduct.comm k (UnitsHopf k C) (UnitsHopf k C)).toAlgHom.comp
        (comulAlg k C) = comulAlg k C := by
      refine algHom_ext (R := UnitsHopf k C ⊗[k] UnitsHopf k C) ?_ ?_
      · rw [convPostcomp_comp_apply, comulAlg_gen, map_mul, comm_convPostcomp_inl,
          comm_convPostcomp_inr, mul_comm]
      · rw [convPostcomp_comp_apply, comulAlg_genInv, map_mul, comm_convPostcomp_inl,
          comm_convPostcomp_inr, mul_comm]
    exact congr(($h).toLinearMap)

end Cocomm

end UnitsHopf

end Coalgebra

/-- **Every coalgebra embeds into a Hopf algebra:**
for a coalgebra `C` over a commutative ring `k`, there are a commutative Hopf algebra `H` in the
universe of `C` and an injective coalgebra map `C → H`. The Hopf algebra is `UnitsHopf k C`, which
represents the units of the convolution ring `Conv(C, -)`. -/
theorem Coalgebra.exists_injective_coalgHom_hopfAlgebra (k : Type u) [CommRing k] (C : Type u)
    [AddCommGroup C] [Module k C] [Coalgebra k C] :
    ∃ (H : Type u) (_ : CommRing H) (_ : HopfAlgebra k H) (f : C →ₗc[k] H),
      Function.Injective f :=
  ⟨UnitsHopf k C, inferInstance, inferInstance, UnitsHopf.coalgHom k C,
    UnitsHopf.coalgHom_injective k C⟩

/-- **Every cocommutative coalgebra embeds into a cocommutative Hopf algebra**: the same,
with `H` cocommutative when `C` is. -/
theorem Coalgebra.exists_injective_coalgHom_cocomm_hopfAlgebra (k : Type u) [CommRing k]
    (C : Type u) [AddCommGroup C] [Module k C] [Coalgebra k C] [Coalgebra.IsCocomm k C] :
    ∃ (H : Type u) (_ : CommRing H) (_ : HopfAlgebra k H) (_ : Coalgebra.IsCocomm k H)
      (f : C →ₗc[k] H), Function.Injective f :=
  ⟨UnitsHopf k C, inferInstance, inferInstance, inferInstance, UnitsHopf.coalgHom k C,
    UnitsHopf.coalgHom_injective k C⟩
